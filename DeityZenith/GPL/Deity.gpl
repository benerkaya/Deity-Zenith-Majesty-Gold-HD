////////////////////////////////////////////////////////////////////////////////
// SpawnUnit with all Quest_Flag_* booleans of GplAIRoot saved and restored: some
// birth scripts write them (tomb_birth: Quest_Flag_2, Url_Shekk_Birth: Quest_Flag_4)
// for quest victory bookkeeping. An earlier version only restored Quest_Flag_4.
function FM_Spawn_Safe (agent palace, string unitType, coordinate spot, integer player, string mode) is agent
declare
	agent root, m;
	boolean q1, q2, q3, q4, q5, q6, q7, q8, q9, q10, q11, q12, q13, q14, q15, q16, q17, q18, q19, q20;
begin
	root = $FM_Root ();
	q1 = root's "Quest_Flag_1";
	q2 = root's "Quest_Flag_2";
	q3 = root's "Quest_Flag_3";
	q4 = root's "Quest_Flag_4";
	q5 = root's "Quest_Flag_5";
	q6 = root's "Quest_Flag_6";
	q7 = root's "Quest_Flag_7";
	q8 = root's "Quest_Flag_8";
	q9 = root's "Quest_Flag_9";
	q10 = root's "Quest_Flag_10";
	q11 = root's "Quest_Flag_11";
	q12 = root's "Quest_Flag_12";
	q13 = root's "Quest_Flag_13";
	q14 = root's "Quest_Flag_14";
	q15 = root's "Quest_Flag_15";
	q16 = root's "Quest_Flag_16";
	q17 = root's "Quest_Flag_17";
	q18 = root's "Quest_Flag_18";
	q19 = root's "Quest_Flag_19";
	q20 = root's "Quest_Flag_20";
	m = $SpawnUnit (palace, unitType, spot, player, mode);
	root's "Quest_Flag_1" = q1;
	root's "Quest_Flag_2" = q2;
	root's "Quest_Flag_3" = q3;
	root's "Quest_Flag_4" = q4;
	root's "Quest_Flag_5" = q5;
	root's "Quest_Flag_6" = q6;
	root's "Quest_Flag_7" = q7;
	root's "Quest_Flag_8" = q8;
	root's "Quest_Flag_9" = q9;
	root's "Quest_Flag_10" = q10;
	root's "Quest_Flag_11" = q11;
	root's "Quest_Flag_12" = q12;
	root's "Quest_Flag_13" = q13;
	root's "Quest_Flag_14" = q14;
	root's "Quest_Flag_15" = q15;
	root's "Quest_Flag_16" = q16;
	root's "Quest_Flag_17" = q17;
	root's "Quest_Flag_18" = q18;
	root's "Quest_Flag_19" = q19;
	root's "Quest_Flag_20" = q20;
	return m;
end

////////////////////////////////////////////////////////////////////////////////
// HOSTILE monsters: owned by the monster player, the game's own AI. Sleepers are
// woken up (same as the friendly path) and boss death scripts are replaced by the
// plain Monster_Gravestone (Vendral_Death would declare quest victory, etc.).
function FM_Hostile_Prep (agent m)
declare
begin
	if ($isdead (m))
		return;
	if (m's "title" == "Dragon" || m's "title" == "IceDragon" || m's "title" == "Ratman" || m's "title" == "Vendral")
		if ($IsRunning (m's "SleeperScript"))
			$KillThread (m's "SleeperScript");
	m's "IGDeathScript" = $Monster_Gravestone;
	// Guardian_Birth took the spawner (your Palace) as home: guard the flag spot instead
	if (m's "title" == "Strangleweed" || m's "title" == "Daemonwood" || m's "title" == "Dryad")
		m's "Coord_Home" = $LocationOf (m);
	// Skeleton_Birth: a skeleton spawned by a building (your Palace) gets Monster_follow with
	// Leader = that Palace (it follows it and attacks its target or the Palace itself): give a
	// Hostile summon the normal monster AI instead (data scripts: wandering)
	if (m's "title" == "Skeleton" && m's "BasicScript" == $Monster_follow)
		begin
			m's "ActiveScript" = $wandering;
			m's "BackScript" = $wandering;
			m's "BasicScript" = $wandering;
			m's "StartingScript" = $wandering;
			m's "Leader" = $NullAgent ();
			m's "target" = $NullAgent ();
		end
end

function FM_Flag_Hostile (agent palace, integer e, coordinate spot)
declare
	integer i, n, made, tries;
	string unitType;
	agent m;
	integer hp;
begin
	hp = $FM_Host_Player (palace);
	unitType = $ListMember ($FM_Type_List (), e);
	n = $FM_Count ();
	made = 0;
	i = 0;
	while (i < n) do
		begin
			m = $FM_Spawn_Safe (palace, unitType, $RandomCoord (spot, 120), hp, "override");
			tries = 0;
			while ($IsValidGamePiece (m) == FALSE && tries < 2) do
				begin
					m = $FM_Spawn_Safe (palace, unitType, $RandomCoord (spot, 100, 250), hp, "override");
					tries = tries + 1;
				end
			if ($IsValidGamePiece (m))
				begin
					$FM_Hostile_Prep (m);
					$FM_Fac_Team (palace, m);
					made = made + 1;
				end
			i = i + 1;
		end
	if (made == 0)
		begin
			$FM_Say (palace, "IDTXT_FMX_HFAIL");
			return;
		end
	$FM_Say_Owner (palace);
	if (made == 1)
		$FM_Say (palace, $ListMember ($FM_Host_Keys (), e));
	else
		$FM_Say (palace, $ListMember ($FM_HMany_Keys (), e));
	if (made < n)
		$FM_Say (palace, "IDTXT_FMX_HPARTIAL");
end

////////////////////////////////////////////////////////////////////////////////
// GUARDS (always yours). Spawner = palace, so Palace_Guard_Birth makes the Palace
// its home ($Parent) and registers it there (Guards list + Num_Guards), exactly
// like a palace-spawned guard. City_Guard_Birth takes the first guardhouse in the
// palace's "Waiting_Guardhouses" list as home (that guardhouse simply gets its
// guard). With NO waiting guardhouse the guard has no home and the original AI
// (Guard_Voyage_Home -> Guard_Goto_Palace) walks it to the palace and DELETES it,
// so here it gets a home: the guardhouse of yours nearest to the flag, else the
// palace, registered the same way the birth scripts do (Guard_Death undoes it).
function FM_Spawn_Guard (agent palace, string gt, coordinate spot, agent h) is agent
declare
	agent g, p, sp;
	list pals;
begin
	// City_Guard_Birth reads its home from the Waiting_Guardhouses of $GetTruePalace (first own
	// building titled "Palace"): offer the home on every one of them, take back what is left after the
	// (synchronous) birth. Palace_Guard_Birth uses $Parent: spawned from its home.
	if (gt != "Palace_Guard")
		begin
			$ListObjects (palace, "building", -1, pals, #CheckTitles, "Palace", #MyPlayer);
			pals << palace;
			foreach p in pals do
				p's "Waiting_Guardhouses" << h;
		end
	sp = palace;
	if (gt == "Palace_Guard")
		sp = h;
	g = $FM_Spawn_Safe (sp, gt, $RandomCoord (spot, 120), $GetUnitPlayerNumber (palace), "override");
	if ($IsValidGamePiece (g) == FALSE)
		g = $FM_Spawn_Safe (sp, gt, $RandomCoord (spot, 100, 250), $GetUnitPlayerNumber (palace), "override");
	if (gt != "Palace_Guard")
		foreach p in pals do
			begin
				if ($AgentInList (h, p's "Waiting_Guardhouses"))
					p's "Waiting_Guardhouses" -= h;
			end
	if ($IsValidGamePiece (g) == FALSE)
		return g;
	// safety net: register like the birth does if it did not, and start the AI thread if it is not running
	if ($IsDead (g's "Home"))
		begin
			g's "Home" = h;
			h's "Guards" << g;
			h's "Num_Guards" = h's "Num_Guards" + 1;
		end
	if ($IsRunning (g's "ActiveScript") == FALSE)
		$NewThread (g's "ActiveScript", #Henchmen_Cycle, g);
	return g;
end

function FM_Flag_Guards (agent palace, integer e, coordinate spot, agent target)
declare
	integer i, n, made, mode;
	string gt;
	agent g, h;
begin
	// Hostile / Red / Green: guards of that side (Blue: below, unchanged)
	if ($FM_Is_Hostile ())
		begin
			$FM_HG_Flag_Guards (palace, e, spot, target);
			return;
		end
	gt = $ListMember ($FM_Guard_List (), e - 100);
	n = $FM_Count ();
	if ($FM_Is_Hostile ())
		$FM_Say (palace, "IDTXT_FMX_GHOST");
	// Attack flag: same side rule as the other summons (guards are always yours)
	mode = 0;
	if ($IsDead (target) == FALSE)
		begin
			mode = 2;
			if ($GetUnitPlayerNumber (target) == $GetUnitPlayerNumber (palace))
				mode = 1;
		end
	h = $FM_Guard_Home (palace, spot, target, mode, gt);
	made = 0;
	i = 0;
	while (i < n) do
		begin
			g = $FM_Spawn_Guard (palace, gt, spot, h);
			if ($IsValidGamePiece (g))
				begin
					if (mode == 2)
						$FM_Guard_Attack (g, target);
					made = made + 1;
				end
			i = i + 1;
		end
	if (made == 0)
		begin
			$FM_Say (palace, "IDTXT_FMX_GFAIL");
			return;
		end
	$FM_Say (palace, $ListMember ($FM_Guard_Keys (), e - 100));
	if (mode == 2)
		$FM_Say (palace, "IDTXT_FMX_GMODE_ATTACK");
	if (mode == 1)
		$FM_Say (palace, "IDTXT_FMX_GMODE_GUARD");
	if (made < n)
		$FM_Say (palace, "IDTXT_FMX_PARTIAL");
end

////////////////////////////////////////////////////////////////////////////////
// LAIRS. Spawned the way the game's quest scripts place lairs at run time
// ($SpawnUnit (..., lair, coord, #Monster_Player, "maxhp"), Quests_3.gpl
// GoblinFortress / Spire spawns, Quests_1.gpl Snake pits); the data birthscript
// (lair_birth etc.) then starts the lair's Spawn_Function and Lair_Brains threads.
// Hostile: owned by the monster player. Friendly: owned by you; a watcher thread
// (AddAttribute "function" + NewThread, as in the SDK SpecialItemsExample) turns
// every monster the lair spawns into a friendly ally (FM_Make_Friendly), and its
// death script is wrapped so the lair's death spawn (Special_Spawn_Type, Witch
// King tower spiders, ...) joins you too. Limit #FM_Max_Alive applies: spawns
// above it are removed.
function FM_Lair_Sweep (agent lair, agent palace)
declare
	list units, ls, extra;
	agent u, l;
	integer alive;
	coordinate anchor;
begin
	anchor = $LocationOf (lair);
	alive = $ListSize ($FM_List_Allies (palace));
	$ListObjects (lair, "monster", 1200, units, #NoHiddenMap, #MyPlayer);
	foreach u in units do
		begin
			if ($isdead (u) == FALSE)
				begin
					if (alive >= #FM_Max_Alive)
						$DeleteGamePiece (u);
					else
						begin
							$FM_Make_Friendly (u, palace, anchor);
							alive = alive + 1;
							if (u's "title" == "Liche_Queen" || u's "title" == "Witch_King")
								begin
									extra = $FM_Fix_Boss (u, palace, anchor);
									alive = alive + $ListSize (extra);
								end
						end
				end
		end
	if ($isdead (lair))
		return;
	// copies made by Autospawn_Lair (Rats' Nest / Snake Pit) are new lairs of yours
	$ListObjects (lair, "lair", 1500, ls, #NoHiddenMap, #MyPlayer);
	foreach l in ls do
		begin
			if ($isdead (l) == FALSE)
				if ($HasAttribute ("FM_Watch", l) == FALSE)
					$FM_Lair_Adopt (l, palace);
		end
end

function FM_Lair_Watch (agent thisagent)
declare
	agent palace;
begin
	if ($isdead (thisagent))
		return;
	palace = $FM_Palace ();
	if ($IsValidGamePiece (palace) == FALSE)
		return;
	if ($GetUnitPlayerNumber (thisagent) != $GetUnitPlayerNumber (palace))
		return;
	$FM_Lair_Sweep (thisagent, palace);
end

function FM_Lair_Death (agent thisagent)
declare
	agent palace;
begin
	if ($HasAttribute ("FM_Orig_Death", thisagent))
		(thisagent's "FM_Orig_Death") (thisagent);
	else
		$lair_death (thisagent);
	palace = $FM_Palace ();
	if ($IsValidGamePiece (palace))
		$FM_Lair_Sweep (thisagent, palace);
end

function FM_Lair_Adopt (agent b, agent palace)
declare
begin
	if ($HasAttribute ("FM_Watch", b) == FALSE)
		begin
			$AddAttribute (b, "FM_Watch", "function", $FM_Lair_Watch);
			$AddAttribute (b, "FM_Orig_Death", "function", b's "IGdeathScript");
			b's "IGdeathScript" = $FM_Lair_Death;
			$NewThread (b's "FM_Watch", #Lair_Cycle, b);
		end
	$FM_Lair_Sweep (b, palace);
end

function FM_Flag_Lair (agent palace, integer e, coordinate spot)
declare
	agent b;
	integer tries, owner;
	string lt, t;
	boolean hostile;
begin
	lt = $ListMember ($FM_Lair_List (), e - 400);
	hostile = $FM_Is_Hostile ();
	if (hostile)
		owner = $FM_Host_Player (palace);
	else
		owner = $GetUnitPlayerNumber (palace);
	b = $FM_Spawn_Safe (palace, lt, spot, owner, "maxhp");
	tries = 0;
	while ($IsValidGamePiece (b) == FALSE && tries < 3) do
		begin
			b = $FM_Spawn_Safe (palace, lt, $RandomCoord (spot, 100, 250), owner, "maxhp");
			tries = tries + 1;
		end
	if ($IsValidGamePiece (b) == FALSE)
		begin
			$FM_Say (palace, "IDTXT_FMX_LFAIL");
			return;
		end
	// quest-only death scripts (Spire_Death declares victory when no spire is left,
	// Hidden_Ring/Sword quest items and flags, Slave_Pits / Sphere quest waves)
	t = b's "title";
	if (t == "SpireOfDeath" || t == "Hidden_Ring_Site" || t == "Hidden_Sword_Site" || t == "Slave_Pits" || t == "Brashnards_Sphere")
		b's "IGdeathScript" = $Lair_death;
	// Broken_sewer_Birth moves the lair to the monster player: force the chosen owner
	if ($GetUnitPlayerNumber (b) != owner)
		$SetUnitPlayerNumber (b, owner);
	if (hostile)
		begin
			$FM_Fac_Team (palace, b);
			// Sewer_Spawn always spawns for #Monster_Player: Red / Green sewers use the generic Spawn
			if (owner != #Monster_Player && t == "Sewers")
				b's "Spawn_Function" = $Spawn;
			$FM_Say_Owner (palace);
			$FM_Say (palace, $ListMember ($FM_LairH_Keys (), e - 400));
			return;
		end
	if (t == "ElvenHideout")
		begin
			b's "activeScript" = $FM_Hideout_Friendly;
			$FM_Say (palace, $ListMember ($FM_LairF_Keys (), e - 400));
			return;
		end
	// Sewer_Spawn always spawns for #Monster_Player: use the generic lair Spawn
	if (t == "Sewers")
		b's "Spawn_Function" = $Spawn;
	$FM_Lair_Adopt (b, palace);
	$FM_Say (palace, $ListMember ($FM_LairF_Keys (), e - 400));
end

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// ===== in-game status lines for the Cheat Engine hotkeys =====
// A thread on your Palace (AddAttribute "function" + NewThread, as in the SDK
// SpecialItemsExample) reads the FMCE_* values every 0.7 s and prints two chat
// lines when any of them changed (CE hotkeys, CE table):
//   "[FM] Selected: <entry>"  and  "[FM] Summon ON/OFF | Friendly/Hostile | n per flag"
// FMCE_Ping (+1 by the CE scan hotkey) prints "Cheat Engine hotkeys connected".
// FMCE_Rules tells the CE hotkeys which list to use (1 Expansion, 2 Original).
function FM_Ensure_Watch ()
declare
	agent palace;
begin
	palace = $FM_Palace ();
	if ($IsValidGamePiece (palace) == FALSE)
		return;
	if ($HasAttribute ("FMW_Fn", palace) == FALSE)
		begin
			$AddAttribute (palace, "FMW_Fn", "function", $FM_Value_Watch);
			$AddAttribute (palace, "FMW_Sig", "integer", -1);
			$AddAttribute (palace, "FMW_Ping", "integer", -1);
		end
	if ($IsRunning (palace's "FMW_Fn") == FALSE)
		$NewThread (palace's "FMW_Fn", 700, palace);
end

function FM_Say_Status (agent palace)
declare
begin
	return;
end

function FM_Value_Watch (agent thisagent)
declare
	agent root;
	integer sig, p, o, f;
begin
	if ($isdead (thisagent))
		return;
	$DZA_Check (thisagent);
	root = $FM_Root ();
	o = 0;
	if ($FM_Is_On ())
		o = 1;
	f = $FM_Fac ();
	sig = $FM_Entry () + 1000 * $FM_Count () + 100000 * o + 1000000 * f;
	p = $FM_Decode (root's "FMCE_Ping", 7602176, 0, 99, 0);
	if (thisagent's "FMW_Sig" == -1)
		begin
			thisagent's "FMW_Sig" = sig;
			thisagent's "FMW_Ping" = p;
			return;
		end
	if (p != thisagent's "FMW_Ping")
		begin
			thisagent's "FMW_Ping" = p;
			thisagent's "FMW_Sig" = sig;
			$FM_Say (thisagent, "IDTXT_FMX_W_PING");
			$FM_Say_Status (thisagent);
			return;
		end
	if (sig != thisagent's "FMW_Sig")
		begin
			thisagent's "FMW_Sig" = sig;
			$FM_Say_Status (thisagent);
		end
end

function FM_W_Key (integer e) is string
declare
begin
	if (e > 400)
		return $ListMember ($FM_W_Keys (), #FM_Type_Count + 7 + 21 + 39 + e - 400);
	if (e > 200)
		return $ListMember ($FM_W_Keys (), #FM_Type_Count + 7 + 21 + e - 200);
	if (e > 110)
		return $ListMember ($FM_W_Keys (), #FM_Type_Count + 7 + e - 110);
	if (e > 100)
		return $ListMember ($FM_W_Keys (), #FM_Type_Count + e - 100);
	return $ListMember ($FM_W_Keys (), e);
end

