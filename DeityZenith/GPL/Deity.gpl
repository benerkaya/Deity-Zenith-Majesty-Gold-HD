////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// ===== nature monsters (Flowering Strangleweed, Daemonwood, Dryad) =====
// They are ordinary monster entries (appended after the last monster). Spawned like
// every other monster (SpawnUnit, data birthscript Guardian_Birth -> Monster_Birth).
// Friendly: FMB_Make_Friendly as usual (Type Hero / SubType Controlled, your player,
// StartingScript FMB_Friendly_Loop = the ally marker), but FMB_Friendly_Loop hands
//   Strangleweed (speed 0, data AI Rooted_Guardian) to FMB_Rooted_Loop below, and
//   Daemonwood (data AI Returning_Guardian) to the game's own Returning_Guardian,
//   which only uses $list_enemies_seen (team based) and Coord_Home (= the flag).
// The game itself keeps native AI for friendly Daemonwoods (epic_quest_scripts
// setup_rescue_pets / pet_ready). Dryad moves normally and uses the regular loop.
// Hostile: monster player, data AI; FMB_Hostile_Prep sets Coord_Home to the spawn spot.
//
// Same as the data AI Rooted_Guardian, but enemies are found by team
// ($list_enemies_seen) instead of the "EnemyType" attribute, and it never moves.
function FMB_Rooted_Loop (agent thisagent)
declare
	list enemies;
	agent t;
begin
	if ($isdead (thisagent))
		return;
	enemies = $list_enemies_seen (thisagent, $GetAttribute (thisagent, #ATTRIB_SightRange));
	if ($ListSize (enemies) > 0)
		begin
			t = $pick_closest (thisagent, enemies);
			if ($IsValidGamePiece (t))
				begin
					thisagent's "target" = t;
					$PerformAction (thisagent, thisagent's "Attack_Action", t);
					return;
				end
		end
	thisagent's "target" = $NullAgent ();
	if ($RandomNumber (1000) > 950)
		$PerformAction (thisagent, "basic_idle_2", thisagent);
	else
		$PerformAction (thisagent, "do_nothing", $LocationOf (thisagent));
end

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// ===== bodyguard summons with the ATTACK flag =====
// OVERRIDE (by name) of attack_flag_birth (Flags.dat / mx_Flags.dat: Flag_Attack
// birthscript attack_Flag_Birth; original in DecisionTrees/Modules/check_rewards.gpl
// and mx_check_rewards.gpl). When summon is OFF, or for another player's flag, the
// ORIGINAL body below runs unchanged (copied verbatim, only re-formatted).
// When ON (your flag): the flag is removed (reward refunded, like the Explore flag)
// and the selected unit(s) appear next to the flagged unit/building:
//   monsters  -> same owner as the target: bodyguards; other owner: attackers
//   guards, buildings, lairs, Strangleweed -> simply placed next to the target.
function FMB_Hook_attack_flag_birth (agent thisagent)
declare
	agent target;
	integer flagplayer, targetplayer;
begin
	if ($FMB_Is_Human_Flag (thisagent))
		begin
			$FMB_Ensure_Watch ();
			if ($FMB_Is_On ())
				begin
					thisagent's "gavereward" = FALSE;
					thisagent's "activeScript" = $FMB_Attack_Poll;
					$NewThread (thisagent's "activeScript", 300, thisagent);
					return;
				end
		end
	$NewThread (thisagent's "activeScript", #flag_Cycle, thisagent);
	thisagent's "gavereward" = FALSE;

	target = $agentnumber ($getattribute (thisagent, #ATTRIB_targetID));
	targetplayer = $getunitplayernumber (target);
	flagplayer = $getunitplayernumber (thisagent);
	if (targetplayer != #monster_player)
		if (targetplayer != flagplayer)
			if ($getplayerteamnumber (target) == $getplayerteamnumber (thisagent))
				begin
					$setplayerteamnumber (thisagent, $newteamnumber ());
				end
end

// Same pattern as FMB_Flag_Poll. The target is read the way the original
// attack_flag_poll does: $AgentNumber ($GetAttribute (flag, #ATTRIB_targetID)).
function FMB_Attack_Poll (agent thisagent)
declare
	agent palace, target;
	coordinate spot;
	integer e, reward;
begin
	target = $AgentNumber ($GetAttribute (thisagent, #ATTRIB_targetID));
	if (thisagent's "gavereward" == TRUE)
		begin
			$FMB_Flag_Finish (thisagent, target);
			return;
		end
	thisagent's "gavereward" = TRUE;
	palace = $FMB_Palace ();
	spot = $LocationOf (thisagent);
	reward = $GetAttribute (thisagent, #ATTRIB_rewardcost);
	e = $FMB_Entry ();
	if (reward > 0)
		$AdjustPlayerData (palace, "gold", reward);
	if ($IsValidGamePiece (palace) == FALSE)
		begin
			$DeleteGamePiece (thisagent);
			return;
		end
	if ($FMB_BG_Gone (target) == FALSE)
		spot = $LocationOf (target);
	else
		begin
			$FMB_Say (palace, "IDTXT_FMB_BG_NOTARGET");
			target = $NullAgent ();
		end
	if (e > 400)
		$FMB_Flag_Lair (palace, e, spot);
	else if (e > 200)
		$FMB_Flag_Building (palace, e, spot);
	else if (e > 110)
		$FMB_Flag_Heroes (palace, e, spot, target);
	else if (e > 106)
		$FMB_Flag_Heroes (palace, 131, spot, target);
	else if (e > 103)
		$FMB_Flag_Guards (palace, e - 3, spot, target);
	else if (e > 100)
		$FMB_Flag_Henchmen (palace, e, spot);
	else if ($IsValidGamePiece (target))
		$FMB_Flag_Bodyguards (palace, e, target);
	else
		$FMB_Flag_Monsters (palace, e, spot);
	$FMB_Note (palace, 1);
end

function FMB_BG_Gone (agent t) is boolean
declare
begin
	if ($IsValidGamePiece (t) == FALSE)
		return TRUE;
	if ($isdead (t))
		return TRUE;
	return FALSE;
end

// The mode comes from comparing OWNER PLAYERS: the owner the summons get
// (faction picker: Friendly = your player, Hostile = #Monster_Player, Red = #Player_2,
// Green = #Player_3) against $GetUnitPlayerNumber of the flagged target.
// Same owner -> 1 bodyguard, different owner -> 2 attack. Monster-player things (monsters,
// lairs, wildlife, sewer rats, neutral map buildings) all belong to Hostile.
function FMB_Flag_Bodyguards (agent palace, integer e, agent target)
declare
	integer i, n, made, alive, tries;
	string unitType;
	list got;
	agent u, m;
	coordinate spot;
	boolean hostile;
	integer mode;
	integer sp;
begin
	unitType = $ListMember ($FMB_Type_List (), e);
	n = $FMB_Count ();
	spot = $LocationOf (target);
	hostile = $FMB_Is_Hostile ();
	sp = $GetUnitPlayerNumber (palace);
	if (hostile)
		sp = $FMB_Host_Player (palace);
	mode = 2;
	if ($GetUnitPlayerNumber (target) == sp)
		mode = 1;
	alive = $ListSize ($FMB_List_Allies (palace));
	made = 0;
	i = 0;
	while (i < n) do
		begin
			if (hostile)
				begin
					m = $FMB_Spawn_Safe (palace, unitType, $RandomCoord (spot, 150), sp, "override");
					tries = 0;
					while ($IsValidGamePiece (m) == FALSE && tries < 2) do
						begin
							m = $FMB_Spawn_Safe (palace, unitType, $RandomCoord (spot, 100, 250), sp, "override");
							tries = tries + 1;
						end
					if ($IsValidGamePiece (m))
						begin
							$FMB_Hostile_Mark (m);
							$FMB_Fac_Team (palace, m);
							$FMB_Hostile_Bodyguard (m, target, mode, sp);
							made = made + 1;
						end
				end
			else if (alive + made < #FMB_Max_Alive)
				begin
					got = $FMB_Spawn_At (palace, unitType, spot);
					if ($ListSize (got) > 0)
						made = made + 1;
					foreach u in got do
						begin
							$FMB_Make_Bodyguard (u, target, mode);
						end
				end
			i = i + 1;
		end
	if (made == 0)
		begin
			if (hostile)
				$FMB_Say (palace, "IDTXT_FMB_HFAIL");
			else if (alive >= #FMB_Max_Alive)
				$FMB_Say (palace, "IDTXT_FMB_CAP");
			else
				$FMB_Say (palace, "IDTXT_FMB_FAIL");
			return;
		end
	if (hostile)
		$FMB_Say_Owner (palace);
	if (unitType == "Strangleweed")
		$FMB_Say (palace, "IDTXT_FMB_BG_ROOTED");
	else if (mode == 2)
		begin
			$FMB_Say (palace, "IDTXT_FMB_MODE_ATTACK");
			$FMB_Say (palace, $ListMember ($FMB_BGA_Keys (), e));
		end
	else
		begin
			$FMB_Say (palace, "IDTXT_FMB_MODE_GUARD");
			if (hostile)
				$FMB_Say (palace, $ListMember ($FMB_BGH_Keys (), e));
			else
				$FMB_Say (palace, $ListMember ($FMB_BGF_Keys (), e));
		end
	if (made < n)
		begin
			if (hostile)
				$FMB_Say (palace, "IDTXT_FMB_HPARTIAL");
			else
				$FMB_Say (palace, "IDTXT_FMB_PARTIAL");
		end
end

// Bodyguard / attacker (friendly ones: FMB_Make_Friendly already ran; Hostile / Red / Green
// ones: FMB_Hostile_Bodyguard saved their own AI first). mode 1 = BODYGUARD, mode 2 = ATTACK.
// The mode is stored on the unit (FMB_BG_Mode) and a re-apply thread (FMB_BG_Fn, every 1.5 s)
// restores our scripts if anything else overwrote them. The unit's own evaluationScript is
// kept in FMB_OE: in ATTACK mode it is replaced by FMB_BG_NoEval and "relentless" is TRUE, so
// monster_eval_enemies / target_out_of_range can't pull it off the flagged target (that is
// what made attackers wander off to peasants and guards instead).
function FMB_Make_Bodyguard (agent u, agent target, integer mode)
declare
begin
	if ($isdead (u))
		return;
	u's "Coord_Home" = $LocationOf (u);
	if (u's "title" == "Strangleweed")
		return;
	u's "Leader" = target;
	if (mode == 2)
		u's "Target_Item" = 9172;
	else
		u's "Target_Item" = 9171;
	$FMB_BG_Scripts (u);
end

function FMB_BG_NoEval (agent thisagent)
declare
begin
end

// HOSTILE / Red / Green bodyguard or attacker: same loop as the friendly ones, but the
// unit keeps its owner and its own AI is saved (FMB_OA/OB/OC scripts, FMB_ORel relentless)
// and given back when the flagged target is gone (FMB_BG_Restore).
function FMB_Hostile_Bodyguard (agent u, agent target, integer mode, integer owner)
declare
begin
	if ($isdead (u))
		return;
	u's "Coord_Home" = $LocationOf (u);
	if (u's "title" == "Strangleweed")
		return;
	u's "Leader" = target;
	if (mode == 2)
		u's "Target_Item" = 9174;
	else
		u's "Target_Item" = 9173;
	$FMB_BG_Scripts (u);
end

// target gone: a Hostile / Red / Green summon goes back to its own monster AI
function FMB_BG_Restore (agent thisagent)
declare
begin
	thisagent's "target" = $NullAgent ();
	thisagent's "Leader" = $NullAgent ();
	thisagent's "Coord_Home" = $LocationOf (thisagent);
	thisagent's "relentless" = FALSE;
	if (thisagent's "FM_ORel" == 1)
		thisagent's "relentless" = TRUE;
	if ($HasAttribute ("FM_OE", thisagent))
		thisagent's "evaluationScript" = thisagent's "FM_OE";
	thisagent's "BasicScript" = thisagent's "FM_OC";
	thisagent's "BackScript" = thisagent's "FM_OB";
	thisagent's "ActiveScript" = thisagent's "FM_OC";
end

function FMB_BG_Scripts (agent u)
declare
begin
	u's "target" = $NullAgent ();
	u's "ActiveScript" = $FMB_Bodyguard_Loop;
	u's "BackScript" = $FMB_Bodyguard_Loop;
	u's "BasicScript" = $FMB_Bodyguard_Loop;
end

// Re-apply thread of a bodyguard/attacker (FMB_BG_Mode 1/2; 0 = finished).
// Friendly: back to your player + our scripts if something replaced them (Reset_Controlled).
// Hostile / Red / Green (FMB_BG_Own): if another side took it over (charm), it is left alone.
function FMB_BG_Reapply (agent thisagent)
declare
	agent palace;
begin
	if ($isdead (thisagent))
		return;
	if (thisagent's "FM_BG_Mode" == 0)
		return;
	if ($HasAttribute ("FM_BG_Own", thisagent))
		begin
			if ($GetUnitPlayerNumber (thisagent) != thisagent's "FM_BG_Own")
				begin
					thisagent's "FM_BG_Mode" = 0;
					return;
				end
			if (thisagent's "BasicScript" != $FMB_Bodyguard_Loop)
				$FMB_BG_Scripts (thisagent);
			return;
		end
	palace = $FMB_Palace ();
	if ($IsValidGamePiece (palace) == FALSE)
		return;
	if ($GetUnitPlayerNumber (thisagent) != $GetUnitPlayerNumber (palace))
		begin
			$FMB_Make_Friendly (thisagent, palace, thisagent's "Coord_Home");
			$FMB_BG_Scripts (thisagent);
			return;
		end
	if (thisagent's "BasicScript" != $FMB_Bodyguard_Loop)
		$FMB_BG_Scripts (thisagent);
end

// Behaviour of a bodyguard / attacker (modelled on familiar_skeleton,
// mx_Controlled_Monster.gpl:178):
// - target gone: FMB_BG_Mode = 0; friendly -> normal summon guarding the spot where it stands
//   (FMB_Friendly_Loop); Hostile / Red / Green -> its own AI again (FMB_BG_Restore)
// - ATTACK mode: the target is the sticky attack target (monster_attack_object, re-set every
//   cycle, relentless, no evaluationScript); if the target hides in a building, it waits there
// - BODYGUARD mode: attack enemies seen by the summon itself within #FMB_Guard_Range of the
//   target, else wander within 300 of it ($wander_near_leader: $RandomCoord (leader, 300))
function FMB_Bodyguard_Loop (agent thisagent)
declare
	agent leader, real, t;
	list seen, enemies;
	integer k, mode;
	boolean hostile;
begin
	if ($isdead (thisagent))
		return;
	k = thisagent's "Target_Item";
	mode = 0;
	hostile = FALSE;
	if (k == 9171 || k == 9173)
		mode = 1;
	if (k == 9172 || k == 9174)
		mode = 2;
	if (k == 9173 || k == 9174)
		hostile = TRUE;
	// summons made by older versions
	if (mode == 0)
		if ($HasAttribute ("FM_BG_Mode", thisagent))
			begin
				mode = thisagent's "FM_BG_Mode";
				if ($HasAttribute ("FM_BG_Own", thisagent))
					hostile = TRUE;
			end
	if (hostile == FALSE)
		if (thisagent's "Type" != "Hero" || thisagent's "EnemyType" != "Monster")
			$FMB_Control_Types (thisagent);
	real = thisagent's "Leader";
	if ($FMB_BG_Gone (real) || mode <= 0)
		begin
			if ($HasAttribute ("FM_BG_Mode", thisagent))
				thisagent's "FM_BG_Mode" = 0;
			thisagent's "target" = $NullAgent ();
			thisagent's "relentless" = FALSE;
			thisagent's "evaluationScript" = $monster_eval_enemies;
			thisagent's "Coord_Home" = $LocationOf (thisagent);
			if (hostile)
				begin
					// back to the normal monster AI
					thisagent's "Target_Item" = 9175;
					thisagent's "Leader" = $NullAgent ();
					thisagent's "ActiveScript" = $wandering;
					thisagent's "BackScript" = $wandering;
					thisagent's "BasicScript" = $wandering;
					return;
				end
			thisagent's "Target_Item" = 9170;
			thisagent's "Leader" = $FMB_Palace ();
			thisagent's "ActiveScript" = $FMB_Friendly_Loop;
			thisagent's "BackScript" = $FMB_Friendly_Loop;
			thisagent's "BasicScript" = $FMB_Friendly_Loop;
			return;
		end
	leader = real;
	if ($IsHidden (real))
		begin
			leader = $GetBuildingContainer (real);
			if ($IsValidGamePiece (leader) == FALSE)
				return;
		end
	if (mode == 2)
		begin
			thisagent's "relentless" = TRUE;
			thisagent's "evaluationScript" = $FMB_BG_NoEval;
			if ($IsHidden (real) == FALSE)
				begin
					thisagent's "target" = real;
					thisagent's "activescript" = $monster_attack_object;
					thisagent's "backscript" = $monster_attack_object;
					return;
				end
		end
	else
		begin
			if (thisagent's "evaluationScript" == $FMB_BG_NoEval)
				thisagent's "evaluationScript" = $monster_eval_enemies;
			// enemies of THIS summon (its own team), near the target
			seen = $list_enemies_seen (thisagent, $GetAttribute (thisagent, #ATTRIB_SightRange) + #FMB_Guard_Range);
			foreach t in seen do
				begin
					if ($DistanceBetweenAgents (t, leader) <= #FMB_Guard_Range)
						enemies << t;
				end
			if ($ListSize (enemies) > 0)
				begin
					thisagent's "target" = $pick_closest (thisagent, enemies);
					if ($IsValidGamePiece (thisagent's "target"))
						begin
							thisagent's "activescript" = $monster_attack_object;
							thisagent's "backscript" = $monster_attack_object;
							return;
						end
				end
		end
	if ($IsMoving (thisagent) == FALSE)
		if ($DistanceBetweenAgents (thisagent, leader) > 150 || $RandomNumber (100) < 30)
			$Move (thisagent, $RandomCoord (leader, 300));
end

////////////////////////////////////////////////////////////////////////////////
// Elven Hideout (Building_Data.dat [Elven_Hideout], title ElvenHideout, birth
// hideout_birth -> activeScript hideout_active every 60 s). The original
// hideout_active fills the empty slots of its OWNER's Elven Bungalows with Elves
// of #Monster_player, i.e. a hideout of yours would turn your bungalows into
// enemy-elf spawners. Friendly hideout: replaced by this script, which runs the
// game's own guild generator (Lair.gpl Hero_Generator, used by the epic quests
// as a guild SpecialScript) on each of your Elven Bungalows: free elves of yours.
// Hostile hideout (monster player): original script; the monster player has no
// bungalows, so it is a plain enemy building (250 HP, drops gold/items).
function FMB_Hideout_Friendly (agent thisagent)
declare
	list bl;
	agent b;
begin
	if ($isdead (thisagent))
		return;
	$ListObjects (thisagent, "building", -1, bl, #MyPlayer);
	bl = $ListTitles (bl, "Elven_bungalow");
	foreach b in bl do
		begin
			if ($isdead (b) == FALSE)
				$Hero_Generator (b);
		end
end

