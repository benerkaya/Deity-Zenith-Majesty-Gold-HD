////////////////////////////////////////////////////////////////////////////////
// The human player's palace (player 1 in single-player). Allies spawn/guard here.
function FMB_Palace () is agent
declare
	list palaces;
	agent p, q, found;
begin
	palaces = $ListPalaces ();
	if ($ListSize (palaces) == 0)
		return $NullAgent ();

	found = $ListMember (palaces, 1);
	foreach p in palaces do
		begin
			// Never a palace made by Deity Zenith while the player has a real one
			q = p;
			if ($FMB_Is_Mod_Palace (p))
				q = $FMB_Fix_Slot (p);
			if ($GetUnitPlayerNumber (q) == #Player_1)
				found = q;
		end
	return found;
end

////////////////////////////////////////////////////////////////////////////////
function FMB_Old_Get_Index () is integer
declare
	agent root;
	integer i;
begin
	root = $FMB_Root ();
	i = root's "FM_Selected_Type";
	if (i < 1 || i > #FMB_Type_Count)
		begin
			i = 1;
			root's "FM_Selected_Type" = i;
		end
	return i;
end

////////////////////////////////////////////////////////////////////////////////
function FMB_Say (agent palace, string key)
declare
begin
	// Debug / diagnostic lines are not printed any more
	if (key == "IDTXT_FMB_HOOK_ON" || key == "IDTXT_FMB_HOOK_ON_H" || key == "IDTXT_FMB_HOOK_OFF" || key == "IDTXT_FMB_W_PING" || key == "IDTXT_FMB_AB_WRAP" || key == "IDTXT_FMB_AB_LATE" || key == "IDTXT_FMB_AB_FIX" || key == "IDTXT_FMB_CV_ON" || key == "IDTXT_FMB_CV_FIX" || key == "IDTXT_FMB_CV_STOP" || key == "IDTXT_FMB_ST1" || key == "IDTXT_FMB_ST2" || key == "IDTXT_FMB_STFIX")
		return;
	$LocalChatMessage ($GetUnitPlayerNumber (palace), key);
	$DebugOut ("FriendlyMonsters:", key);
end

////////////////////////////////////////////////////////////////////////////////
// Target flag. GPL has no cursor / camera / selection functions, but the
// player's reward flags are agents (prototype RewardFlag, titles Flag_Explore,
// Flag_Attack, Flag_Guard) listed exactly like the original CountPlacedFlags:
//   $listobjects (palace, "RewardFlag", -1, flags, #Rewardflags, #Myplayer, #NoHiddenMap)
// Rule (stateless): an Explore flag if there is one, otherwise any of the
// player's flags; if several, the first one listed (nearest the palace, the
// same way the original FlagEconomicTarget takes $ListMember (list, 1)).
// Returns $NullAgent () when there is no flag.
function FMB_Pick_Flag (agent palace) is agent
declare
	list flags, explore;
begin
	$ListObjects (palace, "RewardFlag", -1, flags, #RewardFlags, #MyPlayer, #NoHiddenMap);
	if ($ListSize (flags) == 0)
		return $NullAgent ();
	explore = $ListTitles (flags, "Flag_Explore");
	if ($ListSize (explore) > 0)
		return $ListMember (explore, 1);
	return $ListMember (flags, 1);
end

////////////////////////////////////////////////////////////////////////////////
// Runs only AFTER the new allies exist next to the palace, so a failure here can
// never cancel a summon. Re-anchors them on the flag and teleports them there
// (TeleportToUnit, as the original Demo.gpl / Guild_Skills use with range
// 50000). If the jump does not happen they simply walk there, because
// FMB_Friendly_Loop always heads for Coord_Home.
// Returns 0 = no flag (stay at palace), 1 = at the flag, 2 = walking there.
function FMB_Send_To_Flag (agent palace, list units) is integer
declare
	agent flag, u;
	coordinate spot;
	integer result;
begin
	flag = $FMB_Pick_Flag (palace);
	if ($IsValidGamePiece (flag) == FALSE)
		return 0;
	spot = $LocationOf (flag);
	if ($GetX (spot) == 0 && $GetY (spot) == 0)
		return 0;

	result = 1;
	foreach u in units do
		begin
			if ($isdead (u) == FALSE)
				begin
					u's "Coord_Home" = spot;
					$TeleportToUnit (u, 50000, flag, 0);
					if ($DistanceBetweenAgents (u, flag) > 600)
						result = 2;
				end
		end
	return result;
end

////////////////////////////////////////////////////////////////////////////////
// Living allies of this mod: Type "hero" / SubType "Controlled" units of the
// player whose StartingScript is ours. ListObjects matches the GPL "type"
// attribute, the same way the original Healer code finds controlled skeletons
// ($ListSubtypesInRadius (ThisAgent, "hero", "controlled", ...)).
function FMB_List_Allies (agent palace) is list
declare
	list units, result;
	agent u;
begin
	$ListObjects (palace, "hero", -1, units, #NoHiddenMap, #InsideOtherUnits, #MyPlayer, #CheckSubTypes, "Controlled");
	foreach u in units do
		begin
			if ($isdead (u) == FALSE)
				if ($HasAttribute ("StartingScript", u))
					if (u's "StartingScript" == $FMB_Friendly_Loop)
						result << u;
		end
	return result;
end

////////////////////////////////////////////////////////////////////////////////
// An ally's anchor is its standard monster field "Coord_Home" (declared in the
// monster prototype). Allies from older builds have no anchor (0,0): use the palace.
function FMB_Has_Anchor (agent m) is boolean
declare
	coordinate c;
begin
	c = m's "Coord_Home";
	if ($GetX (c) == 0 && $GetY (c) == 0)
		return FALSE;
	return TRUE;
end

////////////////////////////////////////////////////////////////////////////////
// Behaviour loop of a friendly monster: fight the nearest enemy it can see,
// otherwise wander around its anchor (spawn point). reset_tasks() returns here
// after a fight because this is also the BasicScript.
function FMB_Friendly_Loop (agent thisagent)
declare
	agent home;
	list enemies;
begin
	if ($isdead (thisagent))
		return;
	// Original rules: stay on the kingdom's side (Become_Controlled types)
	if (thisagent's "Type" != "Hero" || thisagent's "EnemyType" != "Monster")
		$FMB_Control_Types (thisagent);
	if ($CheckEffector (thisagent, "Charm_icon") == FALSE)
		$CreateEffector (thisagent, "Charm_icon", 1, "infinite");

	// Rooted / home-bound monsters keep a stationary behaviour
	if (thisagent's "title" == "Strangleweed")
		begin
			$FMB_Rooted_Loop (thisagent);
			return;
		end
	if (thisagent's "title" == "Daemonwood")
		begin
			$Returning_Guardian (thisagent);
			return;
		end

	enemies = $list_enemies_seen (thisagent, $GetAttribute (thisagent, #ATTRIB_SightRange));
	if ($ListSize (enemies) > 0)
		begin
			thisagent's "target" = $pick_closest (thisagent, enemies);
			if ($IsValidGamePiece (thisagent's "target"))
				begin
					thisagent's "activescript" = $monster_attack_object;
					thisagent's "backscript" = $monster_attack_object;
					return;
				end
		end

	if ($IsMoving (thisagent) == FALSE)
		begin
			if ($FMB_Has_Anchor (thisagent))
				$Move (thisagent, $RandomCoord (thisagent's "Coord_Home", #FMB_Wander_Radius));
			else
				begin
					home = thisagent's "leader";
					if ($IsValidGamePiece (home))
						$Move (thisagent, $RandomCoord (home, #FMB_Wander_Radius));
					else
						$Move (thisagent, $RandomCoord (thisagent, #FMB_Wander_Radius));
				end
		end
end

////////////////////////////////////////////////////////////////////////////////
// Kept only for allies spawned by the first release (their IGDeathScript points here).
function FMB_Friendly_Death (agent thisagent)
declare
begin
	$monster_gravestone (thisagent);
end

////////////////////////////////////////////////////////////////////////////////
// The base game's own friendly monster = the Control Monster spell (GPL/TaskModules/Subtasks/
// Control_Monster.gpl): Charm_icon, owner = caster's player, Type and Original_Type "Hero", SubType
// "Controlled", EnemyType "Monster". The hero AI looks for targets with $ListObjects (.., "monster", ..)
// (Combat_wandering.gpl:26, target_eval.gpl list_enemies) and the engine matches that string against the
// unit's GPL "Type" attribute, so a Type "Hero" unit of your own team is never hunted by your heroes.
// The icon first, then the older order (known to run in Original); no $AddAttribute at all.
function FMB_Control_Types (agent m)
declare
begin
	m's "Type" = "Hero";
	m's "Original_Type" = "Hero";
	m's "SubType" = "Controlled";
	m's "EnemyType" = "Monster";
end

function FMB_Make_Friendly (agent m, agent palace, coordinate anchor)
declare
	integer k;
begin
	if ($isdead (m))
		return;
	if ($CheckEffector (m, "Charm_icon") == FALSE)
		$CreateEffector (m, "Charm_icon", 1, "infinite");
	$SetUnitPlayerNumber (m, $GetUnitPlayerNumber (palace));
	$FMB_Control_Types (m);
	if ($HasAttribute ("Target_Item", m))
		begin
			k = m's "Target_Item";
			if (k != 9171 && k != 9172)
				m's "Target_Item" = 9170;
		end
	m's "Leader" = palace;
	if ($HasAttribute ("Coord_Home", m))
		m's "Coord_Home" = anchor;
	if ($HasAttribute ("familiar", m))
		m's "familiar" = FALSE;
	if ($HasAttribute ("relentless", m))
		m's "relentless" = FALSE;
	m's "ActiveScript" = $FMB_Friendly_Loop;
	m's "BackScript" = $FMB_Friendly_Loop;
	m's "BasicScript" = $FMB_Friendly_Loop;
	m's "StartingScript" = $FMB_Friendly_Loop;
	m's "IGDeathScript" = $Monster_Gravestone;
	m's "target" = $NullAgent ();
	$ClearList (m's "hostiles");
end

////////////////////////////////////////////////////////////////////////////////
// Bosses: Liche_Queen / Witch_King spawn minions (as children, so owned by us
// but still enemy-style monsters) and the Witch King turns every Giant_Spider /
// Daemonwood on the map into a raider - which would also hit our allied spiders.
// Returns the converted minions.
function FMB_Fix_Boss (agent boss, agent palace, coordinate anchor) is list
declare
	list minions, allies, result;
	agent u;
begin
	// minions: player-owned units that are still Type "monster" near the boss
	$ListObjects (boss, "monster", 800, minions, #NoHiddenMap, #MyPlayer);
	foreach u in minions do
		begin
			if ($isdead (u) == FALSE)
				begin
					$FMB_Make_Friendly (u, palace, anchor);
					result << u;
				end
		end

	if (boss's "title" == "Witch_King")
		begin
			allies = $FMB_List_Allies (palace);
			foreach u in allies do
				begin
					if (u's "title" == "Giant_Spider" || u's "title" == "Daemonwood")
						begin
							if ($FMB_Has_Anchor (u))
								$FMB_Make_Friendly (u, palace, u's "Coord_Home");
							else
								$FMB_Make_Friendly (u, palace, $LocationOf (palace));
						end
				end
		end
	return result;
end

////////////////////////////////////////////////////////////////////////////////
// Spawns exactly like the build that worked (spawner = palace, spot near the
// palace). Returns the new ally plus any boss minions; empty list on failure.
function FMB_Summon_One (agent palace, string unitType) is list
declare
	agent m;
	coordinate home;
	list result, extra;
begin
	$FMB_Q_Save (unitType);
	m = $SpawnUnit (palace, unitType, $RandomCoord (palace, 150, #FMB_Spawn_Radius), $GetUnitPlayerNumber (palace), "override");
	if ($IsValidGamePiece (m))
		begin
			home = $LocationOf (palace);
			$FMB_Make_Friendly (m, palace, home);
			result << m;
			if (unitType == "Liche_Queen" || unitType == "Witch_King")
				begin
					extra = $FMB_Fix_Boss (m, palace, home);
					result = $AddLists (result, extra);
				end
		end
	return result;
end

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// ===== Explore-flag summoning controlled from Cheat Engine =====
// Three integers on GplAIRoot (added once, kept in saves). Values carry a magic
// offset so Cheat Engine can find them with an exact-value / AOB scan:
//   FMCE_Type  = 7340032 + entry   (entry ranges: see the guards / lairs / faction picker block)
//   FMCE_On    = 7405568 + 0/1     (0 = OFF: flags behave normally)
//   FMCE_Count = 7471104 + n       (monsters per flag, 1..10)
// Plain values (entry / 0 / 1 / n without the offset) are accepted as well.
function FMB_Root () is agent
declare
	agent root;
begin
	root = $RetrieveAgent ("GplAIRoot");
	if ($HasAttribute ("FMCE_Type", root) == FALSE)
		begin
			$AddAttribute (root, "FMCE_Type", "integer", 7340033);
			root's "FMCE_Type" = 7340033;
		end
	if ($HasAttribute ("FMCE_On", root) == FALSE)
		$AddAttribute (root, "FMCE_On", "integer", 7405568);
	if ($HasAttribute ("FMCE_Count", root) == FALSE)
		begin
			$AddAttribute (root, "FMCE_Count", "integer", 7471105);
			root's "FMCE_Count" = 7471105;
		end
	if ($HasAttribute ("FMCE_Note", root) == FALSE)
		$AddAttribute (root, "FMCE_Note", "integer", 0);
	if ($HasAttribute ("FMCE_Faction", root) == FALSE)
		$AddAttribute (root, "FMCE_Faction", "integer", 7536640);
	if ($HasAttribute ("FMCE_Ping", root) == FALSE)
		$AddAttribute (root, "FMCE_Ping", "integer", 7602176);
	if ($HasAttribute ("FMCE_Rules", root) == FALSE)
		$AddAttribute (root, "FMCE_Rules", "integer", 7667714);
	if ($HasAttribute ("FMCE_Abil", root) == FALSE)
		begin
			$AddAttribute (root, "FMCE_Abil", "integer", 7733249);
			root's "FMCE_Abil" = 7733249;
		end
	if ($HasAttribute ("FMCE_Give", root) == FALSE)
		$AddAttribute (root, "FMCE_Give", "integer", 0);
	return root;
end

function FMB_Decode (integer v, integer magic, integer lo, integer hi, integer dflt) is integer
declare
begin
	if (v >= magic + lo && v <= magic + hi)
		return v - magic;
	if (v >= lo && v <= hi)
		return v;
	return dflt;
end

function FMB_Entry () is integer
declare
	agent root;
	integer e;
begin
	root = $FMB_Root ();
	e = $FMB_Decode (root's "FMCE_Type", 7340032, 1, 499, 1);
	if ($FMB_Valid_Entry (e) == FALSE)
		e = 1;
	return e;
end

function FMB_Is_On () is boolean
declare
	agent root;
begin
	root = $FMB_Root ();
	if ($FMB_Decode (root's "FMCE_On", 7405568, 0, 1, 0) == 1)
		return TRUE;
	return FALSE;
end

function FMB_Count () is integer
declare
	agent root;
begin
	root = $FMB_Root ();
	return $FMB_Decode (root's "FMCE_Count", 7471104, 1, 10, 1);
end

