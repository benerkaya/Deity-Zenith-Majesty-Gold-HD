////////////////////////////////////////////////////////////////////////////////
// One monster at the flag: spawner = palace, spot = flag (the original game
// spawns from the palace at remote spots, e.g. Building_Deaths.gpl:852 map
// edge, epic_quest_scripts.gpl:2341 an Inn near a remote coordinate). If that
// fails, use the proven palace spawn and teleport.
function FM_Spawn_At (agent palace, string unitType, coordinate spot) is list
declare
	agent m, root;
	boolean flag4;
	list result, extra;
begin
	root = $FM_Root ();
	flag4 = root's "Quest_Flag_4";
	m = $SpawnUnit (palace, unitType, $RandomCoord (spot, 120), $GetUnitPlayerNumber (palace), "override");
	root's "Quest_Flag_4" = flag4;
	if ($IsValidGamePiece (m) == FALSE)
		begin
			result = $FM_Summon_One (palace, unitType);
			foreach m in result do
				begin
					m's "Coord_Home" = spot;
					$TeleportToPoint (m, 50000, spot);
				end
			return result;
		end
	$FM_Make_Friendly (m, palace, spot);
	result << m;
	if (unitType == "Liche_Queen" || unitType == "Witch_King")
		begin
			extra = $FM_Fix_Boss (m, palace, spot);
			result = $AddLists (result, extra);
		end
	return result;
end

function FM_Flag_Monsters (agent palace, integer e, coordinate spot)
declare
	integer i, n, made, alive;
	string unitType;
	list got;
begin
	if ($FM_Is_Hostile ())
		begin
			$FM_Flag_Hostile (palace, e, spot);
			return;
		end
	unitType = $ListMember ($FM_Type_List (), e);
	n = $FM_Count ();
	alive = $ListSize ($FM_List_Allies (palace));
	made = 0;
	i = 0;
	while (i < n) do
		begin
			if (alive + made < #FM_Max_Alive)
				begin
					got = $FM_Spawn_At (palace, unitType, spot);
					if ($ListSize (got) > 0)
						made = made + 1;
				end
			i = i + 1;
		end
	if (made == 0)
		begin
			if (alive >= #FM_Max_Alive)
				$FM_Say (palace, "IDTXT_FMX_CAP");
			else
				$FM_Say (palace, "IDTXT_FMX_FAIL");
			return;
		end
	if (made == 1)
		$FM_Say (palace, $ListMember ($FM_One_Keys (), e));
	else
		$FM_Say (palace, $ListMember ($FM_Many_Keys (), e));
	if (made < n)
		$FM_Say (palace, "IDTXT_FMX_PARTIAL");
end

// Player-owned building, first stage built ("maxhp", as Building_Births.gpl /
// epic_quest_scripts.gpl:2341 do). "clear" is NOT used (it deletes units under
// the footprint). Tries the flag spot, then 3 random spots nearby.
function FM_Flag_Building (agent palace, integer e, coordinate spot)
declare
	agent b;
	integer tries, owner;
	string bt;
	boolean dark, pal;
begin
	bt = $ListMember ($FM_Bld_List (), e - 200);
	// Guardhouse with faction Hostile / Red / Green: a Guardhouse of that side (Blue: below, unchanged)
	if (bt == "GuardHouse1")
		if ($FM_Is_Hostile ())
			begin
				$FM_HG_Flag_Guardhouse (palace, spot);
				return;
			end
	// every other building with faction Hostile / Red / Green: a building of that side (Blue: below, unchanged)
	if ($FM_Is_Hostile ())
		if ($FM_HB_Hostile (palace, e - 200))
			begin
				$FM_HB_Flag_Building (palace, e - 200, spot);
				return;
			end
	dark = FALSE;
	pal = FALSE;
	if (bt == "EvilPalace")
		dark = TRUE;
	if (bt == "Palace3")
		pal = TRUE;
	owner = $GetUnitPlayerNumber (palace);
	// the Dark Palace and the Palace follow the faction picker; other buildings are always yours
	if (dark || pal)
		begin
			if ($FM_Is_Hostile ())
				owner = $FM_Host_Player (palace);
		end
	else if ($FM_Is_Hostile ())
		$FM_Say (palace, "IDTXT_FMX_BHOST");
	b = $SpawnUnit (palace, bt, spot, owner, "maxhp");
	tries = 0;
	while ($IsValidGamePiece (b) == FALSE && tries < 3) do
		begin
			b = $SpawnUnit (palace, bt, $RandomCoord (spot, 100, 250), owner, "maxhp");
			tries = tries + 1;
		end
	if ($IsValidGamePiece (b) == FALSE)
		begin
			$FM_Say (palace, "IDTXT_FMX_BFAIL");
			return;
		end
	if (dark || pal)
		begin
			if (pal)
				$FM_ModPalace_Prep (b, owner);
			else
				$FM_DarkPalace_Prep (b, owner);
			if ($FM_Is_Hostile ())
				begin
					$FM_Fac_Team (palace, b);
					$FM_Say_Owner (palace);
					if (owner == #Monster_Player)
						begin
							if (pal)
								$FM_Say (palace, "IDTXT_FMX_PAL_H");
							else
								$FM_Say (palace, "IDTXT_FMX_DPAL_H");
						end
					else
						begin
							if (pal)
								$FM_Say (palace, "IDTXT_FMX_PAL_K");
							else
								$FM_Say (palace, "IDTXT_FMX_DPAL_K");
						end
				end
			else
				begin
					if (pal)
						$FM_Say (palace, "IDTXT_FMX_PAL_F");
					else
						$FM_Say (palace, "IDTXT_FMX_DPAL_F");
				end
			return;
		end
	$FM_Say (palace, $ListMember ($FM_Bld_Keys (), e - 200));
end


////////////////////////////////////////////////////////////////////////////////
// Per-flag thread, same pattern as the original explore_flag_poll (which also
// reads $locationof (thisagent) and ends with $deletegamepiece (thisagent)).
// The reward is refunded first: the original poll pays the reward out with
// $dropgoldinradius_samePlayer and then deletes the flag, so deleting a flag
// does not give the gold back by itself.
function FM_Flag_Poll (agent thisagent)
declare
	agent palace, dp;
	coordinate spot;
	integer e, reward;
begin
	if (thisagent's "gavereward" == TRUE)
		return;
	thisagent's "gavereward" = TRUE;
	palace = $FM_Palace ();
	spot = $LocationOf (thisagent);
	reward = $GetAttribute (thisagent, #ATTRIB_rewardcost);
	e = $FM_Entry ();
	if (reward > 0)
		$AdjustPlayerData (palace, "gold", reward);
	$DeleteGamePiece (thisagent);
	if ($IsValidGamePiece (palace) == FALSE)
		return;
	if (e > 400)
		$FM_Flag_Lair (palace, e, spot);
	else if (e > 200)
		$FM_Flag_Building (palace, e, spot);
	else if (e > 110)
		$FM_Flag_Heroes (palace, e, spot, $NullAgent ());
	else if (e > 106)
		$FM_Flag_Heroes (palace, 132, spot, $NullAgent ());
	else if (e > 103)
		$FM_Flag_Guards (palace, e - 3, spot, $NullAgent ());
	else if (e > 100)
		$FM_Flag_Henchmen (palace, e, spot);
	else
		begin
			// Explore flag next to a Deity Zenith Dark Palace = Attack flag on it
			dp = $FM_DP_Near (palace, spot);
			if ($IsValidGamePiece (dp))
				begin
					$FM_Say (palace, "IDTXT_FMX_DPAL_NEAR");
					$FM_Flag_Bodyguards (palace, e, dp);
				end
			else
				$FM_Flag_Monsters (palace, e, spot);
		end
end

function FM_Is_Human_Flag (agent flag) is boolean
declare
	agent palace;
begin
	palace = $FM_Palace ();
	if ($IsValidGamePiece (palace) == FALSE)
		return FALSE;
	if ($GetUnitPlayerNumber (flag) != $GetUnitPlayerNumber (palace))
		return FALSE;
	return TRUE;
end

// OVERRIDE (by name) of the original explore flag birth script
// (Flags.dat: Flag_Explore birthscript Explore_Flag_Birth; original body in
// DecisionTrees/Modules/check_rewards.gpl). When OFF, or for any other player's
// flag, it does exactly what the original does.
// Diagnostics (chat line, human player only):
//   ON  -> "DZ: summoning at your Explore flag..." every flag
//   OFF -> "DZ: Explore-flag hook OK, summon is OFF..." on the
//          first 2 Explore flags of a game (counter reset in GplKickoff)
function FMX_Hook_explore_flag_birth (agent thisagent)
declare
	agent root, palace;
begin
	root = $FM_Root ();
	if ($FM_Is_Human_Flag (thisagent))
		begin
			$FM_Ensure_Watch ();
			palace = $FM_Palace ();
			if ($FM_Is_On ())
				begin
					if ($FM_Is_Hostile ())
						$FM_Say (palace, "IDTXT_FMX_HOOK_ON_H");
					else
						$FM_Say (palace, "IDTXT_FMX_HOOK_ON");
					thisagent's "activeScript" = $FM_Flag_Poll;
					$NewThread (thisagent's "activeScript", 300, thisagent);
					return;
				end
			if (root's "FMCE_Note" < 2)
				begin
					root's "FMCE_Note" = root's "FMCE_Note" + 1;
					$FM_Say (palace, "IDTXT_FMX_HOOK_OFF");
				end
		end
	$NewThread (thisagent's "activeScript", #flag_Cycle, thisagent);
end

////////////////////////////////////////////////////////////////////////////////
// OVERRIDE (by name) of GplKickoff (GplAIRoot prototype, Misc_Data.dat
// "KickoffFunction GplKickoff"; run once by InitializeGpl after the map objects
// are loaded). The original body is EMPTY in both rulesets (LowLevel.gpl:211,
// mx_LowLevel.gpl:329), so nothing of the original game is lost. Creates the
// FMCE_* values at game start (so Cheat Engine can find them before any flag)
// and prints one chat line proving the mod's code is running.
function FMX_Hook_GplKickoff ()
declare
	agent root, palace;
begin
	root = $FM_Root ();
	root's "FMCE_Note" = 0;
	palace = $FM_Palace ();
	if ($IsValidGamePiece (palace) == FALSE)
		return;
	$FM_Ensure_Watch ();
	if ($FM_Is_On ())
		begin
			$FM_Say (palace, $FM_Entry_Key ($FM_Entry ()));
			$FM_Say_Faction (palace);
		end
	else
		$FM_Say (palace, "IDTXT_FMX_HELLO");
end

////////////////////////////////////////////////////////////////////////////////
// No-Cheat-Engine fallback: a DEFEND flag placed on your own Palace steps the
// selection: OFF -> entry 1 (ON) -> 2 -> ... -> last -> OFF. The flag is then
// removed (reward refunded). Flag_Guard birthscript is RewardFlag_Birth, which
// is EMPTY in both original rulesets, so other defend flags are unchanged.
function FM_Guard_Poll (agent thisagent)
declare
	agent palace, root;
	integer e, reward;
begin
	if (thisagent's "gavereward" == TRUE)
		return;
	thisagent's "gavereward" = TRUE;
	palace = $FM_Palace ();
	root = $FM_Root ();
	reward = $GetAttribute (thisagent, #ATTRIB_rewardcost);
	if (reward > 0)
		$AdjustPlayerData (palace, "gold", reward);
	$DeleteGamePiece (thisagent);

	e = $FM_Entry ();
	if ($FM_Is_On () == FALSE)
		e = 1;
	else
		begin
			e = $FM_Next_Entry (e);
		end
	if (e == 0)
		begin
			root's "FMCE_On" = 7405568;
			$FM_Say (palace, "IDTXT_FMX_OFF");
			return;
		end
	root's "FMCE_Type" = 7340032 + e;
	root's "FMCE_On" = 7405568 + 1;
	$FM_Say (palace, $FM_Entry_Key (e));
	$FM_Say_Faction (palace);
end

function FM_Entry_Key (integer e) is string
declare
begin
	if (e > 400)
		return $ListMember ($FM_ESel_Keys (), #FM_Type_Count + 7 + 21 + 39 + e - 400);
	if (e > 200)
		return $ListMember ($FM_ESel_Keys (), #FM_Type_Count + 7 + 21 + e - 200);
	if (e > 110)
		return $ListMember ($FM_ESel_Keys (), #FM_Type_Count + 7 + e - 110);
	if (e > 100)
		return $ListMember ($FM_ESel_Keys (), #FM_Type_Count + e - 100);
	return $ListMember ($FM_ESel_Keys (), e);
end

function FMX_Hook_RewardFlag_Birth (agent thisagent)
declare
	agent target, palace;
begin
	if ($FM_Is_Human_Flag (thisagent) == FALSE)
		return;
	$FM_Ensure_Watch ();
	if (thisagent's "title" != "Flag_Guard")
		return;
	palace = $FM_Palace ();
	target = $AgentNumber ($GetAttribute (thisagent, #ATTRIB_targetID));
	if (target == palace)
		begin
			thisagent's "activeScript" = $FM_Guard_Poll;
			$NewThread (thisagent's "activeScript", 300, thisagent);
		end
end

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// ===== guards, enemy lairs, faction picker =====
// Entry numbers (FMCE_Type = 7340032 + entry):
//   1..45 monsters, 101..103 guards, 201..239 buildings, 401..435 lairs
// FMCE_Faction = 7536640 + 0/1/2/3 (Friendly default / Hostile / Red / Green, see the Red / Green block). Hostile applies to
// monsters and lairs (owned by the monster player, #Monster_Player = 7, exactly like
// the game's own monster waves, e.g. mx_LowLevel.gpl cheat_wave_*). Buildings and
// guards are always yours: they need your Palace (count_building / GetTruePalace,
// guard homes) and the monster player has none.
function FM_Is_Hostile () is boolean
declare
	agent root;
begin
	root = $FM_Root ();
	if ($FM_Decode (root's "FMCE_Faction", 7536640, 0, 3, 0) > 0)
		return TRUE;
	return FALSE;
end

function FM_Say_Faction (agent palace)
declare
begin
	if ($FM_Fac () == 1)
		$FM_Say (palace, "IDTXT_FMX_FACTION_H");
	else if ($FM_Fac () == 2)
		$FM_Say (palace, "IDTXT_FMX_FACTION_R");
	else if ($FM_Fac () == 3)
		$FM_Say (palace, "IDTXT_FMX_FACTION_G");
	else
		$FM_Say (palace, "IDTXT_FMX_FACTION_F");
end

function FM_Valid_Entry (integer e) is boolean
declare
begin
	if (e >= 1 && e <= #FM_Type_Count)
		return TRUE;
	if (e > 100 && e <= 107)
		return TRUE;
	if (e > 110 && e <= 131)
		return TRUE;
	if (e > 200 && e <= 239)
		return TRUE;
	if (e > 400 && e <= 435)
		return TRUE;
	return FALSE;
end

// Entry order: monsters, guards, buildings, lairs, OFF (0)
function FM_Next_Entry (integer e) is integer
declare
	integer n;
begin
	n = e + 1;
	if (n > #FM_Type_Count && n <= 100)
		n = 100 + 1;
	if (n > 107 && n <= 110)
		n = 110 + 1;
	if (n > 131 && n <= 200)
		n = 200 + 1;
	if (n > 239 && n <= 400)
		n = 400 + 1;
	if (n > 435)
		n = 0;
	return n;
end

