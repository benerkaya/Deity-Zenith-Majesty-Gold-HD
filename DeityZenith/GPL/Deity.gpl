////////////////////////////////////////////////////////////////////////////////
// SpawnUnit with all Quest_Flag_* booleans of GplAIRoot saved and restored: some
// birth scripts write them (tomb_birth: Quest_Flag_2, Url_Shekk_Birth: Quest_Flag_4)
// for quest victory bookkeeping. An earlier version only restored Quest_Flag_4.
function FMB_Spawn_Safe (agent palace, string unitType, coordinate spot, integer player, string mode) is agent
declare
	agent root, m;
	boolean q1, q2, q3, q4, q5, q6, q7, q8, q9;
begin
	$FMB_Q_Save (unitType);
	root = $FMB_Root ();
	q1 = root's "Quest_Flag_1";
	q2 = root's "Quest_Flag_2";
	q3 = root's "Quest_Flag_3";
	q4 = root's "Quest_Flag_4";
	q5 = root's "Quest_Flag_5";
	q6 = root's "Quest_Flag_6";
	q7 = root's "Quest_Flag_7";
	q8 = root's "Quest_Flag_8";
	q9 = root's "Quest_Flag_9";
	m = $SpawnUnit (palace, unitType, spot, player, mode);
	root's "Quest_Flag_1" = q1;
	root's "Quest_Flag_2" = q2;
	root's "Quest_Flag_3" = q3;
	root's "Quest_Flag_4" = q4;
	root's "Quest_Flag_5" = q5;
	root's "Quest_Flag_6" = q6;
	root's "Quest_Flag_7" = q7;
	root's "Quest_Flag_8" = q8;
	root's "Quest_Flag_9" = q9;
	return m;
end

////////////////////////////////////////////////////////////////////////////////
// HOSTILE monsters: owned by the monster player, the game's own AI. Sleepers are
// woken up (same as the friendly path) and boss death scripts are replaced by the
// plain Monster_Gravestone (Vendral_Death would declare quest victory, etc.).
function FMB_Hostile_Prep (agent m)
declare
begin
	if ($isdead (m))
		return;
	if (m's "title" == "Dragon" || m's "title" == "IceDragon" || m's "title" == "Ratman" || m's "title" == "Vendral")
		if ($IsRunning (m's "SleeperScript"))
			$KillThread (m's "SleeperScript");
	m's "IGDeathScript" = $Monster_Gravestone;
	// Guardian_Birth took the spawner (your Palace) as home: guard the flag spot instead
	if (m's "title" == "Strangleweed" || m's "title" == "Daemonwood" || m's "title" == "Dryad")
		m's "Coord_Home" = $LocationOf (m);
	// Skeleton_Birth: a skeleton spawned by a building (your Palace) gets Monster_follow with
	// Leader = that Palace (it follows it and attacks its target or the Palace itself): give a
	// Hostile summon the normal monster AI instead (data scripts: wandering)
	if (m's "title" == "Skeleton" && m's "BasicScript" == $Monster_follow)
		begin
			m's "ActiveScript" = $wandering;
			m's "BackScript" = $wandering;
			m's "BasicScript" = $wandering;
			m's "StartingScript" = $wandering;
			m's "Leader" = $NullAgent ();
			m's "target" = $NullAgent ();
		end
end

function FMB_Flag_Hostile (agent palace, integer e, coordinate spot)
declare
	integer i, n, made, tries;
	string unitType;
	agent m;
	integer hp;
begin
	hp = $FMB_Host_Player (palace);
	unitType = $ListMember ($FMB_Type_List (), e);
	n = $FMB_Count ();
	made = 0;
	i = 0;
	while (i < n) do
		begin
			m = $FMB_Spawn_Safe (palace, unitType, $RandomCoord (spot, 120), hp, "override");
			tries = 0;
			while ($IsValidGamePiece (m) == FALSE && tries < 2) do
				begin
					m = $FMB_Spawn_Safe (palace, unitType, $RandomCoord (spot, 100, 250), hp, "override");
					tries = tries + 1;
				end
			if ($IsValidGamePiece (m))
				begin
					$FMB_Hostile_Mark (m);
					$FMB_Fac_Team (palace, m);
					made = made + 1;
				end
			i = i + 1;
		end
	if (made == 0)
		begin
			$FMB_Say (palace, "IDTXT_FMB_HFAIL");
			return;
		end
	$FMB_Say_Owner (palace);
	if (made == 1)
		$FMB_Say (palace, $ListMember ($FMB_Host_Keys (), e));
	else
		$FMB_Say (palace, $ListMember ($FMB_HMany_Keys (), e));
	if (made < n)
		$FMB_Say (palace, "IDTXT_FMB_HPARTIAL");
end

////////////////////////////////////////////////////////////////////////////////
// GUARDS (always yours). Spawner = palace, so Palace_Guard_Birth makes the Palace
// its home ($Parent) and registers it there (Guards list + Num_Guards), exactly
// like a palace-spawned guard. City_Guard_Birth takes the first guardhouse in the
// palace's "Waiting_Guardhouses" list as home (that guardhouse simply gets its
// guard). With NO waiting guardhouse the guard has no home and the original AI
// (Guard_Voyage_Home -> Guard_Goto_Palace) walks it to the palace and DELETES it,
// so here it gets a home: the guardhouse of yours nearest to the flag, else the
// palace, registered the same way the birth scripts do (Guard_Death undoes it).
function FMB_Spawn_Guard (agent palace, string gt, coordinate spot, agent h) is agent
declare
	agent g, p;
begin
	// Original City_Guard_Birth runs a moment after the spawn and reads its home from
	// $GetPalace (= the player's palace slot)'s Waiting_Guardhouses, as after City_Guard_Spawner.
	p = $GetPalace (palace);
	if ($IsDead (p))
		p = palace;
	if (gt != "Palace_Guard")
		p's "Waiting_Guardhouses" << h;
	g = $FMB_Spawn_Safe (palace, gt, $RandomCoord (spot, 120), $GetUnitPlayerNumber (palace), "override");
	if ($IsValidGamePiece (g) == FALSE)
		g = $FMB_Spawn_Safe (palace, gt, $RandomCoord (spot, 100, 250), $GetUnitPlayerNumber (palace), "override");
	if ($IsValidGamePiece (g) == FALSE)
		begin
			if (gt != "Palace_Guard")
				if ($AgentInList (h, p's "Waiting_Guardhouses"))
					p's "Waiting_Guardhouses" -= h;
			return g;
		end
	// checked again at step 2 (FMB_Guard_Finish)
	g's "Task_Number" = 7798003;
	return g;
end

function FMB_Flag_Guards (agent palace, integer e, coordinate spot, agent target)
declare
	integer i, n, made, mode;
	string gt;
	agent g, h;
begin
	// Hostile / Red / Green: guards of that side (Blue: below, unchanged)
	if ($FMB_Is_Hostile ())
		begin
			$FMB_HG_Flag_Guards (palace, e, spot, target);
			return;
		end
	gt = $ListMember ($FMB_Guard_List (), e - 100);
	n = $FMB_Count ();
	if ($FMB_Is_Hostile ())
		$FMB_Say (palace, "IDTXT_FMB_GHOST");
	// Attack flag: same side rule as the other summons (guards are always yours)
	mode = 0;
	if ($IsDead (target) == FALSE)
		begin
			mode = 2;
			if ($GetUnitPlayerNumber (target) == $GetUnitPlayerNumber (palace))
				mode = 1;
		end
	h = $FMB_Guard_Home (palace, spot, target, mode);
	made = 0;
	i = 0;
	while (i < n) do
		begin
			g = $FMB_Spawn_Guard (palace, gt, spot, h);
			if ($IsValidGamePiece (g))
				begin
					if (mode == 2)
						$FMB_Guard_Attack (g, target);
					made = made + 1;
				end
			i = i + 1;
		end
	if (made == 0)
		begin
			$FMB_Say (palace, "IDTXT_FMB_GFAIL");
			return;
		end
	$FMB_Say (palace, $ListMember ($FMB_Guard_Keys (), e - 100));
	if (mode == 2)
		$FMB_Say (palace, "IDTXT_FMB_GMODE_ATTACK");
	if (mode == 1)
		$FMB_Say (palace, "IDTXT_FMB_GMODE_GUARD");
	if (made < n)
		$FMB_Say (palace, "IDTXT_FMB_PARTIAL");
end

////////////////////////////////////////////////////////////////////////////////
// LAIRS. Spawned the way the game's quest scripts place lairs at run time
// ($SpawnUnit (..., lair, coord, #Monster_Player, "maxhp"), Quests_3.gpl
// GoblinFortress / Spire spawns, Quests_1.gpl Snake pits); the data birthscript
// (lair_birth etc.) then starts the lair's Spawn_Function and Lair_Brains threads.
// Hostile: owned by the monster player. Friendly: owned by you; a watcher thread
// (AddAttribute "function" + NewThread, as in the SDK SpecialItemsExample) turns
// every monster the lair spawns into a friendly ally (FMB_Make_Friendly), and its
// death script is wrapped so the lair's death spawn (Special_Spawn_Type, Witch
// King tower spiders, ...) joins you too. Limit #FMB_Max_Alive applies: spawns
// above it are removed.
function FMB_Lair_Sweep (agent lair, agent palace)
declare
	list units, ls, extra, mine;
	agent u, l;
	integer alive;
	coordinate anchor;
begin
	anchor = $LocationOf (lair);
	alive = $ListSize ($FMB_List_Allies (palace));
	$ListObjects (lair, "monster", 1200, units, #NoHiddenMap, #MyPlayer);
	foreach u in units do
		begin
			if ($isdead (u) == FALSE)
				begin
					if (alive >= #FMB_Max_Alive)
						$DeleteGamePiece (u);
					else
						begin
							$FMB_Make_Friendly (u, palace, anchor);
							alive = alive + 1;
							if (u's "title" == "Liche_Queen" || u's "title" == "Witch_King")
								begin
									extra = $FMB_Fix_Boss (u, palace, anchor);
									alive = alive + $ListSize (extra);
								end
						end
				end
		end
	// lair children a birth script changed after the sweep that set them up (Type stays "Hero")
	$ListObjects (lair, "hero", 1200, mine, #NoHiddenMap, #MyPlayer);
	foreach u in mine do
		begin
			if ($isdead (u) == FALSE)
				if ($HasAttribute ("SleeperScript", u))
					if (u's "Target_Item" == 9170)
						if ($FMB_Friendly_Bad (u))
							$FMB_Refriend (u, palace, $NullAgent (), anchor, FALSE);
		end
	if ($isdead (lair))
		return;
	// copies made by Autospawn_Lair (Rats' Nest / Snake Pit) are new lairs of yours
	$ListObjects (lair, "lair", 1500, ls, #NoHiddenMap, #MyPlayer);
	foreach l in ls do
		begin
			if ($isdead (l) == FALSE)
				if (l's "Spawn_Function" == $Spawn)
					$FMB_Lair_Adopt (l, palace);
		end
end

function FMB_Lair_Watch (agent thisagent)
declare
	agent palace;
begin
	if ($isdead (thisagent))
		return;
	palace = $FMB_Palace ();
	if ($IsValidGamePiece (palace) == FALSE)
		return;
	if ($GetUnitPlayerNumber (thisagent) != $GetUnitPlayerNumber (palace))
		return;
	$FMB_Lair_Sweep (thisagent, palace);
end

function FMB_Lair_Death (agent thisagent)
declare
	agent palace;
begin
	if ($HasAttribute ("FM_Orig_Death", thisagent))
		(thisagent's "FM_Orig_Death") (thisagent);
	else
		$lair_death (thisagent);
	palace = $FMB_Palace ();
	if ($IsValidGamePiece (palace))
		$FMB_Lair_Sweep (thisagent, palace);
end

function FMB_Lair_Adopt (agent b, agent palace)
declare
begin
	if ($isdead (b))
		return;
	if (b's "Spawn_Function" == $Spawn)
		b's "Spawn_Function" = $FMB_Lair_Spawn;
	if (b's "activeScript" == $Lair_Brains)
		b's "activeScript" = $FMB_Lair_Brain;
	$FMB_Lair_Sweep (b, palace);
end

function FMB_Flag_Lair (agent palace, integer e, coordinate spot)
declare
	agent b;
	integer tries, owner;
	string lt, t;
	boolean hostile;
begin
	lt = $ListMember ($FMB_Lair_List (), e - 400);
	hostile = $FMB_Is_Hostile ();
	if (hostile)
		owner = $FMB_Host_Player (palace);
	else
		owner = $GetUnitPlayerNumber (palace);
	b = $FMB_Spawn_Safe (palace, lt, spot, owner, "maxhp");
	tries = 0;
	while ($IsValidGamePiece (b) == FALSE && tries < 3) do
		begin
			b = $FMB_Spawn_Safe (palace, lt, $RandomCoord (spot, 100, 250), owner, "maxhp");
			tries = tries + 1;
		end
	if ($IsValidGamePiece (b) == FALSE)
		begin
			$FMB_Say (palace, "IDTXT_FMB_LFAIL");
			return;
		end
	// quest-only death scripts (Spire_Death declares victory when no spire is left,
	// Hidden_Ring/Sword quest items and flags, Slave_Pits / Sphere quest waves)
	t = b's "title";
	if (t == "SpireOfDeath" || t == "Hidden_Ring_Site" || t == "Hidden_Sword_Site" || t == "Slave_Pits" || t == "Brashnards_Sphere")
		b's "IGdeathScript" = $Lair_death;
	// Broken_sewer_Birth moves the lair to the monster player: force the chosen owner
	if ($GetUnitPlayerNumber (b) != owner)
		$SetUnitPlayerNumber (b, owner);
	if (hostile)
		begin
			$FMB_Fac_Team (palace, b);
			// Sewer_Spawn always spawns for #Monster_Player: Red / Green sewers use the generic Spawn
			if (owner != #Monster_Player && t == "Sewers")
				b's "Spawn_Function" = $Spawn;
			$FMB_Say_Owner (palace);
			$FMB_Say (palace, $ListMember ($FMB_LairH_Keys (), e - 400));
			return;
		end
	if (t == "ElvenHideout")
		begin
			b's "activeScript" = $FMB_Hideout_Friendly;
			$FMB_Say (palace, $ListMember ($FMB_LairF_Keys (), e - 400));
			return;
		end
	// Sewer_Spawn always spawns for #Monster_Player: use the generic lair Spawn
	if (t == "Sewers")
		b's "Spawn_Function" = $Spawn;
	$FMB_Lair_Adopt (b, palace);
	$FMB_Say (palace, $ListMember ($FMB_LairF_Keys (), e - 400));
end

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// ===== in-game status lines for the Cheat Engine hotkeys =====
// A thread on your Palace (AddAttribute "function" + NewThread, as in the SDK
// SpecialItemsExample) reads the FMCE_* values every 0.7 s and prints two chat
// lines when any of them changed (CE hotkeys, CE table):
//   "[FM] Selected: <entry>"  and  "[FM] Summon ON/OFF | Friendly/Hostile | n per flag"
// FMCE_Ping (+1 by the CE scan hotkey) prints "Cheat Engine hotkeys connected".
// FMCE_Rules tells the CE hotkeys which list to use (1 Expansion, 2 Original).
// No watcher thread in Original (it needed a function attribute added to the Palace);
// the selection lines are checked whenever a flag of yours is placed.
function FMB_Ensure_Watch ()
declare
	agent palace;
begin
	palace = $FMB_Palace ();
	if ($IsValidGamePiece (palace) == FALSE)
		return;
	$FMB_Value_Check (palace);
	$DZA_Ensure_B (palace);
end

function FMB_Say_Status (agent palace)
declare
begin
	return;
end

function FMB_Value_Watch (agent thisagent)
declare
begin
	if ($isdead (thisagent))
		return;
	// the guard on GplAIRoot prints the status lines when it runs
	if ($FMB_Guard_Running ())
		return;
	$FMB_Value_Check (thisagent);
end

function FMB_Value_Check (agent thisagent)
declare
	agent root;
	integer sig, p, o, f;
begin
	root = $FMB_Root ();
	if ($HasAttribute ("FMW_Sig", thisagent) == FALSE)
		$AddAttribute (thisagent, "FMW_Sig", "integer", -1);
	if ($HasAttribute ("FMW_Ping", thisagent) == FALSE)
		$AddAttribute (thisagent, "FMW_Ping", "integer", -1);
	o = 0;
	if ($FMB_Is_On ())
		o = 1;
	f = $FMB_Fac ();
	sig = $FMB_Entry () + 1000 * $FMB_Count () + 100000 * o + 1000000 * f;
	p = $FMB_Decode (root's "FMCE_Ping", 7602176, 0, 99, 0);
	if (thisagent's "FMW_Sig" == -1)
		begin
			thisagent's "FMW_Sig" = sig;
			thisagent's "FMW_Ping" = p;
			return;
		end
	if (p != thisagent's "FMW_Ping")
		begin
			thisagent's "FMW_Ping" = p;
			thisagent's "FMW_Sig" = sig;
			$FMB_Say (thisagent, "IDTXT_FMB_W_PING");
			$FMB_Say_Status (thisagent);
			return;
		end
	if (sig != thisagent's "FMW_Sig")
		begin
			thisagent's "FMW_Sig" = sig;
			$FMB_Say_Status (thisagent);
		end
end

function FMB_W_Key (integer e) is string
declare
begin
	if (e > 400)
		return $ListMember ($FMB_W_Keys (), #FMB_Type_Count + 7 + 20 + 32 + e - 400);
	if (e > 200)
		return $ListMember ($FMB_W_Keys (), #FMB_Type_Count + 7 + 20 + e - 200);
	if (e > 110)
		return $ListMember ($FMB_W_Keys (), #FMB_Type_Count + 7 + e - 110);
	if (e > 100)
		return $ListMember ($FMB_W_Keys (), #FMB_Type_Count + e - 100);
	return $ListMember ($FMB_W_Keys (), e);
end

