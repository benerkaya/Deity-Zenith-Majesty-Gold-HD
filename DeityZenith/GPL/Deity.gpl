	L << "IDTXT_FMX_BGA_38";
	L << "IDTXT_FMX_BGA_39";
	L << "IDTXT_FMX_BGA_40";
	L << "IDTXT_FMX_BGA_41";
	L << "IDTXT_FMX_BGA_42";
	L << "IDTXT_FMX_BGA_43";
	L << "IDTXT_FMX_BGA_44";
	L << "IDTXT_FMX_BGA_45";
	return L;
end

////////////////////////////////////////////////////////////////////////////////
// ===== factions Red / Green =====
// FMCE_Faction = 7536640 + 0 Friendly (default) / 1 Hostile (monster player 7)
//                         / 2 Red (#Player_2 = player number 1) / 3 Green (#Player_3 = 2).
// Red / Green are the rival-kingdom player slots of the campaign quests (Magic Ring,
// Urban Renewal "red guilds", Siege: $GetPlayerTwoPalace = #Player_2; Clash of Empires:
// goblins #Player_2, rats #Player_3, owning lairs and monsters WITHOUT a palace).
// Monsters and lairs are spawned for that player (like Quests_1.gpl Clash_Empires
// SpawnUnit (..., #Player_2/3, ...)); the normal monster AI then fights everything
// #NotMyTeam, i.e. whoever that player is at war with. First use per game:
//  - player present on the map (palace, building, lair, hero or monster): nothing is
//    changed, the summons share its friends and enemies (FM_FacT_x = 1)
//  - player absent (Freestyle, most quests): like Clash_Empires, the player gets its own
//    team ($SetPlayerTeamNumber (unit, $NewTeamNumber ())) = at war with everyone
//    (FM_FacT_x = 3 pending until the first unit exists, then 2).
// Buildings and guards stay yours (they need a palace).
function FM_Fac () is integer
declare
	agent root;
begin
	root = $FM_Root ();
	return $FM_Decode (root's "FMCE_Faction", 7536640, 0, 3, 0);
end

function FM_Fac_Present (agent palace, integer p) is boolean
declare
	list l, all;
	agent a;
	boolean found;
begin
	found = FALSE;
	all = $ListPalaces ();
	foreach a in all do
		begin
			if ($GetUnitPlayerNumber (a) == p)
				found = TRUE;
		end
	if (found)
		return TRUE;
	$ListObjects (palace, "building", -1, l, #NotMyPlayer, #NoHiddenMap);
	all = $AddLists (all, l);
	$ListObjects (palace, "Lair", -1, l, #NotMyPlayer, #NoHiddenMap);
	all = $AddLists (all, l);
	$ListObjects (palace, "hero", -1, l, #NotMyPlayer, #NoHiddenMap);
	all = $AddLists (all, l);
	$ListObjects (palace, "monster", -1, l, #NotMyPlayer, #NoHiddenMap);
	all = $AddLists (all, l);
	foreach a in all do
		begin
			if ($GetUnitPlayerNumber (a) == p)
				found = TRUE;
		end
	return found;
end

// player number for non-friendly summons; decides Red / Green presence once per game
function FM_Host_Player (agent palace) is integer
declare
	agent root;
	integer f;
begin
	f = $FM_Fac ();
	if (f < 2)
		return #Monster_Player;
	root = $FM_Root ();
	if (f == 2)
		begin
			if ($HasAttribute ("FM_FacT_2", root) == FALSE)
				$AddAttribute (root, "FM_FacT_2", "integer", 0);
			if (root's "FM_FacT_2" == 1 || root's "FM_FacT_2" == 2)
				return #Player_2;
			if ($FM_Fac_Present (palace, #Player_2))
				begin
					root's "FM_FacT_2" = 1;
					$FM_Say (palace, "IDTXT_FMX_FACIN_2");
					return #Player_2;
				end
			root's "FM_FacT_2" = 4;
			$FM_Say (palace, "IDTXT_FMX_FACNO_2");
			return #Monster_Player;
		end
	if ($HasAttribute ("FM_FacT_3", root) == FALSE)
		$AddAttribute (root, "FM_FacT_3", "integer", 0);
	if (root's "FM_FacT_3" == 1 || root's "FM_FacT_3" == 2)
		return #Player_3;
	if ($FM_Fac_Present (palace, #Player_3))
		begin
			root's "FM_FacT_3" = 1;
			$FM_Say (palace, "IDTXT_FMX_FACIN_3");
			return #Player_3;
		end
	root's "FM_FacT_3" = 4;
	$FM_Say (palace, "IDTXT_FMX_FACNO_3");
	return #Monster_Player;
end

// after the first Red / Green unit exists: own team if the player was absent
function FM_Fac_Team (agent palace, agent u)
declare
	agent root;
	integer f;
begin
	f = $FM_Fac ();
	if (f < 2)
		return;
	if ($IsValidGamePiece (u) == FALSE)
		return;
	root = $FM_Root ();
	if (f == 2)
		begin
			if ($HasAttribute ("FM_FacT_2", root))
				if (root's "FM_FacT_2" == 3)
					begin
						$SetPlayerTeamNumber (u, $NewTeamNumber ());
						root's "FM_FacT_2" = 2;
						$FM_Say (palace, "IDTXT_FMX_FACNEW_2");
					end
			return;
		end
	if ($HasAttribute ("FM_FacT_3", root))
		if (root's "FM_FacT_3" == 3)
			begin
				$SetPlayerTeamNumber (u, $NewTeamNumber ());
				root's "FM_FacT_3" = 2;
				$FM_Say (palace, "IDTXT_FMX_FACNEW_3");
			end
end

// owner line only when Red / Green is really used (FM_Host_Player ran before)
function FM_Say_Owner (agent palace)
declare
	integer f;
	agent root;
begin
	f = $FM_Fac ();
	root = $FM_Root ();
	if (f == 2)
		begin
			if ($HasAttribute ("FM_FacT_2", root))
				if (root's "FM_FacT_2" == 1 || root's "FM_FacT_2" == 2)
					$FM_Say (palace, "IDTXT_FMX_OWNER_2");
		end
	else if (f == 3)
		begin
			if ($HasAttribute ("FM_FacT_3", root))
				if (root's "FM_FacT_3" == 1 || root's "FM_FacT_3" == 2)
					$FM_Say (palace, "IDTXT_FMX_OWNER_3");
		end
end

////////////////////////////////////////////////////////////////////////////////
// ===== Dark Palace (EvilPalace) spawned by the mod =====
// Stock Palace_Death (mx_Building_Deaths.gpl:173) calls $declareloss when the owner has no
// Outpost: that is what ends the game. Defeat is GPL-side: the stock Outpost path skips
// $declareloss and the game goes on. Our copy gets its own death script (rubble, no loss,
// no player cleanup) and a non-"Palace" title, so $GetTruePalace / building births /
// peasants' build queue keep using the real Palace. The campaign's own Dark Palace is not
// touched (only the agent we spawn is changed).
function FM_DarkPalace_Death (agent thisagent)
declare
	list l;
	agent u;
begin
	thisagent's "type" = "Dead";
	// a palace of another side (never yours: #Player_1, as FM_Palace): its guards are released
	if ($GetUnitPlayerNumber (thisagent) != #Player_1)
		$FM_HG_Release (thisagent);
	l = $GetBuildingContents (thisagent);
	foreach u in l do
		begin
			if ($IsDead (u) == FALSE)
				$Exit_Building (u, thisagent);
		end
	$performaction (thisagent, "Become_Rubble", thisagent);
	$deleteagent (thisagent);
end

function FM_DarkPalace_Idle (agent thisagent)
declare
begin
end

function FM_DarkPalace_Prep (agent b, integer owner)
declare
begin
	b's "IGdeathScript" = $FM_DarkPalace_Death;
	b's "title" = "Deity_DarkPalace";
	// palace_revenue would pay a second palace income
	if ($IsRunning (b's "activeScript"))
		$KillThread (b's "activeScript");
	b's "activeScript" = $FM_DarkPalace_Idle;
	// monsters get no peasants / tax collectors
	if (owner == #Monster_Player)
		begin
			if ($IsRunning (b's "Tax_spawn"))
				$KillThread (b's "Tax_spawn");
			if ($IsRunning (b's "peasant_spawn"))
				$KillThread (b's "peasant_spawn");
			b's "Tax_spawn" = $FM_DarkPalace_Idle;
			b's "peasant_spawn" = $FM_DarkPalace_Idle;
		end
end

// A Dark Palace made by Deity Zenith (title "Deity_DarkPalace") within 300 of the spot, else null.
// $ListObjects (palace, "building", -1, list) without filters = buildings of every player
// (as $count_building in mx_LowLevel.gpl).
// A Dark Palace or Palace made by Deity Zenith within 300 of the spot, else null.
// $ListObjects (palace, "building", -1, list) without filters = buildings of every player.
function FM_DP_Near (agent palace, coordinate spot) is agent
declare
	list l;
	agent b, best;
	integer d, bd;
begin
	best = $NullAgent ();
	bd = 301;
	$ListObjects (palace, "building", -1, l);
	foreach b in l do
		begin
			if ($FM_Is_Mod_Palace (b))
				if ($IsDead (b) == FALSE)
					begin
						d = $DistanceBetweenCoords ($LocationOf (b), spot);
						if (d < bd)
							begin
								bd = d;
								best = b;
							end
					end
		end
	return best;
end

////////////////////////////////////////////////////////////////////////////////
// ===== Palace (Palace3) spawned by the mod =====
// Same death script as the mod's Dark Palace (no $declareloss, no player cleanup; the stock
// Palace_Death of BOTH rulesets declares the loss), title "Deity_Palace" (so $GetTruePalace,
// title checks of peasants / tax collectors / building births / Building_Guard / quest
// scripts don't see a palace), and for every owner: no palace income, no tax collectors,
// no peasants, no palace guards (Palace_Birth started palace_revenue and scheduled
// Guard_Spawn_Function / Tax_spawn / peasant_spawn).
function FM_ModPalace_Prep (agent b, integer owner)
declare
begin
	b's "IGdeathScript" = $FM_DarkPalace_Death;
	b's "title" = "Deity_Palace";
	if ($IsRunning (b's "activeScript"))
		$KillThread (b's "activeScript");
	b's "activeScript" = $FM_DarkPalace_Idle;
	if ($IsRunning (b's "Tax_spawn"))
		$KillThread (b's "Tax_spawn");
	if ($IsRunning (b's "peasant_spawn"))
		$KillThread (b's "peasant_spawn");
	if ($IsRunning (b's "Guard_Spawn_Function"))
		$KillThread (b's "Guard_Spawn_Function");
	b's "Tax_spawn" = $FM_DarkPalace_Idle;
	b's "peasant_spawn" = $FM_DarkPalace_Idle;
	b's "Guard_Spawn_Function" = $FM_DarkPalace_Idle;
end

function FM_Is_Mod_Palace (agent b) is boolean
declare
begin
	if ($IsValidGamePiece (b) == FALSE)
		return FALSE;
	if (b's "title" == "Deity_Palace" || b's "title" == "Deity_DarkPalace")
		return TRUE;
	return FALSE;
end

// A player's palace slot (engine; $ListPalaces / $GetPalace) is filled lazily with the
// player's first palace-family unit when it is empty, and the engine's game-start scan
// (after InitializeGpl, exe 0x428875) takes the last palace-family unit per player. If a slot
// ever holds a mod palace while that player still has a real one (title "Palace"),
// it is set back with $SetPalace (as the stock Outpost code in Palace_Death does).
function FM_Fix_Slot (agent p) is agent
declare
	list l;
	agent b;
begin
	if ($FM_Is_Mod_Palace (p) == FALSE)
		return p;
	$ListObjects (p, "building", -1, l, #CheckTitles, "Palace", #MyPlayer);
	foreach b in l do
		begin
			if ($IsDead (b) == FALSE)
				if (b's "title" == "Palace")
					begin
						$SetPalace (b, $GetUnitPlayerNumber (b));
						return b;
					end
		end
	return p;
end

////////////////////////////////////////////////////////////////////////////////
// ===== Heroes: entries 111.., after the guards =====
// Blue (faction 0): spawned by your Palace, owned by you - the way the game's own scripts give the
// player heroes (epic_quest_scripts.gpl:920/2314, Random_Events.gpl:261 "Veteran heroes"). hero_birth
// sees the Palace as parent and leaves "home" EMPTY ("a real, genuine palace ... doesn't have hero
// slots", mx_Hero_Births.gpl:196 / Hero_Births.gpl:179): no guild; go_home / defend_home / flee /
// Healer reborn all skip an empty home. Normal hero AI: explores, takes bounties, levels up.
// No charm icon, no Control_Monster set-up: Type stays "hero", so no Deity Zenith loop / lair sweep /
// post-birth check touches it (they only list Type "monster" units, "Controlled" heroes or units
// with the monster prototype's Target_Item / SleeperScript).
// Hostile / Red / Green: the game's own hostile-hero set-up (hero_birth, Fertile Plain monster-player
// heroes): owner = that side, Type "monster", EnemyType "hero", raider AI, monster_eval_enemies,
// Raider_respond. Your heroes and guards hunt Type "monster" units in both rulesets.
// Attack flag: same side comparison as the monster bodyguards (owner of the summons vs owner of the
// target): other side -> they attack it (heroes: attack_object, hostile heroes: raider with that
// target); same side -> they only appear next to it.
// Hooligan (Wizard's Curse henchman, monster prototype, Type "Hooligan"): Blue = wanders around the
// flag (its own hooligan_basic); Hostile = the quest's book thief (Hooligan_birth Quest_Flag_3
// branch): Guardian AI, Type Monster, level 10, 40 HP, its 4 spells. Quest_Flag_3 is kept FALSE for
// its birth because that branch also gives YOUR Palace a new team.
function FM_Hero_List () is list
declare
	list L;
begin
	L << "Warrior";
	L << "Ranger";
	L << "Rogue";
	L << "Wizard";
	L << "Healer";
	L << "Monk";
	L << "Paladin";
	L << "Priestess";
	L << "Cultist";
	L << "Adept";
	L << "Solarus";
	L << "Barbarian";
	L << "Warrior_of_Discord";
	L << "Dwarf";
	L << "Elf";
	L << "Gnome";
	L << "Gnome";
	L << "Wizard";
	L << "Priestess";
	L << "Cultist";
	L << "Warrior_of_Discord";
	L << "Hooligan";
	return L;
end

