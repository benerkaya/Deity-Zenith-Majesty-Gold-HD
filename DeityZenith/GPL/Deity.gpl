////////////////////////////////////////////////////////////////////////////////
// One monster at the flag: spawner = palace, spot = flag (the original game
// spawns from the palace at remote spots, e.g. Building_Deaths.gpl:852 map
// edge, epic_quest_scripts.gpl:2341 an Inn near a remote coordinate). If that
// fails, use the proven palace spawn and teleport.
function FMB_Spawn_At (agent palace, string unitType, coordinate spot) is list
declare
	agent m;
	list result, extra;
begin
	$FMB_Q_Save (unitType);
	m = $SpawnUnit (palace, unitType, $RandomCoord (spot, 120), $GetUnitPlayerNumber (palace), "override");
	if ($IsValidGamePiece (m) == FALSE)
		begin
			result = $FMB_Summon_One (palace, unitType);
			foreach m in result do
				begin
					m's "Coord_Home" = spot;
					$TeleportToPoint (m, 50000, spot);
				end
			return result;
		end
	$FMB_Make_Friendly (m, palace, spot);
	result << m;
	if (unitType == "Liche_Queen" || unitType == "Witch_King")
		begin
			extra = $FMB_Fix_Boss (m, palace, spot);
			result = $AddLists (result, extra);
		end
	return result;
end

function FMB_Flag_Monsters (agent palace, integer e, coordinate spot)
declare
	integer i, n, made, alive;
	string unitType;
	list got;
begin
	if ($FMB_Is_Hostile ())
		begin
			$FMB_Flag_Hostile (palace, e, spot);
			return;
		end
	unitType = $ListMember ($FMB_Type_List (), e);
	n = $FMB_Count ();
	alive = $ListSize ($FMB_List_Allies (palace));
	made = 0;
	i = 0;
	while (i < n) do
		begin
			if (alive + made < #FMB_Max_Alive)
				begin
					got = $FMB_Spawn_At (palace, unitType, spot);
					if ($ListSize (got) > 0)
						made = made + 1;
				end
			i = i + 1;
		end
	if (made == 0)
		begin
			if (alive >= #FMB_Max_Alive)
				$FMB_Say (palace, "IDTXT_FMB_CAP");
			else
				$FMB_Say (palace, "IDTXT_FMB_FAIL");
			return;
		end
	if (made == 1)
		$FMB_Say (palace, $ListMember ($FMB_One_Keys (), e));
	else
		$FMB_Say (palace, $ListMember ($FMB_Many_Keys (), e));
	if (made < n)
		$FMB_Say (palace, "IDTXT_FMB_PARTIAL");
end

// Player-owned building, first stage built ("maxhp", as Building_Births.gpl /
// epic_quest_scripts.gpl:2341 do). "clear" is NOT used (it deletes units under
// the footprint). Tries the flag spot, then 3 random spots nearby.
function FMB_Flag_Building (agent palace, integer e, coordinate spot)
declare
	agent b;
	integer tries, owner;
	string bt;
	boolean dark, pal;
begin
	bt = $ListMember ($FMB_Bld_List (), e - 200);
	// Guardhouse with faction Hostile / Red / Green: a Guardhouse of that side (Blue: below, unchanged)
	if (bt == "GuardHouse1")
		if ($FMB_Is_Hostile ())
			begin
				$FMB_HG_Flag_Guardhouse (palace, spot);
				return;
			end
	// every other building with faction Hostile / Red / Green: a building of that side (Blue: below, unchanged)
	if ($FMB_Is_Hostile ())
		if ($FMB_HB_Hostile (palace, e - 200))
			begin
				$FMB_HB_Flag_Building (palace, e - 200, spot);
				return;
			end
	dark = FALSE;
	pal = FALSE;
	if (bt == "EvilPalace")
		dark = TRUE;
	if (bt == "Palace3")
		pal = TRUE;
	owner = $GetUnitPlayerNumber (palace);
	// the Dark Palace and the Palace follow the faction picker; other buildings are always yours
	if (dark || pal)
		begin
			if ($FMB_Is_Hostile ())
				owner = $FMB_Host_Player (palace);
		end
	else if ($FMB_Is_Hostile ())
		$FMB_Say (palace, "IDTXT_FMB_BHOST");
	b = $SpawnUnit (palace, bt, spot, owner, "maxhp");
	tries = 0;
	while ($IsValidGamePiece (b) == FALSE && tries < 3) do
		begin
			b = $SpawnUnit (palace, bt, $RandomCoord (spot, 100, 250), owner, "maxhp");
			tries = tries + 1;
		end
	if ($IsValidGamePiece (b) == FALSE)
		begin
			$FMB_Say (palace, "IDTXT_FMB_BFAIL");
			return;
		end
	if (dark || pal)
		begin
			if (pal)
				$FMB_ModPalace_Prep (b, owner);
			else
				$FMB_DarkPalace_Prep (b, owner);
			if ($FMB_Is_Hostile ())
				begin
					$FMB_Fac_Team (palace, b);
					$FMB_Say_Owner (palace);
					if (owner == #Monster_Player)
						begin
							if (pal)
								$FMB_Say (palace, "IDTXT_FMB_PAL_H");
							else
								$FMB_Say (palace, "IDTXT_FMB_DPAL_H");
						end
					else
						begin
							if (pal)
								$FMB_Say (palace, "IDTXT_FMB_PAL_K");
							else
								$FMB_Say (palace, "IDTXT_FMB_DPAL_K");
						end
				end
			else
				begin
					if (pal)
						$FMB_Say (palace, "IDTXT_FMB_PAL_F");
					else
						$FMB_Say (palace, "IDTXT_FMB_DPAL_F");
				end
			return;
		end
	$FMB_Say (palace, $ListMember ($FMB_Bld_Keys (), e - 200));
end

////////////////////////////////////////////////////////////////////////////////
// Per-flag thread, same pattern as the original explore_flag_poll (which also
// reads $locationof (thisagent) and ends with $deletegamepiece (thisagent)).
// The reward is refunded first: the original poll pays the reward out with
// $dropgoldinradius_samePlayer and then deletes the flag, so deleting a flag
// does not give the gold back by itself.
// Two steps in the flag's own activeScript thread (the explore_flag_birth hook started it).
// Step 1 (first cycle): reward, summon, icon and friendly set-up, chat lines, "step 1" line.
// Step 2 (next cycle, 300 ms later: every Original birth script has run, NewUnitInit starts them 1 ms
// after the spawn): the flag is deleted FIRST, then the summons near it are checked and set up again if a
// birth script changed them (Skeleton_Birth: Type monster + Monster_follow, Sleeper_Birth timers, ...).
function FMB_Flag_Poll (agent thisagent)
declare
	agent palace, dp;
	coordinate spot;
	integer e, reward;
begin
	if (thisagent's "gavereward" == TRUE)
		begin
			$FMB_Flag_Finish (thisagent, $NullAgent ());
			return;
		end
	thisagent's "gavereward" = TRUE;
	palace = $FMB_Palace ();
	spot = $LocationOf (thisagent);
	reward = $GetAttribute (thisagent, #ATTRIB_rewardcost);
	e = $FMB_Entry ();
	if (reward > 0)
		$AdjustPlayerData (palace, "gold", reward);
	if ($IsValidGamePiece (palace) == FALSE)
		begin
			$DeleteGamePiece (thisagent);
			return;
		end
	if (e > 400)
		$FMB_Flag_Lair (palace, e, spot);
	else if (e > 200)
		$FMB_Flag_Building (palace, e, spot);
	else if (e > 110)
		$FMB_Flag_Heroes (palace, e, spot, $NullAgent ());
	else if (e > 106)
		$FMB_Flag_Heroes (palace, 131, spot, $NullAgent ());
	else if (e > 103)
		$FMB_Flag_Guards (palace, e - 3, spot, $NullAgent ());
	else if (e > 100)
		$FMB_Flag_Henchmen (palace, e, spot);
	else
		begin
			// Explore flag next to a Deity Zenith palace = Attack flag on it
			dp = $FMB_DP_Near (palace, spot);
			if ($IsValidGamePiece (dp))
				begin
					$FMB_Say (palace, "IDTXT_FMB_DPAL_NEAR");
					$FMB_Flag_Bodyguards (palace, e, dp);
				end
			else
				$FMB_Flag_Monsters (palace, e, spot);
		end
	$FMB_Note (palace, 1);
end

function FMB_Is_Human_Flag (agent flag) is boolean
declare
	agent palace;
begin
	palace = $FMB_Palace ();
	if ($IsValidGamePiece (palace) == FALSE)
		return FALSE;
	if ($GetUnitPlayerNumber (flag) != $GetUnitPlayerNumber (palace))
		return FALSE;
	return TRUE;
end

// OVERRIDE (by name) of the original explore flag birth script
// (Flags.dat: Flag_Explore birthscript Explore_Flag_Birth; original body in
// DecisionTrees/Modules/check_rewards.gpl). When OFF, or for any other player's
// flag, it does exactly what the original does.
// Diagnostics (chat line, human player only):
//   ON  -> "DZ: summoning at your Explore flag..." every flag
//   OFF -> "DZ: Explore-flag hook OK, summon is OFF..." on the
//          first 2 Explore flags of a game (counter reset in GplKickoff)
function FMB_Hook_explore_flag_birth (agent thisagent)
declare
	agent root, palace;
begin
	root = $FMB_Root ();
	if ($FMB_Is_Human_Flag (thisagent))
		begin
			$FMB_Ensure_Watch ();
			palace = $FMB_Palace ();
			if ($FMB_Is_On ())
				begin
					if ($FMB_Is_Hostile ())
						$FMB_Say (palace, "IDTXT_FMB_HOOK_ON_H");
					else
						$FMB_Say (palace, "IDTXT_FMB_HOOK_ON");
					thisagent's "activeScript" = $FMB_Flag_Poll;
					$NewThread (thisagent's "activeScript", 300, thisagent);
					return;
				end
			if (root's "FMCE_Note" < 2)
				begin
					root's "FMCE_Note" = root's "FMCE_Note" + 1;
					$FMB_Say (palace, "IDTXT_FMB_HOOK_OFF");
				end
		end
	$NewThread (thisagent's "activeScript", #flag_Cycle, thisagent);
end

////////////////////////////////////////////////////////////////////////////////
// OVERRIDE (by name) of GplKickoff (GplAIRoot prototype, Misc_Data.dat
// "KickoffFunction GplKickoff"; run once by InitializeGpl after the map objects
// are loaded). The original body is EMPTY in both rulesets (LowLevel.gpl:211,
// mx_LowLevel.gpl:329), so nothing of the original game is lost. Creates the
// FMCE_* values at game start (so Cheat Engine can find them before any flag)
// and prints one chat line proving the mod's code is running.
function FMB_Hook_GplKickoff ()
declare
	agent root, palace;
begin
	root = $FMB_Root ();
	root's "FMCE_Note" = 0;
	palace = $FMB_Palace ();
	if ($IsValidGamePiece (palace) == FALSE)
		return;
	if ($FMB_Is_On ())
		begin
			$FMB_Say (palace, $FMB_Entry_Key ($FMB_Entry ()));
			$FMB_Say_Faction (palace);
		end
	else
		$FMB_Say (palace, "IDTXT_FMB_HELLO");
	$FMB_Diag_Init (TRUE);
	$FMB_Ensure_Watch ();
end

////////////////////////////////////////////////////////////////////////////////
// No-Cheat-Engine fallback: a DEFEND flag placed on your own Palace steps the
// selection: OFF -> entry 1 (ON) -> 2 -> ... -> last -> OFF. The flag is then
// removed (reward refunded). Flag_Guard birthscript is RewardFlag_Birth, which
// is EMPTY in both original rulesets, so other defend flags are unchanged.
function FMB_Guard_Poll (agent thisagent)
declare
	agent palace, root;
	integer e, reward;
begin
	if (thisagent's "gavereward" == TRUE)
		return;
	thisagent's "gavereward" = TRUE;
	palace = $FMB_Palace ();
	root = $FMB_Root ();
	reward = $GetAttribute (thisagent, #ATTRIB_rewardcost);
	if (reward > 0)
		$AdjustPlayerData (palace, "gold", reward);
	$DeleteGamePiece (thisagent);

	e = $FMB_Entry ();
	if ($FMB_Is_On () == FALSE)
		e = 1;
	else
		begin
			e = $FMB_Next_Entry (e);
		end
	if (e == 0)
		begin
			root's "FMCE_On" = 7405568;
			$FMB_Say (palace, "IDTXT_FMB_OFF");
			return;
		end
	root's "FMCE_Type" = 7340032 + e;
	root's "FMCE_On" = 7405568 + 1;
	$FMB_Say (palace, $FMB_Entry_Key (e));
	$FMB_Say_Faction (palace);
end

function FMB_Entry_Key (integer e) is string
declare
begin
	if (e > 400)
		return $ListMember ($FMB_ESel_Keys (), #FMB_Type_Count + 7 + 20 + 32 + e - 400);
	if (e > 200)
		return $ListMember ($FMB_ESel_Keys (), #FMB_Type_Count + 7 + 20 + e - 200);
	if (e > 110)
		return $ListMember ($FMB_ESel_Keys (), #FMB_Type_Count + 7 + e - 110);
	if (e > 100)
		return $ListMember ($FMB_ESel_Keys (), #FMB_Type_Count + e - 100);
	return $ListMember ($FMB_ESel_Keys (), e);
end

function FMB_Hook_RewardFlag_Birth (agent thisagent)
declare
	agent target, palace;
begin
	if ($FMB_Is_Human_Flag (thisagent) == FALSE)
		return;
	$FMB_Ensure_Watch ();
	if (thisagent's "title" != "Flag_Guard")
		return;
	palace = $FMB_Palace ();
	target = $AgentNumber ($GetAttribute (thisagent, #ATTRIB_targetID));
	if (target == palace)
		begin
			thisagent's "activeScript" = $FMB_Guard_Poll;
			$NewThread (thisagent's "activeScript", 300, thisagent);
		end
end

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// ===== guards, enemy lairs, faction picker =====
// Entry numbers (FMCE_Type = 7340032 + entry):
//   1..32 monsters, 101..103 guards, 201..232 buildings, 401..424 lairs
// FMCE_Faction = 7536640 + 0/1/2/3 (Friendly default / Hostile / Red / Green, see the Red / Green block). Hostile applies to
// monsters and lairs (owned by the monster player, #Monster_Player = 7, exactly like
// the game's own monster waves, e.g. mx_LowLevel.gpl cheat_wave_*). Buildings and
// guards are always yours: they need your Palace (count_building / GetTruePalace,
// guard homes) and the monster player has none.
function FMB_Is_Hostile () is boolean
declare
	agent root;
begin
	root = $FMB_Root ();
	if ($FMB_Decode (root's "FMCE_Faction", 7536640, 0, 3, 0) > 0)
		return TRUE;
	return FALSE;
end

function FMB_Say_Faction (agent palace)
declare
begin
	if ($FMB_Fac () == 1)
		$FMB_Say (palace, "IDTXT_FMB_FACTION_H");
	else if ($FMB_Fac () == 2)
		$FMB_Say (palace, "IDTXT_FMB_FACTION_R");
	else if ($FMB_Fac () == 3)
		$FMB_Say (palace, "IDTXT_FMB_FACTION_G");
	else
		$FMB_Say (palace, "IDTXT_FMB_FACTION_F");
end

function FMB_Valid_Entry (integer e) is boolean
declare
begin
	if (e >= 1 && e <= #FMB_Type_Count)
		return TRUE;
	if (e > 100 && e <= 107)
		return TRUE;
	if (e > 110 && e <= 130)
		return TRUE;
	if (e > 200 && e <= 232)
		return TRUE;
	if (e > 400 && e <= 424)
		return TRUE;
	return FALSE;
end

// Entry order: monsters, guards, buildings, lairs, OFF (0)
function FMB_Next_Entry (integer e) is integer
declare
	integer n;
begin
	n = e + 1;
	if (n > #FMB_Type_Count && n <= 100)
		n = 100 + 1;
	if (n > 107 && n <= 110)
		n = 110 + 1;
	if (n > 130 && n <= 200)
		n = 200 + 1;
	if (n > 232 && n <= 400)
		n = 400 + 1;
	if (n > 424)
		n = 0;
	return n;
end

function FMB_Guard_List () is list
declare
	list L;
begin
	L << "City_Guard";
	L << "Veteran_City_Guard";
	L << "Palace_Guard";
	return L;
end

function FMB_Guard_Keys () is list
declare
	list L;
begin
	L << "IDTXT_FMB_GRD_01";
	L << "IDTXT_FMB_GRD_02";
	L << "IDTXT_FMB_GRD_03";
	return L;
end

function FMB_Lair_List () is list
declare
	list L;
begin
	L << "Goblin_Hovel";
	L << "Goblin_Camp";
	L << "Animal_Den";
	L << "Ruined_Altar1";
	L << "Ruined_Keep1";
	L << "Ruined_Shrine1";
	L << "Dark_Castle1";
