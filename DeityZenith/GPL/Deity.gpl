function FM_Hero_Hostile (agent m)
declare
begin
	if ($isdead (m))
		return;
	m's "Type" = "monster";
	m's "EnemyType" = "hero";
	m's "StartingScript" = $raider;
	m's "BasicScript" = $raider;
	m's "BackScript" = $raider;
	m's "ActiveScript" = $raider;
	m's "evaluationScript" = $monster_eval_enemies;
	m's "Raider_respond" = TRUE;
	m's "target" = $NullAgent ();
end

function FM_Hooligan_Hostile (agent m, coordinate spot)
declare
begin
	if ($isdead (m))
		return;
	m's "Type" = "Monster";
	m's "Subtype" = "Monster";
	m's "ActiveScript" = $Guardian;
	m's "BasicScript" = $Guardian;
	m's "BackScript" = $Guardian;
	m's "StartingScript" = $Guardian;
	m's "Coord_Home" = spot;
	m's "Target_Item" = 9177;
	$LearnSpell (m, "Power_Shock");
	$LearnSpell (m, "Flame_Shield");
	$LearnSpell (m, "Teleport");
	$LearnSpell (m, "Resist_Magic");
	$SetAttribute (m, #ATTRIB_ExperienceLevel, 10);
	$SetAttribute (m, #ATTRIB_MaxHP, 40);
	$SetAttribute (m, #ATTRIB_HP, 40);
	$SetAttribute (m, #ATTRIB_NotFlaggable, 0);
	$SetAttribute (m, #ATTRIB_NotSpellTarget, 0);
end

// quest heroes: the same steps the quest scripts use
//   Angry Wizard: High_Level_Hero_Birth (Wizard's Curse): level 20, 50 HP, armour +4, Fire Blast,
//   Meteor Storm, 5 healing potions. Scions of Chaos (Quests_2.gpl:350/388/473): level 35, +100 HP
//   (Priestess) / +200 HP (Cultist), resist_critical, title "Scion" (hostile ones only: the title
//   is what the quest gives its enemies; a Blue one keeps its class title for its class AI).
//   Gnome Champion: a Gnome advanced to level 8 = the game's own promotion (Expansion only).
function FM_Hero_Setup (agent m, string rc, boolean hostile, coordinate spot)
declare
begin
	if ($isdead (m))
		return;
	if (rc == "hool")
		begin
			if (hostile)
				$FM_Hooligan_Hostile (m, spot);
			else
				begin
					m's "Coord_Home" = spot;
					m's "Target_Item" = 9176;
				end
			return;
		end
	if (rc == "champ")
		$advance_to_level (m, 8);
	if (rc == "angry")
		begin
			$advance_to_level (m, 20);
			$SetAttribute (m, #ATTRIB_MaxHP, 50);
			$SetAttribute (m, #ATTRIB_HP, 50);
			$AdjustAttribute (m, #attrib_Armor_basic_damage, 4);
			$LearnSpell (m, "Fire_Blast");
			$LearnSpell (m, "Meteor_Storm");
			$AdjustAttribute (m, #ATTRIB_NumHealingPotions, 5);
		end
	if (rc == "scion1" || rc == "scion2" || rc == "scion3")
		begin
			$advance_to_level (m, 35);
			if (rc == "scion1")
				begin
					$AdjustAttribute (m, #ATTRIB_MAXHP, 100);
					$AdjustAttribute (m, #ATTRIB_HP, 100);
				end
			if (rc == "scion2")
				begin
					$AdjustAttribute (m, #ATTRIB_MAXHP, 200);
					$AdjustAttribute (m, #ATTRIB_HP, 200);
				end
			m's "resist_critical" = TRUE;
			if (hostile)
				m's "title" = "Scion";
		end
	if (hostile)
		$FM_Hero_Hostile (m);
end

function FM_Hero_Attack (agent m, agent target, boolean hostile, string rc)
declare
begin
	if ($isdead (m) || rc == "hool")
		return;
	m's "target" = target;
	if (hostile)
		m's "ActiveScript" = $raider;
	else
		m's "ActiveScript" = $attack_object;
end

function FM_Hero_Spawn (agent palace, string ht, coordinate spot, integer owner) is agent
declare
	agent m, root;
	integer tries;
	boolean q3;
begin
	root = $FM_Root ();
	q3 = root's "Quest_Flag_3";
	if (ht == "Hooligan")
		root's "Quest_Flag_3" = FALSE;
	m = $FM_Spawn_Safe (palace, ht, $RandomCoord (spot, 120), owner, "override");
	tries = 0;
	while ($IsValidGamePiece (m) == FALSE && tries < 2) do
		begin
			m = $FM_Spawn_Safe (palace, ht, $RandomCoord (spot, 100, 250), owner, "override");
			tries = tries + 1;
		end
	root's "Quest_Flag_3" = q3;
	return m;
end

// target: the Attack flag's target (null for an Explore flag or when it is gone)
function FM_Flag_Heroes (agent palace, integer e, coordinate spot, agent target)
declare
	integer i, n, made, owner, mode;
	string ht, rc;
	agent m;
	boolean hostile;
begin
	ht = $ListMember ($FM_Hero_List (), e - 110);
	rc = $ListMember ($FM_Hero_Recipe (), e - 110);
	n = $FM_Count ();
	hostile = $FM_Is_Hostile ();
	owner = $GetUnitPlayerNumber (palace);
	if (hostile)
		owner = $FM_Host_Player (palace);
	mode = 0;
	if ($IsValidGamePiece (target))
		begin
			spot = $LocationOf (target);
			mode = 2;
			if ($GetUnitPlayerNumber (target) == owner)
				mode = 1;
		end
	made = 0;
	i = 0;
	while (i < n) do
		begin
			m = $FM_Hero_Spawn (palace, ht, spot, owner);
			if ($IsValidGamePiece (m))
				begin
					$FM_Hero_Setup (m, rc, hostile, spot);
					if (hostile)
						$FM_Fac_Team (palace, m);
					if (mode == 2)
						$FM_Hero_Attack (m, target, hostile, rc);
					made = made + 1;
				end
			i = i + 1;
		end
	if (made == 0)
		begin
			$FM_Say (palace, "IDTXT_FMX_HERO_FAIL");
			return;
		end
	if (hostile)
		begin
			$FM_Say_Owner (palace);
			if (made == 1)
				$FM_Say (palace, $ListMember ($FM_HeroH_Keys (), e - 110));
			else
				$FM_Say (palace, $ListMember ($FM_HeroHN_Keys (), e - 110));
		end
	else
		begin
			if (made == 1)
				$FM_Say (palace, $ListMember ($FM_Hero1_Keys (), e - 110));
			else
				$FM_Say (palace, $ListMember ($FM_HeroN_Keys (), e - 110));
		end
	if (mode == 2)
		$FM_Say (palace, "IDTXT_FMX_HMODE_ATTACK");
	if (mode == 1)
		$FM_Say (palace, "IDTXT_FMX_HMODE_GUARD");
	if (made < n)
		$FM_Say (palace, "IDTXT_FMX_HERO_PART");
end

////////////////////////////////////////////////////////////////////////////////
// ===== Henchmen: Peasant, Peasant (female), Tax Collector = entries 101..103, guards 104..106 =====
// Spawned by your Palace and owned by you, like the Palace's own peasant_spawner / tax_spawner do.
// peasant_birth / tax_collector_birth set home = $GetPalace (your Palace) and count them there
// (num_peasants / num_tax_collectors), so they build / repair / collect taxes for your real Palace
// (peasant_basic and collect_tax use $GetTruePalace). The Palace spawners only refill below their
// maximum, so extra ones are simply extra; when one dies the game's own death script updates the counts.
// Tax Collector: the stock tax_spawner passes ReturnAmount / PickupAmount at spawn; Deity Zenith sets the same
// defaults (#taxman_return_start / #taxman_pickup_start).
// Factions Hostile/Red/Green do NOT apply (same rule as the guards): a monster-player peasant is the game's
// invulnerable "captive" (peasant_birth, Type Hidden), and a Red/Green one would need that kingdom's real
// Palace. They are always yours. Integer attributes only, no threads, no birth script swap.
function FM_Hench_List () is list
declare
	list L;
begin
	L << "Peasant";
	L << "Peasant_Female";
	L << "Tax_Collector";
	return L;
end

function FM_Hench1_Keys () is list
declare
	list L;
begin
	L << "IDTXT_FMX_HEN1_01";
	L << "IDTXT_FMX_HEN1_02";
	L << "IDTXT_FMX_HEN1_03";
	return L;
end

function FM_HenchN_Keys () is list
declare
	list L;
begin
	L << "IDTXT_FMX_HENN_01";
	L << "IDTXT_FMX_HENN_02";
	L << "IDTXT_FMX_HENN_03";
	return L;
end

function FM_Flag_Henchmen (agent palace, integer e, coordinate spot)
declare
	integer i, n, made;
	string ht;
	agent m;
begin
	ht = $ListMember ($FM_Hench_List (), e - 100);
	n = $FM_Count ();
	if ($FM_Is_Hostile ())
		$FM_Say (palace, "IDTXT_FMX_HHOST");
	made = 0;
	i = 0;
	while (i < n) do
		begin
			m = $FM_Spawn_Safe (palace, ht, $RandomCoord (spot, 120), $GetUnitPlayerNumber (palace), "override");
			if ($IsValidGamePiece (m) == FALSE)
				m = $FM_Spawn_Safe (palace, ht, $RandomCoord (spot, 100, 250), $GetUnitPlayerNumber (palace), "override");
			if ($IsValidGamePiece (m))
				begin
					if (ht == "Tax_Collector")
						begin
							$SetAttribute (m, #ATTRIB_ReturnAmount, #taxman_return_start);
							$SetAttribute (m, #ATTRIB_PickupAmount, #taxman_pickup_start);
						end
					made = made + 1;
				end
			i = i + 1;
		end
	if (made == 0)
		begin
			$FM_Say (palace, "IDTXT_FMX_HENFAIL");
			return;
		end
	if (made == 1)
		$FM_Say (palace, $ListMember ($FM_Hench1_Keys (), e - 100));
	else
		$FM_Say (palace, $ListMember ($FM_HenchN_Keys (), e - 100));
	if (made < n)
		$FM_Say (palace, "IDTXT_FMX_HENPART");
end
function FM_Guard_Post (agent b, string gt) is boolean
declare
begin
	// a home the game's guard AI runs on: Guardhouse, built Outpost or Palace (all three carry
	// Guards / Num_Guards / Waiting_Guards / Guard_Function). Palace Guards: Outpost or Palace only
	// (the buildings whose Palace_Guard_Spawner makes them). Deity Zenith's own palaces are no home.
	if ($IsDead (b))
		return FALSE;
	if ($FM_Is_Mod_Palace (b))
		return FALSE;
	if (b's "subtype" == "Outpost")
		begin
			if ($GetAttribute (b, #ATTRIB_FirstStageBuilt) == 1)
				return TRUE;
			return FALSE;
		end
	if (b's "subtype" == "Palace" || b's "title" == "Palace")
		return TRUE;
	if (gt != "Palace_Guard")
		if (b's "title" == "GuardHouse")
			return TRUE;
	return FALSE;
end

function FM_Guard_Home (agent palace, coordinate spot, agent target, integer mode, string gt) is agent
declare
	list blds;
	agent b, h;
	integer d, best;
begin
	// guard mode on your own Guardhouse, Outpost or Palace: that building is their post
	if (mode == 1)
		if ($FM_Guard_Post (target, gt))
			return target;
	// else the nearest of them to the flag / flagged target (spot), or your Palace
	h = palace;
	best = -1;
	$ListObjects (palace, "building", -1, blds, #MyPlayer);
	foreach b in blds do
		begin
			if ($FM_Guard_Post (b, gt))
				begin
					d = $DistanceBetweenCoords ($LocationOf (b), spot);
					if (best < 0 || d < best)
						begin
							best = d;
							h = b;
						end
				end
		end
	return h;
end

function FM_Guard_Attack (agent g, agent target)
declare
begin
	if ($IsDead (g))
		return;
	g's "Target" = target;
	g's "ActiveScript" = $Voyaging_Guard_Attack_Object;
end

////////////////////////////////////////////////////////////////////////////////
// ===== Hostile guards (faction Hostile / Red / Green only; Blue guards use FM_Flag_Guards as before) =====
// The game's guard AI (mx_Building_Guard.gpl) works for any owner: enemies are found with
// list_enemies_seen (#NotMyTeam) from the guard's Home, and the Home's Guard_Function thread
// (Building_Guard) releases the guards sleeping in it. What a non-player side lacks is a Palace:
// City_Guard_Birth reads its Home from the Waiting_Guardhouses of the owner's Palace. So the home is
// set here, right after the (synchronous) birth. Nothing is ever put on a Waiting_Guardhouses list,
// and only buildings of the guards' own side are homes: a Guardhouse, or a Palace / Dark Palace placed
// by Deity Zenith (their Building_Guard thread keeps running). Outposts are not used.
function FM_HG_Post (agent b, integer owner) is boolean
declare
begin
	if ($IsValidGamePiece (b) == FALSE)
		return FALSE;
	if ($IsDead (b))
		return FALSE;
	if ($GetUnitPlayerNumber (b) != owner)
		return FALSE;
	// quest "rescue" buildings: Type unknown, EnemyType nothing (Building_Guard does nothing there)
	if (b's "type" != "building")
		return FALSE;
	if (b's "EnemyType" == "nothing")
		return FALSE;
	if (b's "title" == "GuardHouse")
		return TRUE;
	if ($FM_Is_Mod_Palace (b))
		return TRUE;
	return FALSE;
end

// nearest home of that side to the spot (skip = a building that is going away), else null
function FM_HG_Home (agent ref, coordinate spot, integer owner, agent skip) is agent
declare
	list blds;
	agent b, h;
	integer d, best;
begin
	h = $NullAgent ();
	best = -1;
	$ListObjects (ref, "building", -1, blds);
	foreach b in blds do
		begin
			if (b != skip)
				if ($FM_HG_Post (b, owner))
					begin
						d = $DistanceBetweenCoords ($LocationOf (b), spot);
						if (best < 0 || d < best)
							begin
								best = d;
								h = b;
							end
					end
		end
	return h;
end

// a Guardhouse of that side at the spot (as FM_Flag_Building places buildings)
function FM_HG_Guardhouse (agent palace, coordinate spot, integer owner) is agent
declare
	agent b;
	integer tries;
begin
	b = $SpawnUnit (palace, "GuardHouse1", spot, owner, "maxhp");
	tries = 0;
	while ($IsValidGamePiece (b) == FALSE && tries < 3) do
		begin
			b = $SpawnUnit (palace, "GuardHouse1", $RandomCoord (spot, 100, 250), owner, "maxhp");
			tries = tries + 1;
		end
	if ($IsValidGamePiece (b))
		$FM_Fac_Team (palace, b);
	return b;
end

// home h, registered like City_Guard_Birth / Palace_Guard_Birth do, scripts = the guard's start
// scripts (Guard_Voyage_Home), AI thread running
function FM_HG_Attach (agent g, agent h)
declare
	agent old;
begin
	if ($IsDead (g))
		return;
	if ($FM_HG_Post (h, $GetUnitPlayerNumber (g)))
		begin
			old = g's "Home";
			if (old != h)
				begin
					if ($IsDead (old) == FALSE)
						if ($GetUnitPlayerNumber (old) == $GetUnitPlayerNumber (g))
							if ($AgentInList (g, old's "Guards"))
								begin
									old's "Guards" -= g;
									old's "Num_Guards" = old's "Num_Guards" - 1;
								end
					g's "Home" = h;
				end
			if ($AgentInList (g, h's "Guards") == FALSE)
				begin
					h's "Guards" << g;
					h's "Num_Guards" = h's "Num_Guards" + 1;
				end
		end
	g's "Target" = $NullAgent ();
	g's "ActiveScript" = $Guard_Voyage_Home;
	g's "BasicScript" = $Guard_Voyage_Home;
	g's "BackScript" = $Guard_Voyage_Home;
	if ($IsRunning (g's "ActiveScript") == FALSE)
		$NewThread (g's "ActiveScript", #Henchmen_Cycle, g);
end

function FM_HG_Spawn (agent palace, string gt, coordinate spot, agent h, integer owner) is agent
declare
	agent g;
begin
	// spawned by the home: Palace_Guard_Birth takes $Parent as home
	g = $FM_Spawn_Safe (h, gt, $RandomCoord (spot, 120), owner, "override");
	if ($IsValidGamePiece (g) == FALSE)
		g = $FM_Spawn_Safe (h, gt, $RandomCoord (spot, 100, 250), owner, "override");
	if ($IsValidGamePiece (g) == FALSE)
		return g;
	$FM_HG_Attach (g, h);
	$FM_Fac_Team (palace, g);
	return g;
end

function FM_HG_Keys () is list
declare
	list L;
begin
	L << "IDTXT_FMX_HG_01";
	L << "IDTXT_FMX_HG_02";
	L << "IDTXT_FMX_HG_03";
	return L;
end

function FM_HG_Flag_Guards (agent palace, integer e, coordinate spot, agent target)
declare
	integer i, n, made, mode, owner;
	string gt;
	agent g, h;
	boolean built;
begin
	gt = $ListMember ($FM_Guard_List (), e - 100);
	n = $FM_Count ();
	owner = $FM_Host_Player (palace);
	// Attack flag: owner of the guards vs owner of the target, as for the other summons
	mode = 0;
	h = $NullAgent ();
	if ($IsDead (target) == FALSE)
		begin
			mode = 2;
			if ($GetUnitPlayerNumber (target) == owner)
				mode = 1;
		end
	if (mode == 1)
		if ($FM_HG_Post (target, owner))
			h = target;
	if ($IsValidGamePiece (h) == FALSE)
		h = $FM_HG_Home (palace, spot, owner, $NullAgent ());
	built = FALSE;
	if ($IsValidGamePiece (h) == FALSE)
		begin
			h = $FM_HG_Guardhouse (palace, spot, owner);
			if ($IsValidGamePiece (h) == FALSE)
				begin
					$FM_Say (palace, "IDTXT_FMX_GFAIL");
					return;
				end
			built = TRUE;
		end
	made = 0;
	i = 0;
	while (i < n) do
		begin
			g = $FM_HG_Spawn (palace, gt, spot, h, owner);
			if ($IsValidGamePiece (g))
				begin
					if (mode == 2)
						$FM_Guard_Attack (g, target);
					made = made + 1;
				end
			i = i + 1;
		end
	$FM_Say_Owner (palace);
	if (built)
		$FM_Say (palace, "IDTXT_FMX_HG_GH");
	if (made == 0)
		begin
			$FM_Say (palace, "IDTXT_FMX_GFAIL");
			return;
		end
	$FM_Say (palace, $ListMember ($FM_HG_Keys (), e - 100));
	if (mode == 2)
		$FM_Say (palace, "IDTXT_FMX_HG_ATTACK");
	if (mode == 1)
		$FM_Say (palace, "IDTXT_FMX_HG_GUARD");
	if (made < n)
		$FM_Say (palace, "IDTXT_FMX_PARTIAL");
end

// Guardhouse entry with faction Hostile / Red / Green: a Guardhouse of that side
function FM_HG_Flag_Guardhouse (agent palace, coordinate spot)
declare
	agent b;
begin
	b = $FM_HG_Guardhouse (palace, spot, $FM_Host_Player (palace));
	if ($IsValidGamePiece (b) == FALSE)
		begin
			$FM_Say (palace, "IDTXT_FMX_BFAIL");
			return;
		end
	$FM_Say_Owner (palace);
	$FM_Say (palace, "IDTXT_FMX_HG_BLD");
end

// a Deity Zenith Palace / Dark Palace of another side dies: its guards move to the nearest other home
// of their side, else they do what the game's GuardHouse_Death makes them do (Guard_Goto_Palace)
function FM_HG_Release (agent b)
declare
	agent g, h;
	list l;
begin
	l = b's "Guards";
	foreach g in l do
		begin
			if ($IsDead (g) == FALSE)
				begin
					if ($IsHidden (g))
						begin
							g's "Type" = "Hero";
							$UnHide (g);
						end
					h = $FM_HG_Home (b, $LocationOf (b), $GetUnitPlayerNumber (g), b);
					if ($IsValidGamePiece (h))
						begin
							g's "Home" = h;
							$FM_HG_Attach (g, h);
						end
					else
						begin
							g's "ActiveScript" = $Guard_Goto_Palace;
							g's "BasicScript" = $Guard_Goto_Palace;
							g's "BackScript" = $Guard_Goto_Palace;
						end
					$ResumeThread (g's "ActiveScript");
				end
		end
end


////////////////////////////////////////////////////////////////////////////////
// ===== Hostile buildings (faction Hostile / Red / Green only; Blue buildings use FM_Flag_Building as before) =====
// The building is spawned for the picked side (FM_Host_Player: the monster player, Red or Green, never you) and
// then prepared right away, before its delayed second birth script (basic_birth / magical_birth start
// birthscript2 1 ms later) reads its slots:
// - guilds, temples, Embassy, Outpost: no open hero slot (#ATTRIB_MaxGuildMembers 0), so check_strays
//   (guild_birth, warriors_guild_birth, Outpost_Birth, Embassy_Birth) and Embassy_Spawn never adopt or hire a hero;
// - no timers that place more buildings (spawn_1 / spawn_2: Brothel, Gambling Hall, Gazebo), no caravans
//   (Trading Post), no hero spawning (Embassy), no new Gnome Hovels (that side's Palace gnome_camp_spawner);
// - Outpost: the mod's palace death (no $declareloss, no Player_Dead_Cleanup), no income / tax collectors /
//   peasants, its own Palace Guards (for the monster player Outpost_Birth starts nothing, so they are started here).
// Everything else (towers shooting, shops, revenue into the building's own gold, the stock death scripts) is the
// game's own code, which works for any owner. Nothing here reads or changes a building of yours.
// In the Legendary Heroes quest (Quest_Number 33) the game's guild births reopen a hero slot, so guilds and temples
// stay yours there.
function FM_HB_Guild (integer k) is boolean
declare
begin
	// 1..11 guilds and temples, 21..23 Dwarven Settlement / Elven Bungalow / Gnome Hovel, 35 Embassy
	if (k >= 1 && k <= 11)
		return TRUE;
	if (k >= 21 && k <= 23)
		return TRUE;
	if (k == 35)
		return TRUE;
	return FALSE;
end

function FM_HB_Hostile (agent palace, integer k) is boolean
declare
	agent root;
	string bt;
begin
	bt = $ListMember ($FM_Bld_List (), k);
	// Guardhouse: FM_HG_Flag_Guardhouse; the mod's Palace / Dark Palace: their own path; Graveyard: always yours
	if (bt == "GuardHouse1" || bt == "EvilPalace" || bt == "Palace3" || bt == "Graveyard")
		return FALSE;
	if ($FM_HB_Guild (k))
		begin
			root = $RetrieveAgent ("GplAIRoot");
			if ($HasAttribute ("Quest_Number", root))
				if (root's "Quest_Number" == 33)
					begin
						$FM_Say (palace, "IDTXT_FMX_HB_LEG");
						return FALSE;
					end
		end
	return TRUE;
end

function FM_HB_Prep (agent b, integer k, integer owner)
declare
	string bt;
	list l;
	agent p;
begin
	bt = $ListMember ($FM_Bld_List (), k);
	if ($FM_HB_Guild (k) || bt == "Outpost")
		$SetAttribute (b, #ATTRIB_MaxGuildMembers, 0);
	if ($HasAttribute ("spawn_1", b))
		begin
			if ($IsRunning (b's "spawn_1"))
				$KillThread (b's "spawn_1");
			b's "spawn_1" = $FM_DarkPalace_Idle;
		end
	if ($HasAttribute ("spawn_2", b))
		begin
			if ($IsRunning (b's "spawn_2"))
				$KillThread (b's "spawn_2");
			b's "spawn_2" = $FM_DarkPalace_Idle;
		end
	if (bt == "Embassy" || bt == "Trading_Post")
		begin
			if ($IsRunning (b's "activeScript"))
				$KillThread (b's "activeScript");
			b's "activeScript" = $FM_DarkPalace_Idle;
		end
	if (bt == "Gnome_Hovel")
		begin
			$ListObjects (b, "building", -1, l, #CheckTitles, "Palace", #MyPlayer);
			foreach p in l do
				begin
					if ($GetUnitPlayerNumber (p) == owner)
						if ($HasAttribute ("gnome_camp_spawner", p))
							begin
								if ($IsRunning (p's "gnome_camp_spawner"))
									$KillThread (p's "gnome_camp_spawner");
								p's "gnome_camp_spawner" = $FM_DarkPalace_Idle;
							end
				end
		end
	if (bt == "Outpost")
		begin
			b's "IGdeathScript" = $FM_DarkPalace_Death;
			if ($IsRunning (b's "activeScript"))
				$KillThread (b's "activeScript");
			if ($IsRunning (b's "Tax_spawn"))
				$KillThread (b's "Tax_spawn");
			if ($IsRunning (b's "peasant_spawn"))
				$KillThread (b's "peasant_spawn");
			b's "activeScript" = $FM_DarkPalace_Idle;
			b's "Tax_spawn" = $FM_DarkPalace_Idle;
			b's "peasant_spawn" = $FM_DarkPalace_Idle;
			if (owner == #Monster_Player)
				begin
					$NewThread (b's "Guard_Function", #Normal_Cycle, b);
					$RunThread (b's "Guard_Spawn_Function", #initial_Palace_guard_delay, b);
				end
		end
end

function FM_HB_Flag_Building (agent palace, integer k, coordinate spot)
declare
	agent b;
	integer tries, owner;
	string bt;
begin
	bt = $ListMember ($FM_Bld_List (), k);
	owner = $FM_Host_Player (palace);
	b = $SpawnUnit (palace, bt, spot, owner, "maxhp");
	tries = 0;
	while ($IsValidGamePiece (b) == FALSE && tries < 3) do
		begin
			b = $SpawnUnit (palace, bt, $RandomCoord (spot, 100, 250), owner, "maxhp");
			tries = tries + 1;
		end
	if ($IsValidGamePiece (b) == FALSE)
		begin
			$FM_Say (palace, "IDTXT_FMX_BFAIL");
			return;
		end
	$FM_HB_Prep (b, k, owner);
	$FM_Fac_Team (palace, b);
	$FM_Say_Owner (palace);
	if (bt == "Outpost")
		$FM_Say (palace, "IDTXT_FMX_HB_OUT");
	else if ($FM_HB_Guild (k))
		$FM_Say (palace, "IDTXT_FMX_HB_DECOR");
	else
		$FM_Say (palace, "IDTXT_FMX_HB_BLD");
end

