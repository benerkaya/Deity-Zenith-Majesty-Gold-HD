////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// ===== nature monsters (Flowering Strangleweed, Daemonwood, Dryad) =====
// They are ordinary monster entries (appended after the last monster). Spawned like
// every other monster (SpawnUnit, data birthscript Guardian_Birth -> Monster_Birth).
// Friendly: FM_Make_Friendly as usual (Type Hero / SubType Controlled, your player,
// StartingScript FM_Friendly_Loop = the ally marker), but FM_Friendly_Loop hands
//   Strangleweed (speed 0, data AI Rooted_Guardian) to FM_Rooted_Loop below, and
//   Daemonwood (data AI Returning_Guardian) to the game's own Returning_Guardian,
//   which only uses $list_enemies_seen (team based) and Coord_Home (= the flag).
// The game itself keeps native AI for friendly Daemonwoods (epic_quest_scripts
// setup_rescue_pets / pet_ready). Dryad moves normally and uses the regular loop.
// Hostile: monster player, data AI; FM_Hostile_Prep sets Coord_Home to the spawn spot.
//
// Same as the data AI Rooted_Guardian, but enemies are found by team
// ($list_enemies_seen) instead of the "EnemyType" attribute, and it never moves.
function FM_Rooted_Loop (agent thisagent)
declare
	list enemies;
	agent t;
begin
	if ($isdead (thisagent))
		return;
	enemies = $list_enemies_seen (thisagent, $GetAttribute (thisagent, #ATTRIB_SightRange));
	if ($ListSize (enemies) > 0)
		begin
			t = $pick_closest (thisagent, enemies);
			if ($IsValidGamePiece (t))
				begin
					thisagent's "target" = t;
					$PerformAction (thisagent, thisagent's "Attack_Action", t);
					return;
				end
		end
	thisagent's "target" = $NullAgent ();
	if ($RandomNumber (1000) > 950)
		$PerformAction (thisagent, "basic_idle_2", thisagent);
	else
		$PerformAction (thisagent, "do_nothing", $LocationOf (thisagent));
end

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// ===== bodyguard summons with the ATTACK flag =====
// OVERRIDE (by name) of attack_flag_birth (Flags.dat / mx_Flags.dat: Flag_Attack
// birthscript attack_Flag_Birth; original in DecisionTrees/Modules/check_rewards.gpl
// and mx_check_rewards.gpl). When summon is OFF, or for another player's flag, the
// ORIGINAL body below runs unchanged (copied verbatim, only re-formatted).
// When ON (your flag): the flag is removed (reward refunded, like the Explore flag)
// and the selected unit(s) appear next to the flagged unit/building:
//   monsters  -> same owner as the target: bodyguards; other owner: attackers
//   guards, buildings, lairs, Strangleweed -> simply placed next to the target.
function FMX_Hook_attack_flag_birth (agent thisagent)
declare
	agent target;
	integer flagplayer, targetplayer;
begin
	if ($FM_Is_Human_Flag (thisagent))
		begin
			$FM_Ensure_Watch ();
			if ($FM_Is_On ())
				begin
					thisagent's "gavereward" = FALSE;
					thisagent's "activeScript" = $FM_Attack_Poll;
					$NewThread (thisagent's "activeScript", 300, thisagent);
					return;
				end
		end
	$NewThread (thisagent's "activeScript", #flag_Cycle, thisagent);
	thisagent's "gavereward" = FALSE;

	target = $agentnumber ($getattribute (thisagent, #ATTRIB_targetID));
	targetplayer = $getunitplayernumber (target);
	flagplayer = $getunitplayernumber (thisagent);
	if (targetplayer != #monster_player)
		if (targetplayer != flagplayer)
			if ($getplayerteamnumber (target) == $getplayerteamnumber (thisagent))
				begin
					$setplayerteamnumber (thisagent, $newteamnumber ());
				end
end

// Same pattern as FM_Flag_Poll. The target is read the way the original
// attack_flag_poll does: $AgentNumber ($GetAttribute (flag, #ATTRIB_targetID)).
function FM_Attack_Poll (agent thisagent)
declare
	agent palace, target;
	coordinate spot;
	integer e, reward;
begin
	if (thisagent's "gavereward" == TRUE)
		return;
	thisagent's "gavereward" = TRUE;
	palace = $FM_Palace ();
	spot = $LocationOf (thisagent);
	target = $AgentNumber ($GetAttribute (thisagent, #ATTRIB_targetID));
	reward = $GetAttribute (thisagent, #ATTRIB_rewardcost);
	e = $FM_Entry ();
	if (reward > 0)
		$AdjustPlayerData (palace, "gold", reward);
	$DeleteGamePiece (thisagent);
	if ($IsValidGamePiece (palace) == FALSE)
		return;
	if ($FM_BG_Gone (target) == FALSE)
		spot = $LocationOf (target);
	else
		begin
			$FM_Say (palace, "IDTXT_FMX_BG_NOTARGET");
			target = $NullAgent ();
		end
	if (e > 400)
		$FM_Flag_Lair (palace, e, spot);
	else if (e > 200)
		$FM_Flag_Building (palace, e, spot);
	else if (e > 110)
		$FM_Flag_Heroes (palace, e, spot, target);
	else if (e > 106)
		$FM_Flag_Heroes (palace, 132, spot, target);
	else if (e > 103)
		$FM_Flag_Guards (palace, e - 3, spot, target);
	else if (e > 100)
		$FM_Flag_Henchmen (palace, e, spot);
	else if ($IsValidGamePiece (target))
		$FM_Flag_Bodyguards (palace, e, target);
	else
		$FM_Flag_Monsters (palace, e, spot);
end

function FM_BG_Gone (agent t) is boolean
declare
begin
	if ($IsValidGamePiece (t) == FALSE)
		return TRUE;
	if ($isdead (t))
		return TRUE;
	return FALSE;
end

// The mode comes from comparing OWNER PLAYERS: the owner the summons get
// (faction picker: Friendly = your player, Hostile = #Monster_Player, Red = #Player_2,
// Green = #Player_3) against $GetUnitPlayerNumber of the flagged target.
// Same owner -> 1 bodyguard, different owner -> 2 attack. Monster-player things (monsters,
// lairs, wildlife, sewer rats, neutral map buildings) all belong to Hostile.
function FM_Flag_Bodyguards (agent palace, integer e, agent target)
declare
	integer i, n, made, alive, tries;
	string unitType;
	list got;
	agent u, m;
	coordinate spot;
	boolean hostile;
	integer mode;
	integer sp;
begin
	unitType = $ListMember ($FM_Type_List (), e);
	n = $FM_Count ();
	spot = $LocationOf (target);
	hostile = $FM_Is_Hostile ();
	sp = $GetUnitPlayerNumber (palace);
	if (hostile)
		sp = $FM_Host_Player (palace);
	mode = 2;
	if ($GetUnitPlayerNumber (target) == sp)
		mode = 1;
	alive = $ListSize ($FM_List_Allies (palace));
	made = 0;
	i = 0;
	while (i < n) do
		begin
			if (hostile)
				begin
					m = $FM_Spawn_Safe (palace, unitType, $RandomCoord (spot, 150), sp, "override");
					tries = 0;
					while ($IsValidGamePiece (m) == FALSE && tries < 2) do
						begin
							m = $FM_Spawn_Safe (palace, unitType, $RandomCoord (spot, 100, 250), sp, "override");
							tries = tries + 1;
						end
					if ($IsValidGamePiece (m))
						begin
							$FM_Hostile_Prep (m);
							$FM_Fac_Team (palace, m);
							$FM_Hostile_Bodyguard (m, target, mode, sp);
							made = made + 1;
						end
				end
			else if (alive + made < #FM_Max_Alive)
				begin
					got = $FM_Spawn_At (palace, unitType, spot);
					if ($ListSize (got) > 0)
						made = made + 1;
					foreach u in got do
						$FM_Make_Bodyguard (u, target, mode);
				end
			i = i + 1;
		end
	if (made == 0)
		begin
			if (hostile)
				$FM_Say (palace, "IDTXT_FMX_HFAIL");
			else if (alive >= #FM_Max_Alive)
				$FM_Say (palace, "IDTXT_FMX_CAP");
			else
				$FM_Say (palace, "IDTXT_FMX_FAIL");
			return;
		end
	if (hostile)
		$FM_Say_Owner (palace);
	if (unitType == "Strangleweed")
		$FM_Say (palace, "IDTXT_FMX_BG_ROOTED");
	else if (mode == 2)
		begin
			$FM_Say (palace, "IDTXT_FMX_MODE_ATTACK");
			$FM_Say (palace, $ListMember ($FM_BGA_Keys (), e));
		end
	else
		begin
			$FM_Say (palace, "IDTXT_FMX_MODE_GUARD");
			if (hostile)
				$FM_Say (palace, $ListMember ($FM_BGH_Keys (), e));
			else
				$FM_Say (palace, $ListMember ($FM_BGF_Keys (), e));
		end
	if (made < n)
		begin
			if (hostile)
				$FM_Say (palace, "IDTXT_FMX_HPARTIAL");
			else
				$FM_Say (palace, "IDTXT_FMX_PARTIAL");
		end
end

// Bodyguard / attacker (friendly ones: FM_Make_Friendly already ran; Hostile / Red / Green
// ones: FM_Hostile_Bodyguard saved their own AI first). mode 1 = BODYGUARD, mode 2 = ATTACK.
// The mode is stored on the unit (FM_BG_Mode) and a re-apply thread (FM_BG_Fn, every 1.5 s)
// restores our scripts if anything else overwrote them. The unit's own evaluationScript is
// kept in FM_OE: in ATTACK mode it is replaced by FM_BG_NoEval and "relentless" is TRUE, so
// monster_eval_enemies / target_out_of_range can't pull it off the flagged target (that is
// what made attackers wander off to peasants and guards instead).
function FM_Make_Bodyguard (agent u, agent target, integer mode)
declare
begin
	if ($isdead (u))
		return;
	u's "Coord_Home" = $LocationOf (u);
	if (u's "title" == "Strangleweed")
		return;
	u's "Leader" = target;
	if ($HasAttribute ("FM_BG_Mode", u) == FALSE)
		$AddAttribute (u, "FM_BG_Mode", "integer", 0);
	u's "FM_BG_Mode" = mode;
	// (values: literal in $AddAttribute, then assigned - see the FMCE_Count fix)
	if ($HasAttribute ("FM_OE", u) == FALSE)
		begin
			$AddAttribute (u, "FM_OE", "function", $FM_BG_NoEval);
			u's "FM_OE" = u's "evaluationScript";
		end
	$FM_BG_Scripts (u);
	if ($HasAttribute ("FM_BG_Fn", u) == FALSE)
		begin
			$AddAttribute (u, "FM_BG_Fn", "function", $FM_BG_Reapply);
			$NewThread (u's "FM_BG_Fn", 1500, u);
		end
end

function FM_BG_NoEval (agent thisagent)
declare
begin
end

// HOSTILE / Red / Green bodyguard or attacker: same loop as the friendly ones, but the
// unit keeps its owner and its own AI is saved (FM_OA/OB/OC scripts, FM_ORel relentless)
// and given back when the flagged target is gone (FM_BG_Restore).
function FM_Hostile_Bodyguard (agent m, agent target, integer mode, integer owner)
declare
	integer rel;
begin
	if ($isdead (m))
		return;
	if (m's "title" == "Strangleweed")
		return;
	if ($HasAttribute ("FM_BG_Own", m) == FALSE)
		begin
			rel = 0;
			if (m's "relentless" == TRUE)
				rel = 1;
			$AddAttribute (m, "FM_BG_Own", "integer", 0);
			$AddAttribute (m, "FM_ORel", "integer", 0);
			$AddAttribute (m, "FM_OA", "function", $FM_BG_NoEval);
			$AddAttribute (m, "FM_OB", "function", $FM_BG_NoEval);
			$AddAttribute (m, "FM_OC", "function", $FM_BG_NoEval);
			m's "FM_ORel" = rel;
			m's "FM_OA" = m's "ActiveScript";
			m's "FM_OB" = m's "BackScript";
			m's "FM_OC" = m's "BasicScript";
		end
	m's "FM_BG_Own" = owner;
	$FM_Make_Bodyguard (m, target, mode);
end

// target gone: a Hostile / Red / Green summon goes back to its own monster AI
function FM_BG_Restore (agent thisagent)
declare
begin
	thisagent's "target" = $NullAgent ();
	thisagent's "Leader" = $NullAgent ();
	thisagent's "Coord_Home" = $LocationOf (thisagent);
	thisagent's "relentless" = FALSE;
	if (thisagent's "FM_ORel" == 1)
		thisagent's "relentless" = TRUE;
	if ($HasAttribute ("FM_OE", thisagent))
		thisagent's "evaluationScript" = thisagent's "FM_OE";
	thisagent's "BasicScript" = thisagent's "FM_OC";
	thisagent's "BackScript" = thisagent's "FM_OB";
	thisagent's "ActiveScript" = thisagent's "FM_OC";
end

function FM_BG_Scripts (agent u)
declare
begin
	u's "target" = $NullAgent ();
	u's "ActiveScript" = $FM_Bodyguard_Loop;
	u's "BackScript" = $FM_Bodyguard_Loop;
	u's "BasicScript" = $FM_Bodyguard_Loop;
end

// Re-apply thread of a bodyguard/attacker (FM_BG_Mode 1/2; 0 = finished).
// Friendly: back to your player + our scripts if something replaced them (Reset_Controlled).
// Hostile / Red / Green (FM_BG_Own): if another side took it over (charm), it is left alone.
function FM_BG_Reapply (agent thisagent)
declare
	agent palace;
begin
	if ($isdead (thisagent))
		return;
	if (thisagent's "FM_BG_Mode" == 0)
		return;
	if ($HasAttribute ("FM_BG_Own", thisagent))
		begin
			if ($GetUnitPlayerNumber (thisagent) != thisagent's "FM_BG_Own")
				begin
					thisagent's "FM_BG_Mode" = 0;
					return;
				end
			if (thisagent's "BasicScript" != $FM_Bodyguard_Loop)
				$FM_BG_Scripts (thisagent);
			return;
		end
	palace = $FM_Palace ();
	if ($IsValidGamePiece (palace) == FALSE)
		return;
	if ($GetUnitPlayerNumber (thisagent) != $GetUnitPlayerNumber (palace))
		begin
			$FM_Make_Friendly (thisagent, palace, thisagent's "Coord_Home");
			$FM_BG_Scripts (thisagent);
			return;
		end
	if (thisagent's "BasicScript" != $FM_Bodyguard_Loop)
		$FM_BG_Scripts (thisagent);
end

// Behaviour of a bodyguard / attacker (modelled on familiar_skeleton,
// mx_Controlled_Monster.gpl:178):
// - target gone: FM_BG_Mode = 0; friendly -> normal summon guarding the spot where it stands
//   (FM_Friendly_Loop); Hostile / Red / Green -> its own AI again (FM_BG_Restore)
// - ATTACK mode: the target is the sticky attack target (monster_attack_object, re-set every
//   cycle, relentless, no evaluationScript); if the target hides in a building, it waits there
// - BODYGUARD mode: attack enemies seen by the summon itself within #FM_Guard_Range of the
//   target, else wander within 300 of it ($wander_near_leader: $RandomCoord (leader, 300))
function FM_Bodyguard_Loop (agent thisagent)
declare
	agent leader, real, t;
	list seen, enemies;
begin
	if ($isdead (thisagent))
		return;
	real = thisagent's "Leader";
	if ($FM_BG_Gone (real) || $HasAttribute ("FM_BG_Mode", thisagent) == FALSE)
		begin
			if ($HasAttribute ("FM_BG_Mode", thisagent))
				thisagent's "FM_BG_Mode" = 0;
			if ($HasAttribute ("FM_BG_Own", thisagent))
				begin
					$FM_BG_Restore (thisagent);
					return;
				end
			if ($HasAttribute ("FM_OE", thisagent))
				thisagent's "evaluationScript" = thisagent's "FM_OE";
			thisagent's "relentless" = FALSE;
			thisagent's "Coord_Home" = $LocationOf (thisagent);
			thisagent's "Leader" = $FM_Palace ();
			thisagent's "ActiveScript" = $FM_Friendly_Loop;
			thisagent's "BackScript" = $FM_Friendly_Loop;
			thisagent's "BasicScript" = $FM_Friendly_Loop;
			thisagent's "target" = $NullAgent ();
			return;
		end
	leader = real;
	if ($IsHidden (real))
		begin
			leader = $GetBuildingContainer (real);
			if ($IsValidGamePiece (leader) == FALSE)
				return;
		end
	if (thisagent's "FM_BG_Mode" == 2)
		begin
			thisagent's "relentless" = TRUE;
			thisagent's "evaluationScript" = $FM_BG_NoEval;
			if ($IsHidden (real) == FALSE)
				begin
					thisagent's "target" = real;
					thisagent's "activescript" = $monster_attack_object;
					thisagent's "backscript" = $monster_attack_object;
					return;
				end
		end
	else
		begin
			if ($HasAttribute ("FM_OE", thisagent))
				thisagent's "evaluationScript" = thisagent's "FM_OE";
			// enemies of THIS summon (its own team), near the target
			seen = $list_enemies_seen (thisagent, $GetAttribute (thisagent, #ATTRIB_SightRange) + #FM_Guard_Range);
			foreach t in seen do
				begin
					if ($DistanceBetweenAgents (t, leader) <= #FM_Guard_Range)
						enemies << t;
				end
			if ($ListSize (enemies) > 0)
				begin
					thisagent's "target" = $pick_closest (thisagent, enemies);
					if ($IsValidGamePiece (thisagent's "target"))
						begin
							thisagent's "activescript" = $monster_attack_object;
							thisagent's "backscript" = $monster_attack_object;
							return;
						end
				end
		end
	if ($IsMoving (thisagent) == FALSE)
		if ($DistanceBetweenAgents (thisagent, leader) > 150 || $RandomNumber (100) < 30)
			$Move (thisagent, $RandomCoord (leader, 300));
end

////////////////////////////////////////////////////////////////////////////////
// Elven Hideout (Building_Data.dat [Elven_Hideout], title ElvenHideout, birth
// hideout_birth -> activeScript hideout_active every 60 s). The original
// hideout_active fills the empty slots of its OWNER's Elven Bungalows with Elves
// of #Monster_player, i.e. a hideout of yours would turn your bungalows into
// enemy-elf spawners. Friendly hideout: replaced by this script, which runs the
// game's own guild generator (Lair.gpl Hero_Generator, used by the epic quests
// as a guild SpecialScript) on each of your Elven Bungalows: free elves of yours.
// Hostile hideout (monster player): original script; the monster player has no
// bungalows, so it is a plain enemy building (250 HP, drops gold/items).
function FM_Hideout_Friendly (agent thisagent)
declare
	list bl;
	agent b;
begin
	if ($isdead (thisagent))
		return;
	$ListObjects (thisagent, "building", -1, bl, #MyPlayer);
	bl = $ListTitles (bl, "Elven_bungalow");
	foreach b in bl do
		begin
			if ($isdead (b) == FALSE)
				$Hero_Generator (b);
		end
end

