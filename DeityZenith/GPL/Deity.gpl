////////////////////////////////////////////////////////////////////////////////
// ===== factions Red / Green =====
// FMCE_Faction = 7536640 + 0 Friendly (default) / 1 Hostile (monster player 7)
//                         / 2 Red (#Player_2 = player number 1) / 3 Green (#Player_3 = 2).
// Red / Green are the rival-kingdom player slots of the campaign quests (Magic Ring,
// Urban Renewal "red guilds", Siege: $GetPlayerTwoPalace = #Player_2; Clash of Empires:
// goblins #Player_2, rats #Player_3, owning lairs and monsters WITHOUT a palace).
// Monsters and lairs are spawned for that player (like Quests_1.gpl Clash_Empires
// SpawnUnit (..., #Player_2/3, ...)); the normal monster AI then fights everything
// #NotMyTeam, i.e. whoever that player is at war with. First use per game:
//  - player present on the map (palace, building, lair, hero or monster): nothing is
//    changed, the summons share its friends and enemies (FMB_FacT_x = 1)
//  - player absent (Freestyle, most quests): like Clash_Empires, the player gets its own
//    team ($SetPlayerTeamNumber (unit, $NewTeamNumber ())) = at war with everyone
//    (FMB_FacT_x = 3 pending until the first unit exists, then 2).
// Buildings and guards stay yours (they need a palace).
function FMB_Fac () is integer
declare
	agent root;
begin
	root = $FMB_Root ();
	return $FMB_Decode (root's "FMCE_Faction", 7536640, 0, 3, 0);
end

function FMB_Fac_Present (agent palace, integer p) is boolean
declare
	list l, all;
	agent a;
	boolean found;
begin
	found = FALSE;
	all = $ListPalaces ();
	foreach a in all do
		begin
			if ($GetUnitPlayerNumber (a) == p)
				found = TRUE;
		end
	if (found)
		return TRUE;
	$ListObjects (palace, "building", -1, l, #NotMyPlayer, #NoHiddenMap);
	all = $AddLists (all, l);
	$ListObjects (palace, "Lair", -1, l, #NotMyPlayer, #NoHiddenMap);
	all = $AddLists (all, l);
	$ListObjects (palace, "hero", -1, l, #NotMyPlayer, #NoHiddenMap);
	all = $AddLists (all, l);
	$ListObjects (palace, "monster", -1, l, #NotMyPlayer, #NoHiddenMap);
	all = $AddLists (all, l);
	foreach a in all do
		begin
			if ($GetUnitPlayerNumber (a) == p)
				found = TRUE;
		end
	return found;
end

// player number for non-friendly summons; decides Red / Green presence once per game
function FMB_Host_Player (agent palace) is integer
declare
	agent root;
	integer f;
begin
	f = $FMB_Fac ();
	if (f < 2)
		return #Monster_Player;
	root = $FMB_Root ();
	if (f == 2)
		begin
			if ($HasAttribute ("FM_FacT_2", root) == FALSE)
				$AddAttribute (root, "FM_FacT_2", "integer", 0);
			if (root's "FM_FacT_2" == 1 || root's "FM_FacT_2" == 2)
				return #Player_2;
			if ($FMB_Fac_Present (palace, #Player_2))
				begin
					root's "FM_FacT_2" = 1;
					$FMB_Say (palace, "IDTXT_FMB_FACIN_2");
					return #Player_2;
				end
			root's "FM_FacT_2" = 4;
			$FMB_Say (palace, "IDTXT_FMB_FACNO_2");
			return #Monster_Player;
		end
	if ($HasAttribute ("FM_FacT_3", root) == FALSE)
		$AddAttribute (root, "FM_FacT_3", "integer", 0);
	if (root's "FM_FacT_3" == 1 || root's "FM_FacT_3" == 2)
		return #Player_3;
	if ($FMB_Fac_Present (palace, #Player_3))
		begin
			root's "FM_FacT_3" = 1;
			$FMB_Say (palace, "IDTXT_FMB_FACIN_3");
			return #Player_3;
		end
	root's "FM_FacT_3" = 4;
	$FMB_Say (palace, "IDTXT_FMB_FACNO_3");
	return #Monster_Player;
end

// after the first Red / Green unit exists: own team if the player was absent
function FMB_Fac_Team (agent palace, agent u)
declare
	agent root;
	integer f;
begin
	f = $FMB_Fac ();
	if (f < 2)
		return;
	if ($IsValidGamePiece (u) == FALSE)
		return;
	root = $FMB_Root ();
	if (f == 2)
		begin
			if ($HasAttribute ("FM_FacT_2", root))
				if (root's "FM_FacT_2" == 3)
					begin
						$SetPlayerTeamNumber (u, $NewTeamNumber ());
						root's "FM_FacT_2" = 2;
						$FMB_Say (palace, "IDTXT_FMB_FACNEW_2");
					end
			return;
		end
	if ($HasAttribute ("FM_FacT_3", root))
		if (root's "FM_FacT_3" == 3)
			begin
				$SetPlayerTeamNumber (u, $NewTeamNumber ());
				root's "FM_FacT_3" = 2;
				$FMB_Say (palace, "IDTXT_FMB_FACNEW_3");
			end
end

// owner line only when Red / Green is really used (FMB_Host_Player ran before)
function FMB_Say_Owner (agent palace)
declare
	integer f;
	agent root;
begin
	f = $FMB_Fac ();
	root = $FMB_Root ();
	if (f == 2)
		begin
			if ($HasAttribute ("FM_FacT_2", root))
				if (root's "FM_FacT_2" == 1 || root's "FM_FacT_2" == 2)
					$FMB_Say (palace, "IDTXT_FMB_OWNER_2");
		end
	else if (f == 3)
		begin
			if ($HasAttribute ("FM_FacT_3", root))
				if (root's "FM_FacT_3" == 1 || root's "FM_FacT_3" == 2)
					$FMB_Say (palace, "IDTXT_FMB_OWNER_3");
		end
end

////////////////////////////////////////////////////////////////////////////////
// ===== Dark Palace (EvilPalace) spawned by the mod =====
// Stock Palace_Death (mx_Building_Deaths.gpl:173) calls $declareloss when the owner has no
// Outpost: that is what ends the game. Defeat is GPL-side: the stock Outpost path skips
// $declareloss and the game goes on. Our copy gets its own death script (rubble, no loss,
// no player cleanup) and a non-"Palace" title, so $GetTruePalace / building births /
// peasants' build queue keep using the real Palace. The campaign's own Dark Palace is not
// touched (only the agent we spawn is changed).
function FMB_DarkPalace_Death (agent thisagent)
declare
	list l;
	agent u;
begin
	thisagent's "type" = "Dead";
	// a palace of another side (never yours: #Player_1, as FMB_Palace): its guards are released
	if ($GetUnitPlayerNumber (thisagent) != #Player_1)
		$FMB_HG_Release (thisagent);
	l = $GetBuildingContents (thisagent);
	foreach u in l do
		begin
			if ($IsDead (u) == FALSE)
				$Exit_Building (u, thisagent);
		end
	$performaction (thisagent, "Become_Rubble", thisagent);
	$deleteagent (thisagent);
end

function FMB_DarkPalace_Idle (agent thisagent)
declare
begin
end

function FMB_DarkPalace_Prep (agent b, integer owner)
declare
begin
	b's "IGdeathScript" = $FMB_DarkPalace_Death;
	b's "title" = "Deity_DarkPalace";
	// palace_revenue would pay a second palace income
	if ($IsRunning (b's "activeScript"))
		$KillThread (b's "activeScript");
	b's "activeScript" = $FMB_DarkPalace_Idle;
	// monsters get no peasants / tax collectors
	if (owner == #Monster_Player)
		begin
			if ($IsRunning (b's "Tax_spawn"))
				$KillThread (b's "Tax_spawn");
			if ($IsRunning (b's "peasant_spawn"))
				$KillThread (b's "peasant_spawn");
			b's "Tax_spawn" = $FMB_DarkPalace_Idle;
			b's "peasant_spawn" = $FMB_DarkPalace_Idle;
		end
end

// A Dark Palace or Palace made by Deity Zenith within 300 of the spot, else null.
// $ListObjects (palace, "building", -1, list) without filters = buildings of every player.
function FMB_DP_Near (agent palace, coordinate spot) is agent
declare
	list l;
	agent b, best;
	integer d, bd;
begin
	best = $NullAgent ();
	bd = 301;
	$ListObjects (palace, "building", -1, l);
	foreach b in l do
		begin
			if ($FMB_Is_Mod_Palace (b))
				if ($IsDead (b) == FALSE)
					begin
						d = $DistanceBetweenCoords ($LocationOf (b), spot);
						if (d < bd)
							begin
								bd = d;
								best = b;
							end
					end
		end
	return best;
end

////////////////////////////////////////////////////////////////////////////////
// ===== Palace (Palace3) spawned by the mod =====
// Same death script as the mod's Dark Palace (no $declareloss, no player cleanup; the stock
// Palace_Death of BOTH rulesets declares the loss), title "Deity_Palace" (so $GetTruePalace,
// title checks of peasants / tax collectors / building births / Building_Guard / quest
// scripts don't see a palace), and for every owner: no palace income, no tax collectors,
// no peasants, no palace guards (Palace_Birth started palace_revenue and scheduled
// Guard_Spawn_Function / Tax_spawn / peasant_spawn).
function FMB_ModPalace_Prep (agent b, integer owner)
declare
begin
	b's "IGdeathScript" = $FMB_DarkPalace_Death;
	b's "title" = "Deity_Palace";
	if ($IsRunning (b's "activeScript"))
		$KillThread (b's "activeScript");
	b's "activeScript" = $FMB_DarkPalace_Idle;
	if ($IsRunning (b's "Tax_spawn"))
		$KillThread (b's "Tax_spawn");
	if ($IsRunning (b's "peasant_spawn"))
		$KillThread (b's "peasant_spawn");
	if ($IsRunning (b's "Guard_Spawn_Function"))
		$KillThread (b's "Guard_Spawn_Function");
	b's "Tax_spawn" = $FMB_DarkPalace_Idle;
	b's "peasant_spawn" = $FMB_DarkPalace_Idle;
	b's "Guard_Spawn_Function" = $FMB_DarkPalace_Idle;
end

function FMB_Is_Mod_Palace (agent b) is boolean
declare
begin
	if ($IsValidGamePiece (b) == FALSE)
		return FALSE;
	if (b's "title" == "Deity_Palace" || b's "title" == "Deity_DarkPalace")
		return TRUE;
	return FALSE;
end

// A player's palace slot (engine; $ListPalaces / $GetPalace) is filled lazily with the
// player's first palace-family unit when it is empty, and the engine's game-start scan
// (after InitializeGpl, exe 0x428875) takes the last palace-family unit per player. If a slot
// ever holds a mod palace while that player still has a real one (title "Palace"),
// it is set back with $SetPalace (as the stock Outpost code in Palace_Death does).
function FMB_Fix_Slot (agent p) is agent
declare
	list l;
	agent b;
begin
	if ($FMB_Is_Mod_Palace (p) == FALSE)
		return p;
	$ListObjects (p, "building", -1, l, #CheckTitles, "Palace", #MyPlayer);
	foreach b in l do
		begin
			if ($IsDead (b) == FALSE)
				if (b's "title" == "Palace")
					begin
						$SetPalace (b, $GetUnitPlayerNumber (b));
						return b;
					end
		end
	return p;
end


////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////
// Original ruleset: GPL/LowLevel.gpl NewUnitInit runs the birth script LATER ($RunThread
// (newAgent's "birthScript", 1, newAgent)), i.e. after our set-up, and births such as
// Skeleton_Birth / Ratman_Birth + Sleeper_Birth give the unit its monster AI again.
// The pending thread calls the unit's "birthScript" attribute when it fires (game threads follow
// the attribute, e.g. pet_ready / monster_gravestone change "ActiveScript" of a running thread):
// we swap it for FMB_Birth_Wrap = real birth, then our set-up. A watchdog thread (1 s) is the
// fallback and repairs friendly summons that the game turns back later.
// kind 1 = friendly summon, 2 = Hostile / Red / Green summon, 3 = lair / building
function FMB_Arm (agent m, integer kind, agent target)
declare
	agent root;
begin
	if ($isdead (m))
		return;
	root = $FMB_Root ();
	if ($HasAttribute ("FM_AB", m) == FALSE)
		begin
			$AddAttribute (m, "FM_AB", "integer", 0);
			$AddAttribute (m, "FM_AB_T", "agent", $NullAgent ());
			$AddAttribute (m, "FM_AB_Q2", "boolean", FALSE);
			$AddAttribute (m, "FM_AB_Q4", "boolean", FALSE);
			$AddAttribute (m, "FM_AB_Done", "integer", 0);
			$AddAttribute (m, "FM_AB_N", "integer", 0);
			$AddAttribute (m, "FM_AB_Birth", "function", $FMB_BG_NoEval);
			m's "FM_AB_Q2" = root's "Quest_Flag_2";
			m's "FM_AB_Q4" = root's "Quest_Flag_4";
			m's "FM_AB_Birth" = m's "birthScript";
			m's "birthScript" = $FMB_Birth_Wrap;
			m's "FM_AB" = kind;
			m's "FM_AB_T" = target;
			return;
		end
	m's "FM_AB" = kind;
	m's "FM_AB_T" = target;
end

// the delayed birth thread lands here (Original only)
function FMB_Birth_Wrap (agent m)
declare
begin
	if ($HasAttribute ("FM_AB_Birth", m))
		begin
			m's "birthScript" = m's "FM_AB_Birth";
			if ($ValidFunction (m's "FM_AB_Birth"))
				(m's "FM_AB_Birth") (m);
		end
	if ($isdead (m))
		return;
	if ($HasAttribute ("FM_AB", m))
		begin
			$FMB_After_Birth (m);
			$FMB_AB_Note (m, "IDTXT_FMB_AB_WRAP");
		end
end

function FMB_AB_Note (agent m, string key)
declare
	agent root, palace;
begin
	root = $FMB_Root ();
	if ($HasAttribute ("FM_AB_Notes", root) == FALSE)
		$AddAttribute (root, "FM_AB_Notes", "integer", 0);
	if (root's "FM_AB_Notes" >= 3)
		return;
	root's "FM_AB_Notes" = root's "FM_AB_Notes" + 1;
	palace = $FMB_Palace ();
	if ($IsValidGamePiece (palace))
		$FMB_Say (palace, key);
end

// watchdog, every second, for each summon
// Old per-summon watchdog. No longer started (the guard on GplAIRoot does this job);
// kept by name only because summons in older saves may still carry a thread pointing here.
function FMB_AB_Tick (agent m)
declare
begin
	return;
end

function FMB_After_Birth (agent m)
declare
	agent palace, root, t;
	list extra;
	coordinate home;
begin
	if ($isdead (m))
		return;
	root = $FMB_Root ();
	if (m's "FM_AB_Done" == 0)
		begin
			// quest bookkeeping written by births (url_shekk_birth: flag 4, tomb_birth: flag 2)
			if (m's "title" == "Url_Shekk")
				root's "Quest_Flag_4" = m's "FM_AB_Q4";
			if (m's "title" == "Dragon_Tomb")
				root's "Quest_Flag_2" = m's "FM_AB_Q2";
		end
	m's "FM_AB_Done" = 1;
	if (m's "FM_AB" == 3)
		return;
	t = m's "FM_AB_T";
	if (m's "FM_AB" == 1)
		begin
			palace = $FMB_Palace ();
			if ($IsValidGamePiece (palace) == FALSE)
				return;
			home = $LocationOf (m);
			if ($HasAttribute ("Coord_Home", m))
				if ($FMB_Has_Anchor (m))
					home = m's "Coord_Home";
			$FMB_Make_Friendly (m, palace, home);
			if (m's "title" == "Liche_Queen" || m's "title" == "Witch_King")
				extra = $FMB_Fix_Boss (m, palace, $LocationOf (m));
		end
	else
		$FMB_Hostile_Prep (m);
	if ($HasAttribute ("FM_BG_Mode", m) == FALSE)
		return;
	if (m's "FM_BG_Mode" <= 0 || $IsValidGamePiece (t) == FALSE)
		return;
	// Hostile / Red / Green: the AI it goes back to afterwards is the one its birth gave it
	if ($HasAttribute ("FM_BG_Own", m))
		if (m's "BasicScript" != $FMB_Bodyguard_Loop)
			begin
				m's "FM_OA" = m's "ActiveScript";
				m's "FM_OB" = m's "BackScript";
				m's "FM_OC" = m's "BasicScript";
			end
	m's "Leader" = t;
	$FMB_BG_Scripts (m);
end

////////////////////////////////////////////////////////////////////////////////
// ===== Original rules: friendly-monster guard =====
// One thread on GplAIRoot's "MusicScript": a function attribute DECLARED in the AIRoot prototype
// (GPL/prototype.gpl), the kind of attribute the game's own quest threads use
// (VictoryCondition, SpecialSpawnScript). Neither the game's GPL nor the exe uses "MusicScript".
// Every 0.7 s: status lines for the Cheat Engine values, then
//  - every Type "monster" unit of yours (monster prototype) gets the Control Monster set-up
//    (summons a delayed birth turned back, children of your lairs, Liche Queen minions, ...);
//  - every friendly summon of ours (SubType "Controlled", FM_AB 1) whose AI or side was replaced
//    (Ratman_Birth -> Sleeper_Raider attacks ANY building, Skeleton_Birth -> Monster_follow, Witch
//    King raiders) is set up again.
// GplAIRoot integers: FMB_G_Say (print the "on" line), FMB_G_Busy (1/2 = a set-up is running;
// still set on the next tick = it stopped part-way), FMB_G_Fix / FMB_G_Stop (chat limits),
// FMB_G_N (thread starts, max 20 per game).
function FMB_Guard_Init (boolean newgame)
declare
	agent root;
begin
	root = $RetrieveAgent ("GplAIRoot");
	if ($HasAttribute ("FMB_G_Say", root) == FALSE)
		begin
			$AddAttribute (root, "FMB_G_Say", "integer", 0);
			$AddAttribute (root, "FMB_G_Busy", "integer", 0);
			$AddAttribute (root, "FMB_G_Fix", "integer", 0);
			$AddAttribute (root, "FMB_G_Stop", "integer", 0);
			$AddAttribute (root, "FMB_G_N", "integer", 0);
		end
	if (newgame)
		begin
			root's "FMB_G_Busy" = 0;
			root's "FMB_G_Fix" = 0;
			root's "FMB_G_Stop" = 0;
			root's "FMB_G_N" = 0;
		end
end

function FMB_Guard_Running () is boolean
declare
	agent root;
begin
	root = $RetrieveAgent ("GplAIRoot");
	if ($IsRunning (root's "MusicScript") == FALSE)
		return FALSE;
	if (root's "MusicScript" != $FMB_Guard_Tick)
		return FALSE;
	return TRUE;
end

function FMB_Guard_Start ()
declare
begin
	return;
end

// the friendly AI / side of one of our summons was replaced
function FMB_Guard_Bad (agent u) is boolean
declare
begin
	if (u's "Type" != "Hero" || u's "EnemyType" != "Monster")
		return TRUE;
	if (u's "BasicScript" != $FMB_Friendly_Loop && u's "BasicScript" != $FMB_Bodyguard_Loop)
		return TRUE;
	if ($HasAttribute ("FM_BG_Mode", u))
		if (u's "FM_BG_Mode" > 0 && $IsValidGamePiece (u's "FM_AB_T"))
			if (u's "Leader" != u's "FM_AB_T")
				return TRUE;
	// its own AI thread: normally started by its (delayed) birth; FM_AB_Done 0 = birth not seen yet
	if (u's "FM_AB_Done" == 0)
		begin
			u's "FM_AB_N" = u's "FM_AB_N" + 1;
			if (u's "FM_AB_N" < 4)
				return FALSE;
		end
	if ($IsRunning (u's "ActiveScript") == FALSE)
		return TRUE;
	return FALSE;
end

// marks a unit we did not spawn ourselves (lair child, boss minion) as one of our friendly summons
function FMB_Mark (agent u)
declare
begin
	if ($HasAttribute ("FM_AB", u))
		return;
	$AddAttribute (u, "FM_AB", "integer", 0);
	$AddAttribute (u, "FM_AB_T", "agent", $NullAgent ());
	$AddAttribute (u, "FM_AB_Q2", "boolean", FALSE);
	$AddAttribute (u, "FM_AB_Q4", "boolean", FALSE);
	$AddAttribute (u, "FM_AB_Done", "integer", 0);
	$AddAttribute (u, "FM_AB_N", "integer", 0);
	u's "FM_AB" = 1;
	u's "FM_AB_Done" = 1;
end

function FMB_Guard_Fix (agent u)
declare
begin
	$FMB_Mark (u);
	u's "FM_AB" = 1;
	$FMB_After_Birth (u);
	// the unit's own AI thread (normally started by its birth script)
	if ($IsRunning (u's "ActiveScript") == FALSE)
		$NewThread (u's "ActiveScript", #Normal_Cycle, u);
end

function FMB_Guard_Tick (agent thisagent)
declare
begin
	return;
end

// Old palace guard thread. No longer started; kept by name for older saves (the thread may still
// point here): it only hands over to the guard on GplAIRoot.
function FMB_Conv_Tick (agent thisagent)
declare
begin
	return;
end

////////////////////////////////////////////////////////////////////////////////
// Original rules: step 2 of a flag, post-birth check, diagnostics, quest flags.
// Only built-in attributes and integer attributes on GplAIRoot are written here.
function FMB_Diag_Init (boolean newgame)
declare
	agent root;
begin
	root = $FMB_Root ();
	if ($HasAttribute ("FMB_N1", root) == FALSE)
		begin
			$AddAttribute (root, "FMB_N1", "integer", 0);
			$AddAttribute (root, "FMB_N2", "integer", 0);
			$AddAttribute (root, "FMB_NF", "integer", 0);
			$AddAttribute (root, "FMB_Q2P", "integer", 0);
			$AddAttribute (root, "FMB_Q2V", "integer", 0);
			$AddAttribute (root, "FMB_Q4P", "integer", 0);
			$AddAttribute (root, "FMB_Q4V", "integer", 0);
		end
	if (newgame)
		begin
			root's "FMB_N1" = 0;
			root's "FMB_N2" = 0;
			root's "FMB_NF" = 0;
		end
end

// short step lines, at most 3 of each per game
function FMB_Note (agent palace, integer which)
declare
	agent root;
begin
	$FMB_Diag_Init (FALSE);
	root = $FMB_Root ();
	if (which == 1)
		begin
			if (root's "FMB_N1" >= 3)
				return;
			root's "FMB_N1" = root's "FMB_N1" + 1;
			$FMB_Say (palace, "IDTXT_FMB_ST1");
			return;
		end
	if (which == 2)
		begin
			if (root's "FMB_N2" >= 3)
				return;
			root's "FMB_N2" = root's "FMB_N2" + 1;
			$FMB_Say (palace, "IDTXT_FMB_ST2");
			return;
		end
	if (root's "FMB_NF" >= 3)
		return;
	root's "FMB_NF" = root's "FMB_NF" + 1;
	$FMB_Say (palace, "IDTXT_FMB_STFIX");
end

// Url_Shekk_Birth sets Quest_flag_4 (Monster_Births.gpl:237) and the Dragon_Tomb birth clears
// Quest_flag_2 (Building_Births.gpl:969). Original births run 1 ms AFTER the spawn, so the value is
// saved here and put back in step 2 of the flag.
function FMB_Q_Save (string unitType)
declare
	agent root;
begin
	$FMB_Diag_Init (FALSE);
	root = $FMB_Root ();
	if ($HasAttribute ("FMB_Q3P", root) == FALSE)
		begin
			$AddAttribute (root, "FMB_Q3P", "integer", 0);
			$AddAttribute (root, "FMB_Q3V", "integer", 0);
		end
	if (unitType == "Hooligan")
		begin
			if (root's "FMB_Q3P" == 0)
				begin
					root's "FMB_Q3P" = 1;
					root's "FMB_Q3V" = 0;
					if (root's "Quest_Flag_3" == TRUE)
						root's "FMB_Q3V" = 1;
				end
			root's "Quest_Flag_3" = FALSE;
		end
	if (unitType == "Url_Shekk" && root's "FMB_Q4P" == 0)
		begin
			root's "FMB_Q4P" = 1;
			root's "FMB_Q4V" = 0;
			if (root's "Quest_Flag_4" == TRUE)
				root's "FMB_Q4V" = 1;
		end
	if (unitType == "Dragon_Tomb" && root's "FMB_Q2P" == 0)
		begin
			root's "FMB_Q2P" = 1;
			root's "FMB_Q2V" = 0;
			if (root's "Quest_Flag_2" == TRUE)
				root's "FMB_Q2V" = 1;
		end
end

function FMB_Q_Restore ()
declare
	agent root;
begin
	$FMB_Diag_Init (FALSE);
	root = $FMB_Root ();
	if ($HasAttribute ("FMB_Q3P", root))
		if (root's "FMB_Q3P" == 1)
			begin
				root's "FMB_Q3P" = 0;
				if (root's "FMB_Q3V" == 1)
					root's "Quest_Flag_3" = TRUE;
				else
					root's "Quest_Flag_3" = FALSE;
			end
	if (root's "FMB_Q4P" == 1)
		begin
			root's "FMB_Q4P" = 0;
			if (root's "FMB_Q4V" == 1)
				root's "Quest_Flag_4" = TRUE;
			else
				root's "Quest_Flag_4" = FALSE;
		end
	if (root's "FMB_Q2P" == 1)
		begin
			root's "FMB_Q2P" = 0;
			if (root's "FMB_Q2V" == 1)
				root's "Quest_Flag_2" = TRUE;
			else
				root's "Quest_Flag_2" = FALSE;
		end
end

function FMB_Is_Sleeper (agent m) is boolean
declare
begin
	if (m's "title" == "Dragon" || m's "title" == "IceDragon" || m's "title" == "Ratman" || m's "title" == "Vendral")
		return TRUE;
	return FALSE;
end

// a friendly summon that a birth script (or anything else) took off the friendly set-up
function FMB_Friendly_Bad (agent u) is boolean
declare
begin
	if (u's "Type" != "Hero" || u's "EnemyType" != "Monster")
		return TRUE;
	if (u's "BasicScript" != $FMB_Friendly_Loop && u's "BasicScript" != $FMB_Bodyguard_Loop)
		return TRUE;
	if ($FMB_Is_Sleeper (u))
		if ($IsRunning (u's "SleeperScript"))
			return TRUE;
	if ($CheckEffector (u, "Charm_icon") == FALSE)
		return TRUE;
	return FALSE;
end

// start: TRUE only after the birth scripts ran (flag step 2); the birth itself starts ActiveScript
function FMB_Refriend (agent u, agent palace, agent target, coordinate home, boolean start)
declare
	integer k;
begin
	if ($isdead (u))
		return;
	k = u's "Target_Item";
	if ($FMB_Is_Sleeper (u))
		if ($IsRunning (u's "SleeperScript"))
			$KillThread (u's "SleeperScript");
	$FMB_Make_Friendly (u, palace, home);
	if (k == 9171 || k == 9172)
		if ($FMB_BG_Gone (target) == FALSE)
			begin
				u's "Leader" = target;
				$FMB_BG_Scripts (u);
			end
	if (start)
		if ($IsRunning (u's "ActiveScript") == FALSE)
			$NewThread (u's "ActiveScript", #Normal_Cycle, u);
end

function FMB_Hostile_Mark (agent m)
declare
begin
	if ($isdead (m))
		return;
	m's "Target_Item" = 9175;
	m's "IGDeathScript" = $Monster_Gravestone;
end

function FMB_Hostile_Fix (agent u, agent target)
declare
	integer k;
begin
	k = u's "Target_Item";
	$FMB_Hostile_Prep (u);
	if (k == 9173 || k == 9174)
		if ($FMB_BG_Gone (target) == FALSE)
			if (u's "title" != "Strangleweed")
				begin
					u's "Leader" = target;
					$FMB_BG_Scripts (u);
				end
	if ($IsRunning (u's "ActiveScript") == FALSE)
		$NewThread (u's "ActiveScript", #Normal_Cycle, u);
end

// returns how many friendly summons had to be set up again
function FMB_Fix_List (agent palace, list l, agent target, coordinate home) is integer
declare
	agent u;
	integer n, k, me;
begin
	n = 0;
	me = $GetUnitPlayerNumber (palace);
	foreach u in l do
		begin
			if ($isdead (u) == FALSE)
				if ($HasAttribute ("SleeperScript", u))
					begin
						k = u's "Target_Item";
						if (k >= 9173 && k <= 9175)
							$FMB_Hostile_Fix (u, target);
						else if ($GetUnitPlayerNumber (u) == me)
							begin
								if ($FMB_Friendly_Bad (u))
									begin
										$FMB_Refriend (u, palace, target, home, TRUE);
										n = n + 1;
									end
								else if ($IsRunning (u's "ActiveScript") == FALSE)
									$NewThread (u's "ActiveScript", #Normal_Cycle, u);
							end
					end
		end
	return n;
end

// step 2 of an explore / attack flag: the flag goes first, nothing below can keep it on the map
function FMB_Flag_Finish (agent thisagent, agent target)
declare
	agent palace;
	list mons, mine, hoos, hgs;
	coordinate spot;
	integer n;
begin
	palace = $FMB_Palace ();
	spot = $LocationOf (thisagent);
	if ($IsValidGamePiece (palace))
		begin
			$ListObjects (thisagent, "monster", 900, mons, #InsideOtherUnits);
			$ListObjects (thisagent, "hero", 900, mine, #InsideOtherUnits, #MyPlayer);
			$ListObjects (thisagent, "Hooligan", 900, hoos, #InsideOtherUnits);
			// hostile guards of another side (only while some wait for step 2)
			if ($FMB_HG_Pending ())
				$ListObjects (thisagent, "hero", 900, hgs, #InsideOtherUnits, #NotMyPlayer);
		end
	$DeleteGamePiece (thisagent);
	if ($IsValidGamePiece (palace) == FALSE)
		return;
	$FMB_Q_Restore ();
	$FMB_Hero_Finish (mons, mine, hoos, target, spot);
	if ($ListSize (hgs) > 0)
		if ($FMB_HG_Finish (hgs, target) > 0)
			$FMB_HG_Count (-1);
	n = $FMB_Fix_List (palace, mons, target, spot);
	n = n + $FMB_Fix_List (palace, mine, target, spot);
	if (n > 0)
		$FMB_Note (palace, 3);
	$FMB_Note (palace, 2);
end

// Lairs of yours: the lair's own built-in thread slots (Spawn_Function, activeScript) run the sweep.
// lair_birth (Building_Births.gpl:723) starts both with $NewThread, so a value set before the birth
// is what the game starts; on a lair that already runs the switch happens on its next cycle.
function FMB_Lair_Spawn (agent thisagent)
declare
	agent palace;
begin
	$Spawn (thisagent);
	if ($isdead (thisagent))
		return;
	palace = $FMB_Palace ();
	if ($IsValidGamePiece (palace) == FALSE)
		return;
	if ($GetUnitPlayerNumber (thisagent) != $GetUnitPlayerNumber (palace))
		return;
	$FMB_Lair_Sweep (thisagent, palace);
end

function FMB_Lair_Brain (agent thisagent)
declare
	agent palace;
begin
	$Lair_Brains (thisagent);
	if ($isdead (thisagent))
		return;
	palace = $FMB_Palace ();
	if ($IsValidGamePiece (palace) == FALSE)
		return;
	if ($GetUnitPlayerNumber (thisagent) != $GetUnitPlayerNumber (palace))
		return;
	$FMB_Lair_Sweep (thisagent, palace);
end

////////////////////////////////////////////////////////////////////////////////
// ===== Heroes: entries 111.., after the guards =====
// Blue (faction 0): spawned by your Palace, owned by you - the way the game's own scripts give the
// player heroes (epic_quest_scripts.gpl:920/2314, Random_Events.gpl:261 "Veteran heroes"). hero_birth
// sees the Palace as parent and leaves "home" EMPTY ("a real, genuine palace ... doesn't have hero
// slots", mx_Hero_Births.gpl:196 / Hero_Births.gpl:179): no guild; go_home / defend_home / flee /
// Healer reborn all skip an empty home. Normal hero AI: explores, takes bounties, levels up.
// No charm icon, no Control_Monster set-up: Type stays "hero", so no Deity Zenith loop / lair sweep /
// post-birth check touches it (they only list Type "monster" units, "Controlled" heroes or units
// with the monster prototype's Target_Item / SleeperScript).
// Hostile / Red / Green: the game's own hostile-hero set-up (hero_birth, Fertile Plain monster-player
// heroes): owner = that side, Type "monster", EnemyType "hero", raider AI, monster_eval_enemies,
// Raider_respond. Your heroes and guards hunt Type "monster" units in both rulesets.
// Attack flag: same side comparison as the monster bodyguards (owner of the summons vs owner of the
// target): other side -> they attack it (heroes: attack_object, hostile heroes: raider with that
// target); same side -> they only appear next to it.
// Hooligan (Wizard's Curse henchman, monster prototype, Type "Hooligan"): Blue = wanders around the
// flag (its own hooligan_basic); Hostile = the quest's book thief (Hooligan_birth Quest_Flag_3
// branch): Guardian AI, Type Monster, level 10, 40 HP, its 4 spells. Quest_Flag_3 is kept FALSE for
// its birth because that branch also gives YOUR Palace a new team.
function FMB_Hero_List () is list
declare
	list L;
begin
	L << "Warrior";
	L << "Ranger";
	L << "Rogue";
	L << "Wizard";
	L << "Healer";
	L << "Monk";
	L << "Paladin";
	L << "Priestess";
	L << "Cultist";
	L << "Adept";
	L << "Solarus";
	L << "Barbarian";
	L << "Warrior_of_Discord";
	L << "Dwarf";
	L << "Elf";
	L << "Gnome";
	L << "Wizard";
	L << "Priestess";
	L << "Cultist";
	L << "Warrior_of_Discord";
	L << "Hooligan";
	return L;
end

