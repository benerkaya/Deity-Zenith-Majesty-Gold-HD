function FMB_Hero_Hostile (agent m)
declare
begin
	if ($isdead (m))
		return;
	m's "Type" = "monster";
	m's "EnemyType" = "hero";
	m's "StartingScript" = $raider;
	m's "BasicScript" = $raider;
	m's "BackScript" = $raider;
	m's "ActiveScript" = $raider;
	m's "evaluationScript" = $monster_eval_enemies;
	m's "Raider_respond" = TRUE;
	m's "target" = $NullAgent ();
end

function FMB_Hooligan_Hostile (agent m, coordinate spot)
declare
begin
	if ($isdead (m))
		return;
	m's "Type" = "Monster";
	m's "Subtype" = "Monster";
	m's "ActiveScript" = $Guardian;
	m's "BasicScript" = $Guardian;
	m's "BackScript" = $Guardian;
	m's "StartingScript" = $Guardian;
	m's "Coord_Home" = spot;
	m's "Target_Item" = 9177;
	$LearnSpell (m, "Power_Shock");
	$LearnSpell (m, "Flame_Shield");
	$LearnSpell (m, "Teleport");
	$LearnSpell (m, "Resist_Magic");
	$SetAttribute (m, #ATTRIB_ExperienceLevel, 10);
	$SetAttribute (m, #ATTRIB_MaxHP, 40);
	$SetAttribute (m, #ATTRIB_HP, 40);
	$SetAttribute (m, #ATTRIB_NotFlaggable, 0);
	$SetAttribute (m, #ATTRIB_NotSpellTarget, 0);
end

// quest heroes: the same steps the quest scripts use
//   Angry Wizard: High_Level_Hero_Birth (Wizard's Curse): level 20, 50 HP, armour +4, Fire Blast,
//   Meteor Storm, 5 healing potions. Scions of Chaos (Quests_2.gpl:350/388/473): level 35, +100 HP
//   (Priestess) / +200 HP (Cultist), resist_critical, title "Scion" (hostile ones only: the title
//   is what the quest gives its enemies; a Blue one keeps its class title for its class AI).
//   Gnome Champion: a Gnome advanced to level 8 = the game's own promotion (Expansion only).
function FMB_Hero_Setup (agent m, string rc, boolean hostile, coordinate spot)
declare
begin
	if ($isdead (m))
		return;
	if (rc == "hool")
		begin
			if (hostile)
				$FMB_Hooligan_Hostile (m, spot);
			else
				begin
					m's "Coord_Home" = spot;
					m's "Target_Item" = 9176;
				end
			return;
		end
	if (rc == "champ")
		$advance_to_level (m, 8);
	if (rc == "angry")
		begin
			$advance_to_level (m, 20);
			$SetAttribute (m, #ATTRIB_MaxHP, 50);
			$SetAttribute (m, #ATTRIB_HP, 50);
			$AdjustAttribute (m, #attrib_Armor_basic_damage, 4);
			$LearnSpell (m, "Fire_Blast");
			$LearnSpell (m, "Meteor_Storm");
			$AdjustAttribute (m, #ATTRIB_NumHealingPotions, 5);
		end
	if (rc == "scion1" || rc == "scion2" || rc == "scion3")
		begin
			$advance_to_level (m, 35);
			if (rc == "scion1")
				begin
					$AdjustAttribute (m, #ATTRIB_MAXHP, 100);
					$AdjustAttribute (m, #ATTRIB_HP, 100);
				end
			if (rc == "scion2")
				begin
					$AdjustAttribute (m, #ATTRIB_MAXHP, 200);
					$AdjustAttribute (m, #ATTRIB_HP, 200);
				end
			m's "resist_critical" = TRUE;
			if (hostile)
				m's "title" = "Scion";
		end
	if (hostile)
		$FMB_Hero_Hostile (m);
end

function FMB_Hero_Attack (agent m, agent target, boolean hostile, string rc)
declare
begin
	if ($isdead (m) || rc == "hool")
		return;
	m's "target" = target;
	if (hostile)
		m's "Task_Number" = 7798002;
	else
		m's "Task_Number" = 7798001;
end

function FMB_Hero_Spawn (agent palace, string ht, coordinate spot, integer owner) is agent
declare
	agent m;
	integer tries;
begin
	m = $FMB_Spawn_Safe (palace, ht, $RandomCoord (spot, 120), owner, "override");
	tries = 0;
	while ($IsValidGamePiece (m) == FALSE && tries < 2) do
		begin
			m = $FMB_Spawn_Safe (palace, ht, $RandomCoord (spot, 100, 250), owner, "override");
			tries = tries + 1;
		end
	return m;
end

// target: the Attack flag's target (null for an Explore flag or when it is gone)
function FMB_Flag_Heroes (agent palace, integer e, coordinate spot, agent target)
declare
	integer i, n, made, owner, mode;
	string ht, rc;
	agent m;
	boolean hostile;
begin
	ht = $ListMember ($FMB_Hero_List (), e - 110);
	rc = $ListMember ($FMB_Hero_Recipe (), e - 110);
	n = $FMB_Count ();
	hostile = $FMB_Is_Hostile ();
	owner = $GetUnitPlayerNumber (palace);
	if (hostile)
		owner = $FMB_Host_Player (palace);
	mode = 0;
	if ($IsValidGamePiece (target))
		begin
			spot = $LocationOf (target);
			mode = 2;
			if ($GetUnitPlayerNumber (target) == owner)
				mode = 1;
		end
	made = 0;
	i = 0;
	while (i < n) do
		begin
			m = $FMB_Hero_Spawn (palace, ht, spot, owner);
			if ($IsValidGamePiece (m))
				begin
					$FMB_Hero_Setup (m, rc, hostile, spot);
					if (hostile)
						$FMB_Fac_Team (palace, m);
					if (mode == 2)
						$FMB_Hero_Attack (m, target, hostile, rc);
					made = made + 1;
				end
			i = i + 1;
		end
	if (made == 0)
		begin
			$FMB_Say (palace, "IDTXT_FMB_HERO_FAIL");
			return;
		end
	if (hostile)
		begin
			$FMB_Say_Owner (palace);
			if (made == 1)
				$FMB_Say (palace, $ListMember ($FMB_HeroH_Keys (), e - 110));
			else
				$FMB_Say (palace, $ListMember ($FMB_HeroHN_Keys (), e - 110));
		end
	else
		begin
			if (made == 1)
				$FMB_Say (palace, $ListMember ($FMB_Hero1_Keys (), e - 110));
			else
				$FMB_Say (palace, $ListMember ($FMB_HeroN_Keys (), e - 110));
		end
	if (mode == 2)
		$FMB_Say (palace, "IDTXT_FMB_HMODE_ATTACK");
	if (mode == 1)
		$FMB_Say (palace, "IDTXT_FMB_HMODE_GUARD");
	if (made < n)
		$FMB_Say (palace, "IDTXT_FMB_HERO_PART");
end

// Original rules, step 2 of a flag (the births have run): aim Attack-flag heroes at the
// target and put Hooligans' home on the flag spot (Hooligan_birth set it to the spawner = Palace).
function FMB_Hero_Finish (list mons, list mine, list hoos, agent target, coordinate spot)
declare
	agent u;
	list all;
begin
	$FMB_Guard_Finish (mine, target);
	all = $AddLists (mons, mine);
	foreach u in all do
		begin
			if ($isdead (u) == FALSE)
				if ($HasAttribute ("Task_Number", u))
					if (u's "Task_Number" == 7798001 || u's "Task_Number" == 7798002)
						begin
							if ($FMB_BG_Gone (target) == FALSE)
								begin
									u's "target" = target;
									if (u's "Task_Number" == 7798002)
										u's "ActiveScript" = $raider;
									else
										u's "ActiveScript" = $attack_object;
								end
							u's "Task_Number" = 0;
						end
		end
	all = $AddLists (mons, hoos);
	foreach u in all do
		begin
			if ($isdead (u) == FALSE)
				if ($HasAttribute ("Target_Item", u))
					if (u's "Target_Item" == 9176 || u's "Target_Item" == 9177)
						begin
							u's "Coord_Home" = spot;
							u's "Target_Item" = 0;
						end
		end
end

////////////////////////////////////////////////////////////////////////////////
// ===== Henchmen: Peasant, Peasant (female), Tax Collector = entries 101..103, guards 104..106 =====
// Spawned by your Palace and owned by you, like the Palace's own peasant_spawner / tax_spawner do.
// peasant_birth / tax_collector_birth set home = $GetPalace (your Palace) and count them there
// (num_peasants / num_tax_collectors), so they build / repair / collect taxes for your real Palace
// (peasant_basic and collect_tax use $GetTruePalace). The Palace spawners only refill below their
// maximum, so extra ones are simply extra; when one dies the game's own death script updates the counts.
// Tax Collector: the stock tax_spawner passes ReturnAmount / PickupAmount at spawn; Deity Zenith sets the same
// defaults (#taxman_return_start / #taxman_pickup_start).
// Factions Hostile/Red/Green do NOT apply (same rule as the guards): a monster-player peasant is the game's
// invulnerable "captive" (peasant_birth, Type Hidden), and a Red/Green one would need that kingdom's real
// Palace. They are always yours. Integer attributes only, no threads, no birth script swap.
function FMB_Hench_List () is list
declare
	list L;
begin
	L << "Peasant";
	L << "Peasant_Female";
	L << "Tax_Collector";
	return L;
end

function FMB_Hench1_Keys () is list
declare
	list L;
begin
	L << "IDTXT_FMB_HEN1_01";
	L << "IDTXT_FMB_HEN1_02";
	L << "IDTXT_FMB_HEN1_03";
	return L;
end

function FMB_HenchN_Keys () is list
declare
	list L;
begin
	L << "IDTXT_FMB_HENN_01";
	L << "IDTXT_FMB_HENN_02";
	L << "IDTXT_FMB_HENN_03";
	return L;
end

function FMB_Flag_Henchmen (agent palace, integer e, coordinate spot)
declare
	integer i, n, made;
	string ht;
	agent m;
begin
	ht = $ListMember ($FMB_Hench_List (), e - 100);
	n = $FMB_Count ();
	if ($FMB_Is_Hostile ())
		$FMB_Say (palace, "IDTXT_FMB_HHOST");
	made = 0;
	i = 0;
	while (i < n) do
		begin
			m = $FMB_Spawn_Safe (palace, ht, $RandomCoord (spot, 120), $GetUnitPlayerNumber (palace), "override");
			if ($IsValidGamePiece (m) == FALSE)
				m = $FMB_Spawn_Safe (palace, ht, $RandomCoord (spot, 100, 250), $GetUnitPlayerNumber (palace), "override");
			if ($IsValidGamePiece (m))
				begin
					if (ht == "Tax_Collector")
						begin
							$SetAttribute (m, #ATTRIB_ReturnAmount, #taxman_return_start);
							$SetAttribute (m, #ATTRIB_PickupAmount, #taxman_pickup_start);
						end
					made = made + 1;
				end
			i = i + 1;
		end
	if (made == 0)
		begin
			$FMB_Say (palace, "IDTXT_FMB_HENFAIL");
			return;
		end
	if (made == 1)
		$FMB_Say (palace, $ListMember ($FMB_Hench1_Keys (), e - 100));
	else
		$FMB_Say (palace, $ListMember ($FMB_HenchN_Keys (), e - 100));
	if (made < n)
		$FMB_Say (palace, "IDTXT_FMB_HENPART");
end
function FMB_Guard_Home (agent palace, coordinate spot, agent target, integer mode) is agent
declare
	list blds;
	agent b, h;
	integer d, best;
begin
	// guard mode on your own Guardhouse or Palace: that building is their post
	if (mode == 1)
		if (target's "title" == "GuardHouse" || target's "title" == "Palace")
			return target;
	// else the Guardhouse nearest to the spot, or your Palace (as the game's guards)
	h = palace;
	best = -1;
	$ListObjects (palace, "building", -1, blds, #MyPlayer);
	foreach b in blds do
		begin
			if ($IsDead (b) == FALSE)
				if (b's "title" == "GuardHouse")
					begin
						d = $DistanceBetweenCoords ($LocationOf (b), spot);
						if (best < 0 || d < best)
							begin
								best = d;
								h = b;
							end
					end
		end
	return h;
end

function FMB_Guard_Attack (agent g, agent target)
declare
begin
	if ($IsDead (g))
		return;
	// the birth (a moment later) clears Target: aimed again at step 2
	g's "Target" = target;
	g's "Task_Number" = 7798004;
end

// step 2: the guard's own birth has run. Aim attack-mode guards; safety net for home / AI thread.
function FMB_Guard_Finish (list mine, agent target)
declare
	agent u, p;
begin
	p = $FMB_Palace ();
	foreach u in mine do
		begin
			if ($isdead (u) == FALSE)
				if ($HasAttribute ("Task_Number", u))
					if (u's "Task_Number" == 7798003 || u's "Task_Number" == 7798004)
						begin
							if ($IsDead (u's "Home") && $IsDead (p) == FALSE)
								begin
									u's "Home" = p;
									p's "Guards" << u;
									p's "Num_Guards" = p's "Num_Guards" + 1;
								end
							if ($IsRunning (u's "ActiveScript") == FALSE)
								$NewThread (u's "ActiveScript", #Henchmen_Cycle, u);
							if (u's "Task_Number" == 7798004)
								if ($FMB_BG_Gone (target) == FALSE)
									begin
										u's "Target" = target;
										u's "ActiveScript" = $Voyaging_Guard_Attack_Object;
									end
							u's "Task_Number" = 0;
						end
		end
end

////////////////////////////////////////////////////////////////////////////////
// ===== Hostile guards (faction Hostile / Red / Green only; Blue guards use FMB_Flag_Guards as before) =====
// The game's guard AI (Building_Guard.gpl) works for any owner: enemies are found with
// list_enemies_seen (#NotMyTeam) from the guard's Home, and the Home's Guard_Function thread
// (Building_Guard) releases the guards sleeping in it. What a non-player side lacks is a Palace:
// City_Guard_Birth reads its Home from the Waiting_Guardhouses of $GetPalace (the owner's palace slot).
// Original births run a moment after the spawn, so the home is set at step 2 (FMB_HG_Finish, from
// FMB_Flag_Finish); the home picked at step 1 is kept in the guard's BackTarget (no guard script uses it). Nothing is ever put on a Waiting_Guardhouses list,
// and only buildings of the guards' own side are homes: a Guardhouse, or a Palace placed
// by Deity Zenith (their Building_Guard thread keeps running). Outposts are not used.
function FMB_HG_Post (agent b, integer owner) is boolean
declare
begin
	if ($IsValidGamePiece (b) == FALSE)
		return FALSE;
	if ($IsDead (b))
		return FALSE;
	if ($GetUnitPlayerNumber (b) != owner)
		return FALSE;
	// quest "rescue" buildings: Type unknown, EnemyType nothing (Building_Guard does nothing there)
	if (b's "type" != "building")
		return FALSE;
	if (b's "EnemyType" == "nothing")
		return FALSE;
	if (b's "title" == "GuardHouse")
		return TRUE;
	if ($FMB_Is_Mod_Palace (b))
		return TRUE;
	return FALSE;
end

// nearest home of that side to the spot (skip = a building that is going away), else null
function FMB_HG_Home (agent ref, coordinate spot, integer owner, agent skip) is agent
declare
	list blds;
	agent b, h;
	integer d, best;
begin
	h = $NullAgent ();
	best = -1;
	$ListObjects (ref, "building", -1, blds);
	foreach b in blds do
		begin
			if (b != skip)
				if ($FMB_HG_Post (b, owner))
					begin
						d = $DistanceBetweenCoords ($LocationOf (b), spot);
						if (best < 0 || d < best)
							begin
								best = d;
								h = b;
							end
					end
		end
	return h;
end

// a Guardhouse of that side at the spot (as FMB_Flag_Building places buildings)
function FMB_HG_Guardhouse (agent palace, coordinate spot, integer owner) is agent
declare
	agent b;
	integer tries;
begin
	b = $SpawnUnit (palace, "GuardHouse1", spot, owner, "maxhp");
	tries = 0;
	while ($IsValidGamePiece (b) == FALSE && tries < 3) do
		begin
			b = $SpawnUnit (palace, "GuardHouse1", $RandomCoord (spot, 100, 250), owner, "maxhp");
			tries = tries + 1;
		end
	if ($IsValidGamePiece (b))
		$FMB_Fac_Team (palace, b);
	return b;
end

// home h, registered like City_Guard_Birth / Palace_Guard_Birth do, scripts = the guard's start
// scripts (Guard_Voyage_Home), AI thread running
function FMB_HG_Attach (agent g, agent h)
declare
	agent old;
begin
	if ($IsDead (g))
		return;
	if ($FMB_HG_Post (h, $GetUnitPlayerNumber (g)))
		begin
			old = g's "Home";
			if (old != h)
				begin
					if ($IsDead (old) == FALSE)
						if ($GetUnitPlayerNumber (old) == $GetUnitPlayerNumber (g))
							if ($AgentInList (g, old's "Guards"))
								begin
									old's "Guards" -= g;
									old's "Num_Guards" = old's "Num_Guards" - 1;
								end
					g's "Home" = h;
				end
			if ($AgentInList (g, h's "Guards") == FALSE)
				begin
					h's "Guards" << g;
					h's "Num_Guards" = h's "Num_Guards" + 1;
				end
		end
	g's "Target" = $NullAgent ();
	g's "ActiveScript" = $Guard_Voyage_Home;
	g's "BasicScript" = $Guard_Voyage_Home;
	g's "BackScript" = $Guard_Voyage_Home;
	if ($IsRunning (g's "ActiveScript") == FALSE)
		$NewThread (g's "ActiveScript", #Henchmen_Cycle, g);
end

function FMB_HG_Spawn (agent palace, string gt, coordinate spot, agent h, integer owner, agent target, integer mode) is agent
declare
	agent g;
begin
	// spawned by the home: Palace_Guard_Birth takes $Parent as home
	g = $FMB_Spawn_Safe (h, gt, $RandomCoord (spot, 120), owner, "override");
	if ($IsValidGamePiece (g) == FALSE)
		g = $FMB_Spawn_Safe (h, gt, $RandomCoord (spot, 100, 250), owner, "override");
	if ($IsValidGamePiece (g) == FALSE)
		return g;
	// the birth runs a moment later: home, scripts and thread are set at step 2 (FMB_HG_Finish)
	g's "BackTarget" = h;
	g's "Task_Number" = 7798005;
	if (mode == 2)
		begin
			g's "Target" = target;
			g's "Task_Number" = 7798006;
		end
	$FMB_Fac_Team (palace, g);
	return g;
end

// step-1 counter: FMB_Flag_Finish lists other sides' units only while hostile guards wait for step 2
function FMB_HG_Pending () is boolean
declare
	agent root;
begin
	root = $FMB_Root ();
	if ($HasAttribute ("FMB_HG_Pend", root) == FALSE)
		return FALSE;
	if (root's "FMB_HG_Pend" > 0)
		return TRUE;
	return FALSE;
end

function FMB_HG_Count (integer d)
declare
	agent root;
	integer v;
begin
	root = $FMB_Root ();
	if ($HasAttribute ("FMB_HG_Pend", root) == FALSE)
		$AddAttribute (root, "FMB_HG_Pend", "integer", 0);
	v = root's "FMB_HG_Pend" + d;
	if (v < 0)
		v = 0;
	root's "FMB_HG_Pend" = v;
end

// step 2 (the guards' births have run): home, scripts, thread, attack target
function FMB_HG_Finish (list l, agent target) is integer
declare
	agent u, h;
	integer n, owner;
begin
	n = 0;
	foreach u in l do
		begin
			if ($isdead (u) == FALSE)
				if ($HasAttribute ("Task_Number", u))
					if (u's "Task_Number" == 7798005 || u's "Task_Number" == 7798006)
						begin
							owner = $GetUnitPlayerNumber (u);
							h = u's "BackTarget";
							if ($FMB_HG_Post (h, owner) == FALSE)
								h = $FMB_HG_Home (u, $LocationOf (u), owner, $NullAgent ());
							u's "BackTarget" = $NullAgent ();
							$FMB_HG_Attach (u, h);
							if (u's "Task_Number" == 7798006)
								if ($FMB_BG_Gone (target) == FALSE)
									begin
										u's "Target" = target;
										u's "ActiveScript" = $Voyaging_Guard_Attack_Object;
									end
							u's "Task_Number" = 0;
							n = n + 1;
						end
		end
	return n;
end

function FMB_HG_Keys () is list
declare
	list L;
begin
	L << "IDTXT_FMB_HG_01";
	L << "IDTXT_FMB_HG_02";
	L << "IDTXT_FMB_HG_03";
	return L;
end

function FMB_HG_Flag_Guards (agent palace, integer e, coordinate spot, agent target)
declare
	integer i, n, made, mode, owner;
	string gt;
	agent g, h;
	boolean built;
begin
	gt = $ListMember ($FMB_Guard_List (), e - 100);
	n = $FMB_Count ();
	owner = $FMB_Host_Player (palace);
	// Attack flag: owner of the guards vs owner of the target, as for the other summons
	mode = 0;
	h = $NullAgent ();
	if ($IsDead (target) == FALSE)
		begin
			mode = 2;
			if ($GetUnitPlayerNumber (target) == owner)
				mode = 1;
		end
	if (mode == 1)
		if ($FMB_HG_Post (target, owner))
			h = target;
	if ($IsValidGamePiece (h) == FALSE)
		h = $FMB_HG_Home (palace, spot, owner, $NullAgent ());
	built = FALSE;
	if ($IsValidGamePiece (h) == FALSE)
		begin
			h = $FMB_HG_Guardhouse (palace, spot, owner);
			if ($IsValidGamePiece (h) == FALSE)
				begin
					$FMB_Say (palace, "IDTXT_FMB_GFAIL");
					return;
				end
			built = TRUE;
		end
	made = 0;
	i = 0;
	while (i < n) do
		begin
			g = $FMB_HG_Spawn (palace, gt, spot, h, owner, target, mode);
			if ($IsValidGamePiece (g))
				made = made + 1;
			i = i + 1;
		end
	if (made > 0)
		$FMB_HG_Count (1);
	$FMB_Say_Owner (palace);
	if (built)
		$FMB_Say (palace, "IDTXT_FMB_HG_GH");
	if (made == 0)
		begin
			$FMB_Say (palace, "IDTXT_FMB_GFAIL");
			return;
		end
	$FMB_Say (palace, $ListMember ($FMB_HG_Keys (), e - 100));
	if (mode == 2)
		$FMB_Say (palace, "IDTXT_FMB_HG_ATTACK");
	if (mode == 1)
		$FMB_Say (palace, "IDTXT_FMB_HG_GUARD");
	if (made < n)
		$FMB_Say (palace, "IDTXT_FMB_PARTIAL");
end

// Guardhouse entry with faction Hostile / Red / Green: a Guardhouse of that side
function FMB_HG_Flag_Guardhouse (agent palace, coordinate spot)
declare
	agent b;
begin
	b = $FMB_HG_Guardhouse (palace, spot, $FMB_Host_Player (palace));
	if ($IsValidGamePiece (b) == FALSE)
		begin
			$FMB_Say (palace, "IDTXT_FMB_BFAIL");
			return;
		end
	$FMB_Say_Owner (palace);
	$FMB_Say (palace, "IDTXT_FMB_HG_BLD");
end

// a Deity Zenith Palace of another side dies: its guards move to the nearest other home
// of their side, else they do what the game's GuardHouse_Death makes them do (Guard_Goto_Palace)
function FMB_HG_Release (agent b)
declare
	agent g, h;
	list l;
begin
	l = b's "Guards";
	foreach g in l do
		begin
			if ($IsDead (g) == FALSE)
				begin
					if ($IsHidden (g))
						begin
							g's "Type" = "Hero";
							$UnHide (g);
						end
					h = $FMB_HG_Home (b, $LocationOf (b), $GetUnitPlayerNumber (g), b);
					if ($IsValidGamePiece (h))
						begin
							g's "Home" = h;
							$FMB_HG_Attach (g, h);
						end
					else
						begin
							g's "ActiveScript" = $Guard_Goto_Palace;
							g's "BasicScript" = $Guard_Goto_Palace;
							g's "BackScript" = $Guard_Goto_Palace;
						end
					$ResumeThread (g's "ActiveScript");
				end
		end
end


////////////////////////////////////////////////////////////////////////////////
// ===== Hostile buildings (faction Hostile / Red / Green only; Blue buildings use FMB_Flag_Building as before) =====
// Same rules as the Expansion part. Original births run about 1 ms after the spawn, so everything below is set
// before any birth script reads it. Round 23 rules: no AddAttribute, no birthScript swap; only existing slots are
// assigned (as FMB_ModPalace_Prep does).
// - guilds and temples: "max_members" 0 (the Original GuildHasOpenSlots reads it), so check_strays (guild_birth and
//   warriors_guild_birth run it for every owner) never adopts a hero;
// - no spawn_1 / spawn_2 timers (Brothel, Gambling Hall, Gazebo), no caravans (Trading Post), no new Gnome Hovels
//   (the side's palace slot gnome_camp_spawner, $GetPalace of the new building = that side, never yours).
function FMB_HB_Guild (integer k) is boolean
declare
begin
	// 1..11 guilds and temples, 21..23 Dwarven Settlement / Elven Bungalow / Gnome Hovel
	if (k >= 1 && k <= 11)
		return TRUE;
	if (k >= 21 && k <= 23)
		return TRUE;
	return FALSE;
end

function FMB_HB_Hostile (agent palace, integer k) is boolean
declare
	string bt;
begin
	bt = $ListMember ($FMB_Bld_List (), k);
	// Guardhouse: FMB_HG_Flag_Guardhouse; the mod's Palace: its own path; Graveyard: always yours
	if (bt == "GuardHouse1" || bt == "EvilPalace" || bt == "Palace3" || bt == "Graveyard")
		return FALSE;
	return TRUE;
end

function FMB_HB_Prep (agent b, integer k, integer owner)
declare
	string bt;
	agent p;
begin
	bt = $ListMember ($FMB_Bld_List (), k);
	if ($FMB_HB_Guild (k))
		if ($HasAttribute ("max_members", b))
			b's "max_members" = 0;
	if ($HasAttribute ("spawn_1", b))
		begin
			if ($IsRunning (b's "spawn_1"))
				$KillThread (b's "spawn_1");
			b's "spawn_1" = $FMB_DarkPalace_Idle;
		end
	if ($HasAttribute ("spawn_2", b))
		begin
			if ($IsRunning (b's "spawn_2"))
				$KillThread (b's "spawn_2");
			b's "spawn_2" = $FMB_DarkPalace_Idle;
		end
	if (bt == "Trading_Post")
		begin
			if ($IsRunning (b's "activeScript"))
				$KillThread (b's "activeScript");
			b's "activeScript" = $FMB_DarkPalace_Idle;
		end
	if (bt == "Gnome_Hovel")
		begin
			p = $GetPalace (b);
			if ($IsValidGamePiece (p))
				if ($GetUnitPlayerNumber (p) == owner)
					if ($HasAttribute ("gnome_camp_spawner", p))
						begin
							if ($IsRunning (p's "gnome_camp_spawner"))
								$KillThread (p's "gnome_camp_spawner");
							p's "gnome_camp_spawner" = $FMB_DarkPalace_Idle;
						end
		end
end

function FMB_HB_Flag_Building (agent palace, integer k, coordinate spot)
declare
	agent b;
	integer tries, owner;
	string bt;
begin
	bt = $ListMember ($FMB_Bld_List (), k);
	owner = $FMB_Host_Player (palace);
	b = $SpawnUnit (palace, bt, spot, owner, "maxhp");
	tries = 0;
	while ($IsValidGamePiece (b) == FALSE && tries < 3) do
		begin
			b = $SpawnUnit (palace, bt, $RandomCoord (spot, 100, 250), owner, "maxhp");
			tries = tries + 1;
		end
	if ($IsValidGamePiece (b) == FALSE)
		begin
			$FMB_Say (palace, "IDTXT_FMB_BFAIL");
			return;
		end
	$FMB_HB_Prep (b, k, owner);
	$FMB_Fac_Team (palace, b);
	$FMB_Say_Owner (palace);
	if ($FMB_HB_Guild (k))
		$FMB_Say (palace, "IDTXT_FMB_HB_DECOR");
	else
		$FMB_Say (palace, "IDTXT_FMB_HB_BLD");
end


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// ===== Give Ability to Selected Unit (both rulesets) =====
// Cheat Engine reads the game's selected unit and writes its agent number into the GplAIRoot integer FMCE_Give
// (-1 = nothing selected, -2 = not a unit: building, lair, flag...). FMCE_Abil = 7733248 + ability number (1..63). DZA_Check runs every 0.7 s
// (Expansion: inside FM_Value_Watch; Original: a thread in GplAIRoot's UtilityScript slot, see DZA_Ensure_B),
// turns the number back into the unit with $AgentNumber (as check_rewards does with a flag's targetID) and gives
// the spell with $LearnSpell, the same call the game uses for the Spellbook, the Shards, the Bazaar / Legendary
// items, the Hooligan thief and the Angry Wizard. Only integer AddAttribute (Round 23 rules).
// Abilities 1..41 exist in both rulesets (M_Actions.xml); 42..63 only in the Expansion (MX_Actions.xml).

