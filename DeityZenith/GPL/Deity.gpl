function DZA_Say (agent palace, string key)
declare
begin
	$LocalChatMessage ($GetUnitPlayerNumber (palace), key);
end

function DZA_Index (agent root) is integer
declare
	integer v;
begin
	v = root's "FMCE_Abil";
	if (v >= 7733249 && v <= 7733311)
		return v - 7733248;
	if (v >= 1 && v <= 63)
		return v;
	return 1;
end

function DZA_Check (agent palace)
// Any unit can learn (heroes, henchmen, guards, monsters, any side), like the campaign Hooligan and Varg.
// Kept checks (crash safety only): the unit exists and is alive; it has the "castingrange" attribute of the
// hero / monster prototypes (buildings, lairs, flags, tax collectors and caravans do not, and the engine keeps
// the spell list only on moving units); Charm Monster only on units that fight monsters (the charm code turns
// its target into a controlled monster, which only works on monsters).
// A unit with castingrange 0 (henchmen, most monsters: no value in their data) gets 75, the value of the
// melee hero classes, so its AI can reach a target with the new spell instead of walking at it forever.
declare
	agent root, hero;
	integer v, i, need, lv;
	string sp;
begin
	if ($IsValidGamePiece (palace) == FALSE)
		return;
	root = $RetrieveAgent ("GplAIRoot");
	if ($HasAttribute ("FMCE_Give", root) == FALSE)
		return;
	v = root's "FMCE_Give";
	if (v == 0)
		return;
	root's "FMCE_Give" = 0;
	if (v == -2)
		begin
			$DZA_Say (palace, "IDTXT_DZA_NOTUNIT");
			return;
		end
	if (v < 0)
		begin
			$DZA_Say (palace, "IDTXT_DZA_NOSEL");
			return;
		end
	hero = $AgentNumber (v);
	if ($IsValidGamePiece (hero) == FALSE)
		begin
			$DZA_Say (palace, "IDTXT_DZA_NOSEL");
			return;
		end
	if ($IsDead (hero))
		begin
			$DZA_Say (palace, "IDTXT_DZA_NOSEL");
			return;
		end
	if ($HasAttribute ("castingrange", hero) == FALSE)
		begin
			$DZA_Say (palace, "IDTXT_DZA_NOTUNIT");
			return;
		end
	i = $DZA_Index (root);
	if (i > 41)
		if ($FM_Ruleset_MX () == FALSE)
			begin
				$DZA_Say (palace, "IDTXT_DZA_ORIG");
				return;
			end
	sp = $ListMember ($DZA_Names (), i);
	if (sp == "charm_monster")
		begin
			if ($HasAttribute ("EnemyType", hero) == FALSE)
				begin
					$DZA_Say (palace, "IDTXT_DZA_CHARM");
					return;
				end
			if (hero's "EnemyType" != "Monster" && hero's "EnemyType" != "monster")
				begin
					$DZA_Say (palace, "IDTXT_DZA_CHARM");
					return;
				end
		end
	if (hero's "castingrange" < 1)
		hero's "castingrange" = 75;
	$LearnSpell (hero, sp);
	$DZA_Say (palace, $ListMember ($DZA_Keys (), i));
	need = $ListMember ($DZA_Levels (), i);
	lv = $GetAttribute (hero, #ATTRIB_ExperienceLevel);
	if (need >= 1 && lv < need)
		$DZA_Say (palace, $ListMember ($DZA_Lv_Keys (), need));
end

function DZA_Lv_Keys () is list
declare
	list L;
begin
	L << "IDTXT_DZA_LV1";
	L << "IDTXT_DZA_LV2";
	L << "IDTXT_DZA_LV3";
	L << "IDTXT_DZA_LV4";
	L << "IDTXT_DZA_LV5";
	L << "IDTXT_DZA_LV6";
	L << "IDTXT_DZA_LV7";
	L << "IDTXT_DZA_LV8";
	return L;
end

// Original ruleset: GplAIRoot's UtilityScript slot (AIRoot prototype function, never threaded by the original
// quests except the "Vampiric Revenge" demo, which uses it for its victory) holds the Give watcher.
// Same pattern as the stock Quests_3 Strangleweed event: assign the slot, then NewThread on it.
function DZA_Ensure_B (agent palace)
declare
	agent root;
begin
	if ($IsValidGamePiece (palace) == FALSE)
		return;
	root = $RetrieveAgent ("GplAIRoot");
	if ($HasAttribute ("UtilityScript", root) == FALSE)
		return;
	if ($HasAttribute ("Quest_Number", root))
		if (root's "Quest_Number" == 500)
			return;
	root's "UtilityScript" = $DZA_Watch_B;
	if ($IsRunning (root's "UtilityScript") == FALSE)
		$NewThread (root's "UtilityScript", 700, palace);
end

function DZA_Watch_B (agent thisagent)
declare
begin
	if ($isdead (thisagent))
		return;
	$DZA_Check (thisagent);
end

// ===== one mod for both rulesets =====
// Expansion / Freestyle: GplAIRoot is built from the MX AIRoot prototype, which adds
// Lair_Delay_Override and Spawn_High_Level_Heroes (GPLMx/mx_prototype.gpl). The original
// prototype (GPL/prototype.gpl) has neither. Stock MX code tests them the same way.
function FM_Ruleset_MX () is boolean
declare
	agent root;
begin
	root = $RetrieveAgent ("GplAIRoot");
	if ($HasAttribute ("Lair_Delay_Override", root))
		return TRUE;
	if ($HasAttribute ("Spawn_High_Level_Heroes", root))
		return TRUE;
	return FALSE;
end

function GplKickoff ()
declare
begin
	if ($FM_Ruleset_MX ())
		$FMX_Hook_GplKickoff ();
	else
		$FMB_Hook_GplKickoff ();
end

function explore_flag_birth (agent thisagent)
declare
begin
	if ($FM_Ruleset_MX ())
		$FMX_Hook_explore_flag_birth (thisagent);
	else
		$FMB_Hook_explore_flag_birth (thisagent);
end

function attack_flag_birth (agent thisagent)
declare
begin
	if ($FM_Ruleset_MX ())
		$FMX_Hook_attack_flag_birth (thisagent);
	else
		$FMB_Hook_attack_flag_birth (thisagent);
end

function RewardFlag_Birth (agent thisagent)
declare
begin
	if ($FM_Ruleset_MX ())
		$FMX_Hook_RewardFlag_Birth (thisagent);
	else
		$FMB_Hook_RewardFlag_Birth (thisagent);
end
