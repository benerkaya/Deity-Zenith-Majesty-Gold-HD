function FMB_Sel_Keys () is list
declare
	list L;
begin
	L << "IDTXT_FMB_SEL_01";
	L << "IDTXT_FMB_SEL_02";
	L << "IDTXT_FMB_SEL_03";
	L << "IDTXT_FMB_SEL_04";
	L << "IDTXT_FMB_SEL_05";
	L << "IDTXT_FMB_SEL_06";
