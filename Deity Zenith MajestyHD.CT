  },
}
H.rulesname = {'Expansion', 'Original Majesty'}
local CATS = {'M', 'S', 'G', 'H', 'B', 'L'}
local CATNAME = {M = 'monsters', S = 'nature monsters', G = 'henchmen', H = 'heroes', B = 'buildings', L = 'lairs'}
local MAG = {FMCE_On = 0x710000, FMCE_Type = 0x700000, FMCE_Count = 0x720000, FMCE_Faction = 0x730000,
             FMCE_Ping = 0x740000, FMCE_Rules = 0x750000}
local NEED = {'FMCE_On', 'FMCE_Type', 'FMCE_Count', 'FMCE_Faction'}
local RANGE = {FMCE_On = {0, 1, 0}, FMCE_Type = {1, 499, 1}, FMCE_Count = {1, 10, 1}, FMCE_Faction = {0, 3, 0},
               FMCE_Ping = {0, 99, 0}, FMCE_Rules = {1, 2, nil}}
local function talk(t)
  H.lastsaid = t
end
local function bad(t)
  H.lasterrmsg = t
  talk(t)
end
local function attached()
  if getOpenedProcessID == nil or getOpenedProcessID() == 0 then return false end
  if process ~= nil and tostring(process):lower() ~= 'majestyhd.exe' then return false end
  return true
end
local function attach()
  if attached() then return true end
  local pid = nil
  if getProcessIDFromProcessName ~= nil then pid = getProcessIDFromProcessName('MajestyHD.exe') end
  if pid == nil or pid == 0 then return false end
  if openProcess ~= nil then pcall(openProcess, pid) end
  for i = 1, 30 do
    if attached() and getOpenedProcessID() == pid then return true end
    if sleep ~= nil then sleep(100) end
  end
  return attached()
end
local function stillvalid()
  local p = H.pick
  if p == nil then return false end
  for _, k in ipairs(NEED) do
    local h = p[k]
    if h == nil then return false end
    if rd(h.node + 0x18) ~= h.addr - 8 or not isint(h.addr - 8) then return false end
    local nm = nodename(h.node)
    if nm == nil or nm:lower() ~= k:lower() then return false end
  end
  return true
end
local function get(k)
  local v = readInteger(H.pick[k].addr)
  if v == nil then return nil end
  local m = MAG[k]
  local lo, hi = RANGE[k][1], RANGE[k][2]
  if v &gt;= m + lo and v &lt;= m + hi then return v - m end
  if v &gt;= lo and v &lt;= hi then return v end
  return RANGE[k][3]
end
local function put(k, n) writeInteger(H.pick[k].addr, MAG[k] + n) end
local function rulesidx()
  local h = H.pick and H.pick.FMCE_Rules
  if h ~= nil then
    local v = readInteger(h.addr)
    if v == MAG.FMCE_Rules + 1 then return 1 end
    if v == MAG.FMCE_Rules + 2 then return 2 end
  end
  return H.rules
end
local function ping()
  local h = H.pick and H.pick.FMCE_Ping
  if h == nil then return end
  local v = readInteger(h.addr)
  if v == nil then return end
  local n = v - MAG.FMCE_Ping
  if n &lt; 0 or n &gt; 99 then n = 0 end
  writeInteger(h.addr, MAG.FMCE_Ping + ((n + 1) % 100))
end
local function scan(why)
  if not attach() then
    bad('Majesty is not running, or Cheat Engine is not attached to MajestyHD.')
    return false
  end
  talk((why or 'Scanning') .. ', please wait.')
  local okcall, found = pcall(FMCE_find)
  if okcall and found and FMCE_PICK ~= nil then
    H.pick = FMCE_PICK
    ping()
    talk('Deity Zenith found. ' .. H.rulesname[rulesidx()] .. ' list.')
    return true
  end
  H.pick = nil
  bad('Deity Zenith values not found. Start or load a game with the mod, then press control numpad zero.')
  return false
end
local function ensure()
  if stillvalid() and attached() then return true end
  if H.pick == nil then return scan('Not scanned yet. Scanning') end
  return scan('Values lost, probably a save was loaded. Scanning again')
end
local function curlist() return H.lists[rulesidx()] end
local function curidx(L)
  local e = get('FMCE_Type')
  for i, it in ipairs(L) do if it.e == e then return i end end
  return 1
end
local function status()
  local L = curlist()
  local it = L[curidx(L)]
  local on = (get('FMCE_On') == 1) and 'summon on' or 'summon off'
  local fac = ({[0] = 'blue', [1] = 'hostile', [2] = 'red', [3] = 'green'})[get('FMCE_Faction') or 0] or 'blue'
  local c = get('FMCE_Count') or 1
  return string.format('%s, %s, %d per flag, %s', it.n, fac, c, on)
end
local function sig()
  return tostring(get('FMCE_On')) .. ',' .. tostring(get('FMCE_Type')) .. ',' .. tostring(get('FMCE_Count')) .. ',' .. tostring(get('FMCE_Faction'))
end
local function act(f)
  return function()
    local ok, err = pcall(function()
      if not ensure() then return end
      local before = sig()
      local t = f()
      if sig() == before then ping() end
      talk(t or status())
    end)
    if not ok then bad('Hotkey error') H.lasterror = tostring(err) end
  end
end
local function settype(L, i) put('FMCE_Type', L[i].e) end
local function step(d, wrap)
  local L = curlist()
  local i = curidx(L) + d
  if wrap then i = ((i - 1) % #L) + 1 else
    if i &lt; 1 then i = 1 end
    if i &gt; #L then i = #L end
  end
  settype(L, i)
end
local function catstep(d)
  local L = curlist()
  local c = L[curidx(L)].c
  local ci = 1
  for i, x in ipairs(CATS) do if x == c then ci = i end end
  for n = 1, #CATS do
    local cc = CATS[((ci - 1 + d * n) % #CATS) + 1]
    for i, it in ipairs(L) do
      if it.c == cc then settype(L, i) return 'First of ' .. CATNAME[cc] .. ': ' .. status() end
    end
  end
end
H.actions = {
  scan = function() pcall(function() if scan('Scanning') then talk(status()) end end) end,
  onoff = act(function() put('FMCE_On', (get('FMCE_On') == 1) and 0 or 1) end),
  nexte = act(function() step(1, true) end),
  preve = act(function() step(-1, true) end),
  plus10 = act(function() step(10, false) end),
  minus10 = act(function() step(-10, false) end),
  nextcat = act(function() return catstep(1) end),
  prevcat = act(function() return catstep(-1) end),
  faction = act(function() put('FMCE_Faction', ((get('FMCE_Faction') or 0) + 1) % 4) end),
  cplus = act(function() local c = get('FMCE_Count') or 1 if c &lt; 10 then c = c + 1 end put('FMCE_Count', c) end),
  cminus = act(function() local c = get('FMCE_Count') or 1 if c &gt; 1 then c = c - 1 end put('FMCE_Count', c) end),
  say = act(function() return nil end),
  give = function()
    pcall(function()
      if not ensure() then return end
      local h = H.pick and H.pick.FMCE_Give
      if not DZ_helper_ok(h, 'FMCE_Give') then
        scan('Scanning')
        h = H.pick and H.pick.FMCE_Give
      end
      if not DZ_helper_ok(h, 'FMCE_Give') then return end
      DZ_give_write(h.addr)
    end)
  end,
  rules = function()
    H.rules = (H.rules == 1) and 2 or 1
    talk('Hotkeys use the ' .. H.rulesname[H.rules] .. ' list, when the mod does not report its ruleset.')
    pcall(function() if stillvalid() then ping() end end)
  end,
}
H.bind = {
  {'scan', VK_NUMPAD0}, -- Ctrl+Num 0: activate / re-scan (also after loading a save)
  {'onoff', VK_NUMPAD5}, -- Ctrl+Num 5: flag summon ON / OFF
  {'nexte', VK_NUMPAD6}, -- Ctrl+Num 6: next entry
  {'preve', VK_NUMPAD4}, -- Ctrl+Num 4: previous entry
  {'plus10', VK_NUMPAD9}, -- Ctrl+Num 9: 10 entries forward
  {'minus10', VK_NUMPAD3}, -- Ctrl+Num 3: 10 entries back
  {'nextcat', VK_NUMPAD8}, -- Ctrl+Num 8: next category (monsters, nature, henchmen, heroes, buildings, lairs)
  {'prevcat', VK_NUMPAD2}, -- Ctrl+Num 2: previous category
  {'faction', VK_NUMPAD7}, -- Ctrl+Num 7: faction Blue &gt; Hostile &gt; Red &gt; Green
  {'cplus', VK_ADD}, -- Ctrl+Num +: summons per flag +1 (max 10)
  {'cminus', VK_SUBTRACT}, -- Ctrl+Num -: summons per flag -1 (min 1)
  {'say', VK_MULTIPLY}, -- Ctrl+Num *: repeat the current selection
  {'rules', VK_DECIMAL}, -- Ctrl+Num .: switch list Expansion / Original (fallback only)
  {'give', VK_NUMPAD1}, -- Ctrl+Num 1: give the picked ability to the selected unit
}
for _, b in ipairs(H.bind) do
  local hk = createHotkey(H.actions[b[1]], VK_CONTROL, b[2])
  pcall(function() hk.DelayBetweenActivate = 250 end)
  H.keys[#H.keys + 1] = hk
end
if getAutoAttachList ~= nil then
  pcall(function()
    local al = getAutoAttachList()
    local have = false
    for i = 0, al.Count - 1 do if tostring(al[i]):lower() == 'majestyhd.exe' then have = true end end
    if not have then al.add('MajestyHD.exe') end
  end)
end
end)
if not okcall then
  showMessage('Deity Zenith hotkeys: SCRIPT ERROR\n\n' .. tostring(err))
  error('Deity Zenith hotkeys: script error')
end
showMessage('Deity Zenith hotkeys are ON (NumLock on).\n\nCtrl+Num 0: activate / re-scan (also after loading a save)\nCtrl+Num 5: flag summon ON / OFF\nCtrl+Num 6: next entry\nCtrl+Num 4: previous entry\nCtrl+Num 9: 10 entries forward\nCtrl+Num 3: 10 entries back\nCtrl+Num 8: next category (monsters, nature, henchmen, heroes, buildings, lairs)\nCtrl+Num 2: previous category\nCtrl+Num 7: faction Blue &gt; Hostile &gt; Red &gt; Green\nCtrl+Num +: summons per flag +1 (max 10)\nCtrl+Num -: summons per flag -1 (min 1)\nCtrl+Num *: repeat the current selection\nCtrl+Num .: switch list Expansion / Original (fallback only)\nCtrl+Num 1: give the picked ability to the selected unit\n\nNow start Majesty (fullscreen is fine). Cheat Engine attaches by itself when MajestyHD.exe starts. In a game, press Ctrl+Num 0 once (and again after loading a save).')
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
if FM9 ~= nil and FM9.keys ~= nil then
  for _, k in ipairs(FM9.keys) do pcall(function() k.destroy() end) end
  FM9.keys = {}
end
{$asm}
</AssemblerScript>
