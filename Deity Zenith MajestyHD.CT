          <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
-- Deity Zenith for Majesty Gold HD - by Bener Kaya
-- Gives the picked Ability to the unit selected in the game (same as Ctrl+Num 1), then unticks itself.
-- Give Ability to Selected Unit. The game's selection (MajestyHD.exe, static addresses, no ASLR):
--  [0x7C0ABC] = selection manager (singleton, 0x425D00); manager+0x48 = selected unit (set at 0x42A6CE,
--  cleared to 0 at 0x42A9C1). unit+4 = the unit's engine attribute map (std::map: head +0x18; node: left +0,
--  parent +4, right +8, key +0x0C, value +0x10, isnil byte +0x15). Key 0x4541 ('AE') = the unit's GPL agent
--  number; $GetParent builds its agentRef from the same key (0x42E6FF). Only reads the game; the one write is
--  the mod's own FMCE_Give integer. Only moving units (class VehicleRec, vtable 0x73B08C: heroes, henchmen,
--  monsters) keep a spell list (unit+0x168, set up in VehicleRec only); $LearnSpell writes there without a
--  type check, so buildings, lairs, flags and terrain (smaller classes) are refused here (-2) and in the mod.
function DZ_u32(a)
  if a == nil or a == 0 then return nil end
  local v = readInteger(a)
  if v == nil then return nil end
  if v &lt; 0 then v = v + 4294967296 end
  return v
end
function DZ_selected_unit()
  local mgr = DZ_u32(0x7C0ABC)
  if mgr == nil or mgr == 0 then return nil end
  local unit = DZ_u32(mgr + 0x48)
  if unit == nil or unit == 0 then return nil end
  return unit
end
function DZ_unit_agent(unit)
  local head = DZ_u32(unit + 0x1C)
  if head == nil or readBytes(head + 0x15, 1) ~= 1 then return nil end
  local n = DZ_u32(head + 4)
  for i = 1, 64 do
    if n == nil or n == 0 or n == head or readBytes(n + 0x15, 1) ~= 0 then return nil end
    local k = DZ_u32(n + 0x0C)
    if k == nil then return nil end
    if k == 0x4541 then return DZ_u32(n + 0x10) end
    if k &lt; 0x4541 then n = DZ_u32(n + 8) else n = DZ_u32(n) end
  end
  return nil
end
function DZ_helper_ok(h, name)
  if h == nil or h.node == nil or h.addr == nil then return false end
  if DZ_u32(h.node + 0x18) ~= h.addr - 8 then return false end
  if DZ_u32(h.addr - 8) ~= 0x007463F4 or DZ_u32(h.addr - 4) ~= 1 then return false end
  local p = DZ_u32(h.node + 0x0C)
  local len = DZ_u32(h.node + 0x14)
  local fl = readBytes(h.node + 0x13, 1)
  if p == nil or len == nil or fl == nil or len ~= #name then return false end
  local s = readString(p, len, (fl % 2) == 1)
  return s ~= nil and s:lower() == name:lower()
end
-- writes the selected unit's agent number for the mod to pick up (-1: nothing selected, -2: not a unit)
function DZ_give_write(addr)
  local unit = DZ_selected_unit()
  if unit == nil then
    writeInteger(addr, -1)
    return false
  end
  if DZ_u32(unit) ~= 0x0073B08C then
    writeInteger(addr, -2)
    return false
  end
  local id = DZ_unit_agent(unit)
  if id == nil or id == 0 or id &gt; 2147483647 then
    writeInteger(addr, -1)
    return false
  end
  writeInteger(addr, id)
  return true
end
local mr = memrec
local h = (FMCE_PICK ~= nil) and FMCE_PICK.FMCE_Give or nil
if not DZ_helper_ok(h, 'FMCE_Give') then
  showMessage('Deity Zenith: tick "Deity Zenith - Activate" first (or press Ctrl+Num 0), then try again.')
  error('Deity Zenith: not active')
end
DZ_give_write(h.addr)
if mr ~= nil and createTimer ~= nil then
  local tm = createTimer(nil, false)
  tm.Interval = 250
  tm.OnTimer = function(x) x.destroy() pcall(function() mr.Active = false end) end
  tm.Enabled = true
end
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
{$asm}
</AssemblerScript>
