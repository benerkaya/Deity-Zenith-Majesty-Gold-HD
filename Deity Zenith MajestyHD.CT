  <CheatEntries>
    <CheatEntry>
      <ID>1</ID>
      <Description>"Deity Zenith - Activate (or Ctrl+Num 0)"</Description>
      <Options moHideChildren="1"/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
-- Deity Zenith for Majesty Gold HD - by Bener Kaya
-- Deity Zenith 'Activate' (finds the mod's values). Self-contained (does not need the table Lua script).
-- Only reads memory (AOBScan / readInteger / readString) and registers 4 symbols.
-- It never attaches the debugger, sets breakpoints, pauses the game or uses speedhack.
-- Deity Zenith: locate the mod's integers on the GplAIRoot agent.
-- Read-only memory scans (AOBScan/readInteger/readString). No debugger, no
-- breakpoints, no game pausing, no speedhack, no code injection.
-- Engine facts (MajestyHD.exe sha256 aa9be61d..., image base 0x400000, no ASLR):
--  GPL integer object = {vtable 0x007463F4, type 1, value} (12 bytes)
--  attribute map node: +0x0C name string {char*/wchar* text, cap|flags (byte +3 bit0 = UTF-16), len},
--                      +0x18 value object pointer, +0x1D isnil byte
local VT = 0x007463F4
local SPEC = {
  {name = 'FMCE_On',    magic = 0x710000, lo = 0, hi = 1},
  {name = 'FMCE_Type',  magic = 0x700000, lo = 1, hi = 499},
  {name = 'FMCE_Count', magic = 0x720000, lo = 1, hi = 10},
  {name = 'FMCE_Faction', magic = 0x730000, lo = 0, hi = 3},
}
local function hex(v) return string.format('%08X', v) end
local function le(v)
  local t = {}
  for i = 1, 4 do t[i] = string.format('%02X', v % 256) v = math.floor(v / 256) end
  return table.concat(t, ' ')
end
local function textaob(s, wide)
  local t = {}
  for i = 1, #s do
    t[#t + 1] = string.format('%02X', s:byte(i))
    if wide then t[#t + 1] = '00' end
  end
  t[#t + 1] = '00'
  if wide then t[#t + 1] = '00' end
  return table.concat(t, ' ')
end
local function scan(aob, aligned)
  local r
  if aligned then r = AOBScan(aob, '+W-C', 1, '4') else r = AOBScan(aob, '+W-C') end
  local t = {}
  if r ~= nil then
    for i = 0, r.Count - 1 do t[#t + 1] = tonumber(r[i], 16) end
    r.destroy()
  end
  return t
end
local function rd(a) if a == nil or a == 0 then return nil end return readInteger(a) end
local function rb(a) local b = readBytes(a, 1) return b end
local function isint(v) return v ~= nil and v ~= 0 and rd(v) == VT and rd(v + 4) == 1 end
local function decode(s, val)
  if val &gt;= s.magic + s.lo and val &lt;= s.magic + s.hi then return val - s.magic end
  if val &gt;= s.lo and val &lt;= s.hi then return val end
  return nil
end
-- node checks: name string at node+0x0C equals s.name, isnil == 0, value is a GPL integer
local function nodename(node)
  local p = rd(node + 0x0C)
  local fl = rb(node + 0x13)
  local len = rd(node + 0x14)
  if p == nil or p == 0 or fl == nil or len == nil or len &lt;= 0 or len &gt; 64 then return nil end
  local wide = (fl % 2) == 1
  return readString(p, len, wide), wide
end
local function headof(node)
  local n = node
  for i = 1, 64 do
    local par = rd(n + 4)
    if par == nil then return nil end
    if rb(par + 0x1D) == 1 then return par end
    n = par
  end
  return nil
end
local function checknode(node, s, stats)
  if rb(node + 0x1D) ~= 0 then return nil end
  local nm, wide = nodename(node)
  if nm == nil or nm:lower() ~= s.name:lower() then return nil end
  stats.named = stats.named + 1
  local v = rd(node + 0x18)
  if not isint(v) then return nil end
  local val = rd(v + 8)
  return {addr = v + 8, val = val, dec = decode(s, val), head = headof(node), wide = wide, node = node}
end
local function findname(s, stats)
  local hits, seen = {}, {}
  for _, wide in ipairs({false, true}) do
    for _, txt in ipairs(scan(textaob(s.name, wide), false)) do
      stats.text = stats.text + 1
      for _, ref in ipairs(scan(le(txt), true)) do
        stats.refs = stats.refs + 1
        local h = checknode(ref - 0x0C, s, stats)
        if h and not seen[h.addr] then seen[h.addr] = true hits[#hits + 1] = h end
      end
    end
  end
  return hits
end
function FMCE_find()
  local out = {}
  local function say(x) out[#out + 1] = x end
  if getOpenedProcessID == nil or getOpenedProcessID() == 0 then
    return false, 'Cheat Engine is not attached to a process. Click the computer icon and open MajestyHD.exe first.'
  end
  if process ~= nil and tostring(process):lower() ~= 'majestyhd.exe' then
    say('WARNING: attached process is "' .. tostring(process) .. '", expected MajestyHD.exe.')
  end
  if rd(VT) ~= 0x005564F0 or rd(VT + 4) ~= 0x005847C0 then
    say('WARNING: GPL integer vtable check failed (different MajestyHD.exe build?). Results may be wrong.')
  end
  local all, missing = {}, {}
  for _, s in ipairs(SPEC) do
    local stats = {text = 0, refs = 0, named = 0}
    local hits = findname(s, stats)
    all[s.name] = hits
    say(string.format('%s: %d valid hit(s)  [name text copies %d, pointers to them %d, named nodes %d]',
      s.name, #hits, stats.text, stats.refs, stats.named))
    for i, h in ipairs(hits) do
      if i &lt;= 4 then
        say(string.format('   %s = %d (%s)%s', hex(h.addr), h.val,
          h.dec and ('decoded ' .. h.dec) or 'OUT OF RANGE', h.wide and ' utf16-key' or ''))
      end
    end
    if #hits == 0 then missing[#missing + 1] = s.name end
  end
  if #missing &gt; 0 then
    return false, table.concat(out, '\n') .. '\n\nNOT FOUND: ' .. table.concat(missing, ', ') ..
      '\nThe mod creates these values when a game starts or when an Explore/Attack flag is placed .' ..
      '\nCheck: Deity Zenith is installed (Install.bat; Status.bat shows it), a game is running (not the menu), then place one Explore or Attack flag and enable this script again.' ..
      '\nIf it still fails, send this text back.'
  end
  -- prefer a map (head) that holds all four values; stale copies from an earlier game in the same session have their own head
  local heads, order = {}, {}
  for _, s in ipairs(SPEC) do
    for _, h in ipairs(all[s.name]) do
      local k = h.head or 0
      if heads[k] == nil then heads[k] = {} order[#order + 1] = k end
      if heads[k][s.name] == nil then heads[k][s.name] = h end
    end
  end
  local full = {}
  for _, k in ipairs(order) do
    local g = heads[k]
    if k ~= 0 and g.FMCE_On and g.FMCE_Type and g.FMCE_Count and g.FMCE_Faction then full[#full + 1] = g end
  end
  local pick = {}
  if #full &gt;= 1 then
    pick = full[1]
  else
    for _, s in ipairs(SPEC) do pick[s.name] = all[s.name][1] end
    say('NOTE: the four values were not found in one attribute map; using the first hit of each.')
  end
  if #full &gt; 1 then
    say(string.format('NOTE: %d complete copies found (probably a stale copy from an earlier game in this session). Using the first. If the next flag still says "summon is OFF", quit Majesty to desktop, restart it, load the game and enable this script again.', #full))
  end
  for _, s in ipairs(SPEC) do
    unregisterSymbol(s.name)
    registerSymbol(s.name, pick[s.name].addr, true)
  end
  -- values that are not "magic + value in range" (e.g. FMCE_Count 0xFFF1FD01 left by the
  -- old expression-valued AddAttribute) are reset to the value the mod already used
  local DEF = {FMCE_On = 0, FMCE_Type = 1, FMCE_Count = 1, FMCE_Faction = 0}
  for _, s in ipairs(SPEC) do
    local h = pick[s.name]
    local v = readInteger(h.addr)
    if v == nil or v &lt; s.magic + s.lo or v &gt; s.magic + s.hi then
      local d = (v ~= nil) and decode(s, v) or nil
      if d == nil then d = DEF[s.name] end
      writeInteger(h.addr, s.magic + d)
      say(string.format('REPAIRED: %s held %s (not a valid value; the mod used its default). Now %d.', s.name, tostring(v), d))
    end
  end
  say(string.format('\nUSING: FMCE_On @%s, FMCE_Type @%s, FMCE_Count @%s, FMCE_Faction @%s',
    hex(pick.FMCE_On.addr), hex(pick.FMCE_Type.addr), hex(pick.FMCE_Count.addr), hex(pick.FMCE_Faction.addr)))
  local fv = decode(SPEC[4], readInteger(pick.FMCE_Faction.addr) or -1)
  say('Faction now: ' .. (({[0] = 'Blue', [1] = 'HOSTILE', [2] = 'RED', [3] = 'GREEN'})[fv] or 'unknown value'))
  say('Now set the entries below. The next Explore or Attack flag shows a chat message telling whether summon is ON or OFF.')
  local headk = pick.FMCE_On.head
  for _, s in ipairs({{name = 'FMCE_Ping', magic = 0x740000, lo = 0, hi = 99}, {name = 'FMCE_Rules', magic = 0x750000, lo = 1, hi = 2},
                      {name = 'FMCE_Abil', magic = 0x760000, lo = 1, hi = 63}, {name = 'FMCE_Give', magic = 0, lo = -1, hi = 2147483647}}) do
    local st = {text = 0, refs = 0, named = 0}
    for _, h in ipairs(findname(s, st)) do
      if pick[s.name] == nil and h.head == headk then pick[s.name] = h end
    end
    unregisterSymbol(s.name)
    if pick[s.name] ~= nil then registerSymbol(s.name, pick[s.name].addr, true) end
    say(s.name .. ((pick[s.name] ~= nil) and ' found (helper value)' or ' not found (optional helper, the mod creates it at game start or at a flag)'))
  end
  FMCE_PICK = pick
  return true, table.concat(out, '\n')
end
-- Give Ability to Selected Unit. The game's selection (MajestyHD.exe, static addresses, no ASLR):
--  [0x7C0ABC] = selection manager (singleton, 0x425D00); manager+0x48 = selected unit (set at 0x42A6CE,
--  cleared to 0 at 0x42A9C1). unit+4 = the unit's engine attribute map (std::map: head +0x18; node: left +0,
--  parent +4, right +8, key +0x0C, value +0x10, isnil byte +0x15). Key 0x4541 ('AE') = the unit's GPL agent
--  number; $GetParent builds its agentRef from the same key (0x42E6FF). Only reads the game; the one write is
--  the mod's own FMCE_Give integer. Only moving units (class VehicleRec, vtable 0x73B08C: heroes, henchmen,
--  monsters) keep a spell list (unit+0x168, set up in VehicleRec only); $LearnSpell writes there without a
--  type check, so buildings, lairs, flags and terrain (smaller classes) are refused here (-2) and in the mod.
function DZ_u32(a)
  if a == nil or a == 0 then return nil end
  local v = readInteger(a)
  if v == nil then return nil end
  if v &lt; 0 then v = v + 4294967296 end
  return v
end
function DZ_selected_unit()
  local mgr = DZ_u32(0x7C0ABC)
  if mgr == nil or mgr == 0 then return nil end
  local unit = DZ_u32(mgr + 0x48)
  if unit == nil or unit == 0 then return nil end
  return unit
end
function DZ_unit_agent(unit)
  local head = DZ_u32(unit + 0x1C)
  if head == nil or readBytes(head + 0x15, 1) ~= 1 then return nil end
  local n = DZ_u32(head + 4)
  for i = 1, 64 do
    if n == nil or n == 0 or n == head or readBytes(n + 0x15, 1) ~= 0 then return nil end
    local k = DZ_u32(n + 0x0C)
    if k == nil then return nil end
    if k == 0x4541 then return DZ_u32(n + 0x10) end
    if k &lt; 0x4541 then n = DZ_u32(n + 8) else n = DZ_u32(n) end
  end
  return nil
end
function DZ_helper_ok(h, name)
  if h == nil or h.node == nil or h.addr == nil then return false end
  if DZ_u32(h.node + 0x18) ~= h.addr - 8 then return false end
  if DZ_u32(h.addr - 8) ~= 0x007463F4 or DZ_u32(h.addr - 4) ~= 1 then return false end
  local p = DZ_u32(h.node + 0x0C)
  local len = DZ_u32(h.node + 0x14)
  local fl = readBytes(h.node + 0x13, 1)
  if p == nil or len == nil or fl == nil or len ~= #name then return false end
  local s = readString(p, len, (fl % 2) == 1)
  return s ~= nil and s:lower() == name:lower()
end
-- writes the selected unit's agent number for the mod to pick up (-1: nothing selected, -2: not a unit)
function DZ_give_write(addr)
  local unit = DZ_selected_unit()
  if unit == nil then
    writeInteger(addr, -1)
    return false
  end
  if DZ_u32(unit) ~= 0x0073B08C then
    writeInteger(addr, -2)
    return false
  end
  local id = DZ_unit_agent(unit)
  if id == nil or id == 0 or id &gt; 2147483647 then
    writeInteger(addr, -1)
    return false
  end
  writeInteger(addr, id)
  return true
end
-- Attach to the game by itself (no process, or another process opened)
local function deity_attached()
  if getOpenedProcessID == nil or getOpenedProcessID() == 0 then return false end
  if process ~= nil and tostring(process):lower() ~= 'majestyhd.exe' then return false end
  return true
end
local function deity_attach()
  if deity_attached() then return true end
  local pid = nil
  if getProcessIDFromProcessName ~= nil then pid = getProcessIDFromProcessName('MajestyHD.exe') end
  if pid == nil or pid == 0 then return false end
  pcall(openProcess, pid)
  for i = 1, 30 do
    if deity_attached() and getOpenedProcessID() == pid then return true end
    sleep(100)
  end
  return deity_attached()
end
if not deity_attach() then
  showMessage('Deity Zenith: start Majesty first.')
  error('Deity Zenith: Majesty is not running')
end
local okcall, found, report = pcall(FMCE_find)
if not okcall then
  showMessage('Deity Zenith: SCRIPT ERROR (nothing was changed)\n\n' .. tostring(found))
  error('Deity Zenith: script error')
end
if not found then
  showMessage('Deity Zenith: values NOT found\n\n' .. tostring(report))
  error('Deity Zenith: values not found')
end
showMessage('Deity Zenith: values found\n\n' .. tostring(report))
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
unregisterSymbol('FMCE_Type')
unregisterSymbol('FMCE_On')
unregisterSymbol('FMCE_Count')
unregisterSymbol('FMCE_Faction')
unregisterSymbol('FMCE_Abil')
unregisterSymbol('FMCE_Give')
{$asm}
